@inherits LayoutComponentBase

@using Salesync.SalesRep.Pwa.Auth

@inject SalesyncAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-shell">

    <aside class="desktop-sidebar">

        <div class="brand-block">
            <div class="brand-logo">
                S
            </div>

            <div>
                <div class="brand-name">
                    Salesync
                </div>

                <div class="brand-subtitle">
                    Sales Representative
                </div>
            </div>
        </div>

        <NavMenu />

    </aside>

    <section class="app-main">

        <header class="app-header">

            <div>
                <div class="header-title">
                    Salesync
                </div>

                <AuthorizeView>
                    <Authorized Context="authContext">
                        <div class="header-user">
                            @authContext.User.Identity?.Name
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <button type="button"
                    class="header-logout-button"
                    title="تسجيل الخروج"
                    @onclick="LogoutAsync">

                تسجيل الخروج

            </button>

        </header>

        <main class="app-content">
            @Body
        </main>

    </section>

    <nav class="mobile-bottom-nav"
         aria-label="القائمة الرئيسية">

        <NavLink class="mobile-nav-link"
                 href="/dashboard"
                 Match="NavLinkMatch.All">

            <span class="mobile-nav-icon"
                  aria-hidden="true">
                ⌂
            </span>

            <span>
                الرئيسية
            </span>

        </NavLink>

        <NavLink class="mobile-nav-link"
                 href="/profile">

            <span class="mobile-nav-icon"
                  aria-hidden="true">
                ●
            </span>

            <span>
                حسابي
            </span>

        </NavLink>

        <button type="button"
                class="mobile-nav-button"
                @onclick="LogoutAsync">

            <span class="mobile-nav-icon"
                  aria-hidden="true">
                ↪
            </span>

            <span>
                خروج
            </span>

        </button>

    </nav>

</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthStateProvider.SignOutAsync();

        Navigation.NavigateTo(
            "/login",
            forceLoad: true);
    }
}