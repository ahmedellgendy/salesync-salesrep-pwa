@inherits LayoutComponentBase

@using Salesync.SalesRep.Pwa.Auth
@using Salesync.SalesRep.Pwa.Components

@inject SalesyncAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="app-shell">

    <aside class="desktop-sidebar">

        <div class="brand-block">
            <div class="brand-logo">
                S
            </div>

            <div>
                <div class="brand-name">
                    Salesync
                </div>

                <div class="brand-subtitle">
                    Sales Representative
                </div>
            </div>
        </div>

        <NavMenu />

    </aside>

    <section class="app-main">

        <header class="app-header">

            <div>
                <div class="header-title">
                    Salesync
                </div>

                <AuthorizeView>
                    <Authorized Context="authContext">
                        <div class="header-user">
                            @authContext.User.Identity?.Name
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <button type="button"
                    class="header-logout-button"
                    title="تسجيل الخروج"
                    @onclick="LogoutAsync">

                تسجيل الخروج

            </button>

        </header>

        <main class="app-content">
            @Body
        </main>

    </section>

    <MobileBottomNav />

</div>

@code {
    private async Task LogoutAsync()
    {
        await AuthStateProvider.SignOutAsync();

        Navigation.NavigateTo(
            "/login",
            forceLoad: true);
    }
}