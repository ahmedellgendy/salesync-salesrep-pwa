<button type="button"
        class="enterprise-action-tile @ColorClass @(Large ? "enterprise-action-large" : "")"
        disabled="@Disabled"
        @onclick="OnClick">

    <div class="enterprise-action-icon">
        @Icon
    </div>

    <div class="enterprise-action-content">
        <div class="enterprise-action-title">
            @Title
        </div>

        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="enterprise-action-subtitle">
                @Subtitle
            </div>
        }
    </div>

</button>

@code {
    [Parameter]
    public string Icon { get; set; } = "APP";

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string ColorClass { get; set; } = "enterprise-blue";

    [Parameter]
    public bool Large { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }
}