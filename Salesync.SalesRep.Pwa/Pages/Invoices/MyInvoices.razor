@page "/invoices"
@page "/invoices/{SessionId:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepInvoiceApiService SalesRepInvoiceApiService
@inject ISalesRepSessionApiService SalesRepSessionApiService
@inject NavigationManager NavigationManager

<div class="my-invoices-page" dir="rtl">

    <section class="my-invoices-hero">
        <div>
            <span>فواتير المندوب</span>
            <h1>فواتير اليوم</h1>
            <p>راجع فواتير السيشن الحالية وسجل التحصيل من العملاء.</p>
        </div>

        <div class="my-invoices-hero-icon">
            🧾
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="my-invoices-loading-card">
            جاري تحميل الفواتير...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="my-invoices-alert error">
            @_errorMessage
        </div>
    }
    else
    {
        <section class="my-invoices-actions">
            <button type="button"
                    @onclick="GoToDashboard">
                الرئيسية
            </button>

            <button type="button"
                    @onclick="GoToRoutes">
                الخطوط
            </button>
        </section>

        @if (_invoices.Count == 0)
        {
            <div class="my-invoices-empty-card">
                <div>📄</div>
                <h3>لا توجد فواتير</h3>
                <p>لم يتم إنشاء أي فواتير في السيشن الحالية.</p>
            </div>
        }
        else
        {
            <section class="my-invoices-summary-card">

                <div class="invoice-summary-main-row">
                    <div>
                        <span>ملخص الفواتير</span>
                        <strong>@_invoices.Count فاتورة</strong>
                    </div>

                    <small>@GetUnpaidInvoicesCount() غير محصلة</small>
                </div>

                <div class="my-invoices-summary-list">
                    <div>
                        <span>إجمالي المبيعات</span>
                        <strong>@FormatMoney(GetTotalAmount())</strong>
                    </div>

                    <div>
                        <span>المحصل</span>
                        <strong>@FormatMoney(GetPaidAmount())</strong>
                    </div>

                    <div>
                        <span>المتبقي</span>
                        <strong>@FormatMoney(GetRemainingAmount())</strong>
                    </div>
                </div>

            </section>

            <section class="my-invoices-list">
                @foreach (var invoice in _invoices)
                {
                    <article class="my-invoice-card compact @GetPaymentCardClass(invoice)"
                             @onclick="() => GoToInvoiceDetails(invoice.Id)">

                        <div class="invoice-card-header">
                            <div class="invoice-title-block">
                                <span class="invoice-number-label">رقم الفاتورة</span>
                                <strong>@invoice.InvoiceNumber</strong>
                            </div>

                            <span class="payment-status-pill @GetPaymentStatusClass(invoice)">
                                @GetPaymentStatusText(invoice)
                            </span>
                        </div>

                        <div class="invoice-customer-block compact">
                            <span>العميل</span>
                            <strong>@invoice.CustomerName</strong>
                        </div>

                        <div class="invoice-money-list compact">
                            <div>
                                <span>الإجمالي</span>
                                <strong>@FormatMoney(invoice.TotalAmount)</strong>
                            </div>

                            <div>
                                <span>المتبقي</span>
                                <strong>@FormatMoney(invoice.RemainingAmount)</strong>
                            </div>
                        </div>

                        @if (invoice.RemainingAmount > 0)
                        {
                            <button type="button"
                                    class="invoice-collect-btn"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => GoToCollectPayment(invoice)">
                                تسجيل تحصيل الآن
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="invoice-paid-btn"
                                    disabled>
                                تم السداد
                            </button>
                        }

                    </article>

                    @if (!string.IsNullOrWhiteSpace(invoice.Notes))
                    {
                        <div class="invoice-notes-box">
                            <span>ملاحظات</span>
                            <strong>@invoice.Notes</strong>
                        </div>
                    }

                }
            </section>
        }
    }

</div>

@code {
    [Parameter]
    public int? SessionId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;

    private List<SalesRepMobileInvoiceDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        await EnsureSessionIdAsync();

        if (!SessionId.HasValue || SessionId.Value <= 0)
        {
            _isLoading = false;
            return;
        }

        await LoadInvoicesAsync();

        _isLoading = false;
    }

    private async Task EnsureSessionIdAsync()
    {
        if (SessionId.HasValue && SessionId.Value > 0)
            return;

        var todayResponse = await SalesRepSessionApiService.GetTodayAsync();

        if (todayResponse is null)
        {
            _errorMessage = "لم يتم استلام بيانات اليوم من الخادم.";
            return;
        }

        if (!todayResponse.Success)
        {
            _errorMessage = todayResponse.Message ?? "فشل تحميل بيانات اليوم.";
            return;
        }

        if (todayResponse.Data?.HasTodaySession != true || todayResponse.Data.Session is null)
        {
            _errorMessage = "لا يوجد سيشن لليوم الحالي.";
            return;
        }

        SessionId = todayResponse.Data.Session.Id;
    }

    private async Task LoadInvoicesAsync()
    {
        if (!SessionId.HasValue || SessionId.Value <= 0)
        {
            _errorMessage = "بيانات السيشن غير صحيحة.";
            return;
        }

        var response =
            await SalesRepInvoiceApiService.GetMyInvoicesAsync(SessionId.Value);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل الفواتير.";
            return;
        }

        _invoices = response.Data?
            .OrderByDescending(x => x.CreatedAt)
            .ToList()
            ?? new List<SalesRepMobileInvoiceDto>();
    }

    private decimal GetTotalAmount()
    {
        return _invoices.Sum(x => x.TotalAmount);
    }

    private decimal GetPaidAmount()
    {
        return _invoices.Sum(x => x.PaidAmount);
    }

    private decimal GetRemainingAmount()
    {
        return _invoices.Sum(x => x.RemainingAmount);
    }

    private int GetUnpaidInvoicesCount()
    {
        return _invoices.Count(x => x.RemainingAmount > 0);
    }

    private static string GetInvoiceStatusText(int status)
    {
        return status switch
        {
            1 => "مسودة",
            2 => "مؤكدة",
            3 => "ملغاة",
            _ => "غير معروف"
        };
    }

    private static string GetPaymentStatusText(SalesRepMobileInvoiceDto invoice)
    {
        if (invoice.RemainingAmount <= 0)
            return "مدفوعة";

        if (invoice.PaidAmount > 0)
            return "مدفوعة جزئيًا";

        return "غير مدفوعة";
    }

    private static string GetPaymentStatusClass(SalesRepMobileInvoiceDto invoice)
    {
        if (invoice.RemainingAmount <= 0)
            return "paid";

        if (invoice.PaidAmount > 0)
            return "partial";

        return "pending";
    }

    private static string GetPaymentCardClass(SalesRepMobileInvoiceDto invoice)
    {
        return invoice.RemainingAmount <= 0
            ? "paid"
            : "pending";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2");
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt");
    }

    private void GoToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard");
    }

    private void GoToRoutes()
    {
        if (SessionId.HasValue && SessionId.Value > 0)
        {
            NavigationManager.NavigateTo($"/routes/{SessionId.Value}");
            return;
        }

        NavigationManager.NavigateTo("/routes");
    }

    private void GoToCollectPayment(SalesRepMobileInvoiceDto invoice)
    {
        if (!SessionId.HasValue || SessionId.Value <= 0)
        {
            _errorMessage = "بيانات السيشن غير صحيحة.";
            return;
        }

        var invoiceNumber = Uri.EscapeDataString(invoice.InvoiceNumber);

        NavigationManager.NavigateTo(
            $"/payments/create?invoiceId={invoice.Id}&sessionId={SessionId.Value}&remainingAmount={invoice.RemainingAmount}&invoiceNumber={invoiceNumber}");
    }

    private void GoToInvoiceDetails(int invoiceId)
    {
        if (!SessionId.HasValue || SessionId.Value <= 0)
        {
            _errorMessage = "بيانات السيشن غير صحيحة.";
            return;
        }

        NavigationManager.NavigateTo(
            $"/invoices/details/{invoiceId}?sessionId={SessionId.Value}");
    }
}