@page "/invoices/details/{InvoiceId:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepInvoiceApiService SalesRepInvoiceApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="invoice-details-page" dir="rtl">

    @if (_isLoading)
    {
        <div class="invoice-details-loading">
            جاري تحميل تفاصيل الفاتورة...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="invoice-details-alert error">
            @_errorMessage
        </div>

        <button type="button"
                class="invoice-details-back-btn"
                @onclick="GoBack">
            رجوع للفواتير
        </button>
    }
    else if (_invoice is not null)
    {
        <section class="invoice-details-hero">

            <div>
                <span>تفاصيل الفاتورة</span>
                <h1>@_invoice.InvoiceNumber</h1>
                <p>@FormatDate(_invoice.CreatedAt)</p>
            </div>

            <div class="invoice-details-icon">
                🧾
            </div>

        </section>

        <section class="invoice-details-status-card @GetPaymentCardClass(_invoice)">

            <div class="invoice-details-status-row">
                <span>حالة السداد</span>

                <strong class="@GetPaymentStatusClass(_invoice)">
                    @GetPaymentStatusText(_invoice)
                </strong>
            </div>

            <div class="invoice-details-customer">
                <span>العميل</span>
                <strong>@GetCustomerNameText(_invoice)</strong>
            </div>

        </section>

        <section class="invoice-details-money-card">

            <div>
                <span>الإجمالي قبل الخصم</span>
                <strong>@FormatMoney(_invoice.SubTotal)</strong>
            </div>

            <div>
                <span>الخصم</span>
                <strong>@FormatMoney(_invoice.DiscountAmount)</strong>
            </div>

            <div>
                <span>الضريبة</span>
                <strong>@FormatMoney(_invoice.TaxAmount)</strong>
            </div>

            <div class="total">
                <span>إجمالي الفاتورة</span>
                <strong>@FormatMoney(_invoice.TotalAmount)</strong>
            </div>

            <div>
                <span>المدفوع</span>
                <strong>@FormatMoney(_invoice.PaidAmount)</strong>
            </div>

            <div>
                <span>المتبقي</span>
                <strong>@FormatMoney(_invoice.RemainingAmount)</strong>
            </div>

        </section>

        <section class="invoice-items-section">

            <div class="invoice-items-title">
                <span>بنود الفاتورة</span>
                <strong>@GetInvoiceItems().Count صنف</strong>
            </div>

            @if (GetInvoiceItems().Count == 0)
            {
                <div class="invoice-details-empty">
                    لا توجد أصناف في هذه الفاتورة.
                </div>
            }
            else
            {
                @foreach (var item in GetInvoiceItems())
                {
                    <article class="invoice-item-card">

                        <div class="invoice-item-header">
                            <div>
                                <strong>@item.ProductName</strong>

                                @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                {
                                    <span>كود: @item.ItemCode</span>
                                }
                            </div>

                            <div class="invoice-item-total">
                                @FormatMoney(item.NetAmount)
                            </div>
                        </div>

                        <div class="invoice-item-values">

                            <div>
                                <span>الكمية</span>
                                <strong>@item.Quantity</strong>
                            </div>

                            <div>
                                <span>البونص</span>
                                <strong>@item.BonusQuantity</strong>
                            </div>

                            <div>
                                <span>سعر الوحدة</span>
                                <strong>@FormatMoney(item.UnitPrice)</strong>
                            </div>

                            <div>
                                <span>الخصم</span>
                                <strong>@FormatMoney(item.DiscountAmount)</strong>
                            </div>

                        </div>

                    </article>
                }
            }

        </section>

        @if (!string.IsNullOrWhiteSpace(_invoice.Notes))
        {
            <section class="invoice-details-notes">
                <span>ملاحظات</span>
                <p>@_invoice.Notes</p>
            </section>
        }

        <section class="invoice-details-actions">

            <button type="button"
                    class="invoice-details-print-btn"
                    @onclick="PrintInvoiceAsync">
                طباعة الفاتورة
            </button>

            <button type="button"
                    class="invoice-details-share-btn"
                    @onclick="ShareInvoiceOnWhatsAppAsync">
                مشاركة واتساب
            </button>

            <button type="button"
                    class="invoice-details-back-btn"
                    @onclick="GoBack">
                رجوع للفواتير
            </button>

        </section>

        <section class="invoice-print-receipt" dir="rtl">

            <div class="receipt-header">
                <h2>Salesync</h2>
                <p>Friday Ice Cream</p>
            </div>

            <div class="receipt-line"></div>

            <div class="receipt-info">
                <div>
                    <span>رقم الفاتورة</span>
                    <strong>@_invoice.InvoiceNumber</strong>
                </div>

                <div>
                    <span>التاريخ</span>
                    <strong>@FormatDate(_invoice.CreatedAt)</strong>
                </div>

                <div>
                    <span>العميل</span>
                    <strong>@GetCustomerNameText(_invoice)</strong>
                </div>

                <div>
                    <span>حالة السداد</span>
                    <strong>@GetPaymentStatusText(_invoice)</strong>
                </div>
            </div>

            <div class="receipt-line"></div>

            <table class="receipt-items">
                <thead>
                    <tr>
                        <th>الصنف</th>
                        <th>كمية</th>
                        <th>سعر</th>
                        <th>إجمالي</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in GetInvoiceItems())
                    {
                        <tr>
                            <td>
                                @item.ProductName
                                <small>@item.ItemCode</small>
                            </td>
                            <td>@item.Quantity</td>
                            <td>@FormatMoney(item.UnitPrice)</td>
                            <td>@FormatMoney(item.NetAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="receipt-line"></div>

            <div class="receipt-totals">
                <div>
                    <span>الإجمالي</span>
                    <strong>@FormatMoney(_invoice.TotalAmount)</strong>
                </div>

                <div>
                    <span>المدفوع</span>
                    <strong>@FormatMoney(_invoice.PaidAmount)</strong>
                </div>

                <div>
                    <span>المتبقي</span>
                    <strong>@FormatMoney(_invoice.RemainingAmount)</strong>
                </div>
            </div>

            <div class="receipt-footer">
                <p>شكراً لتعاملكم معنا</p>
            </div>

        </section>
    }

</div>

@code {
    [Parameter]
    public int InvoiceId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private InvoiceDto? _invoice;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoiceDetailsAsync();
    }

    private async Task LoadInvoiceDetailsAsync()
    {
        if (InvoiceId <= 0)
        {
            _errorMessage = "رقم الفاتورة غير صحيح.";
            _isLoading = false;
            return;
        }

        try
        {
            var response = await SalesRepInvoiceApiService.GetInvoiceDetailsAsync(InvoiceId);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success || response.Data is null)
            {
                _errorMessage = response.Message ?? "فشل تحميل تفاصيل الفاتورة.";
                return;
            }

            _invoice = response.Data;

            if (_invoice.InvoiceItems is null)
            {
                _invoice.InvoiceItems = new List<InvoiceItemDto>();
            }
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء تحميل تفاصيل الفاتورة.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        if (SessionId > 0)
        {
            NavigationManager.NavigateTo($"/invoices/{SessionId}");
            return;
        }

        NavigationManager.NavigateTo("/invoices");
    }

    private async Task PrintInvoiceAsync()
    {
        if (_invoice is null)
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch
        {
            _errorMessage = "حدث خطأ أثناء طباعة الفاتورة.";
        }
    }

    private async Task ShareInvoiceOnWhatsAppAsync()
    {
        if (_invoice is null)
            return;

        try
        {
            var message = BuildInvoiceWhatsAppMessage(_invoice);

            var fileName = $"{_invoice.InvoiceNumber}.png"
                .Replace("/", "-")
                .Replace("\\", "-")
                .Replace(":", "-");

            await JSRuntime.InvokeVoidAsync(
                "salesyncInvoiceShare.shareReceipt",
                ".invoice-print-receipt",
                fileName,
                message);
        }
        catch
        {
            _errorMessage = "حدث خطأ أثناء مشاركة الفاتورة.";
        }
    }

    private List<InvoiceItemDto> GetInvoiceItems()
    {
        return _invoice?.InvoiceItems ?? new List<InvoiceItemDto>();
    }

    private static string BuildInvoiceWhatsAppMessage(InvoiceDto invoice)
    {
        var invoiceItems = invoice.InvoiceItems ?? new List<InvoiceItemDto>();

        var itemsText = invoiceItems.Count == 0
            ? "لا توجد أصناف"
            : string.Join(
                Environment.NewLine,
                invoiceItems.Select(item =>
                    $"- {item.ProductName} | الكمية: {item.Quantity} | السعر: {item.UnitPrice:N2} | الإجمالي: {item.NetAmount:N2}"));

        return
$"""
فاتورة Salesync

رقم الفاتورة: {invoice.InvoiceNumber}
التاريخ: {invoice.CreatedAt.ToLocalTime():dd/MM/yyyy - hh:mm tt}
العميل: {GetCustomerNameText(invoice)}
حالة السداد: {GetPaymentStatusText(invoice)}

الأصناف:
{itemsText}

الإجمالي: {invoice.TotalAmount:N2}
المدفوع: {invoice.PaidAmount:N2}
المتبقي: {invoice.RemainingAmount:N2}

شكراً لتعاملكم معنا
""";
    }

    private static string GetCustomerNameText(InvoiceDto invoice)
    {
        if (!string.IsNullOrWhiteSpace(invoice.CustomerName))
            return invoice.CustomerName;

        return $"عميل رقم {invoice.CustomerId}";
    }

    private static string GetPaymentStatusText(InvoiceDto invoice)
    {
        if (invoice.RemainingAmount <= 0)
            return "مدفوعة";

        if (invoice.PaidAmount > 0)
            return "مدفوعة جزئيًا";

        return "غير مدفوعة";
    }

    private static string GetPaymentStatusClass(InvoiceDto invoice)
    {
        if (invoice.RemainingAmount <= 0)
            return "paid";

        if (invoice.PaidAmount > 0)
            return "partial";

        return "pending";
    }

    private static string GetPaymentCardClass(InvoiceDto invoice)
    {
        if (invoice.RemainingAmount <= 0)
            return "paid";

        if (invoice.PaidAmount > 0)
            return "partial";

        return "pending";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2");
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt");
    }
}