@page "/invoices/create"
@attribute [Authorize]

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepInvoiceApiService SalesRepInvoiceApiService
@inject ISalesRepLoadRequestApiService SalesRepLoadRequestApiService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<div class="create-invoice-page order-screen" dir="rtl">

    <section class="create-invoice-card">

        <div class="create-invoice-header">
            <div class="create-invoice-title">
                <span class="invoice-status-badge">
                    زيارة إيجابية
                </span>

                <h1>إنشاء فاتورة</h1>

                <p>
                    اختر الكميات المطلوبة من منتجات مخزون المندوب.
                </p>
            </div>

            <div class="create-invoice-icon">
                🧾
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="invoice-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="invoice-alert success">
                @_successMessage
            </div>
        }

        @if (_isLoadingInventory)
        {
            <div class="invoice-loading-card">
                جاري تحميل مخزون المندوب...
            </div>
        }
        else if (_productLines.Count == 0)
        {
            <div class="invoice-empty-card">
                <div>📦</div>
                <strong>لا يوجد مخزون متاح</strong>
                <p>لا يمكن إنشاء فاتورة بدون منتجات متاحة في مخزون المندوب.</p>
            </div>

            <button type="button"
                    class="invoice-back-btn"
                    @onclick="GoBackToRouteCustomers">
                رجوع لعملاء الخط
            </button>
        }
        else
        {
            <section class="invoice-products-toolbar">

                <div>
                    <span>منتجات المخزون</span>
                    <strong>@_productLines.Count منتج متاح</strong>
                </div>

                <input class="invoice-search-input"
                       placeholder="ابحث عن منتج..."
                       @bind="_searchText"
                       @bind:event="oninput" />

            </section>

            <section class="invoice-summary-card compact-summary">
                <div>
                    <span>الأصناف المختارة</span>
                    <strong>@GetSelectedItemsCount()</strong>
                </div>

                <div>
                    <span>إجمالي الكميات</span>
                    <strong>@GetTotalQuantity()</strong>
                </div>

                <div>
                    <span>إجمالي البونص</span>
                    <strong>@GetTotalBonusQuantity()</strong>
                </div>

                <div>
                    <span>إجمالي الخصومات</span>
                    <strong>@FormatMoney(GetTotalDiscount())</strong>
                </div>
            </section>

            @if (FilteredProductLines.Count == 0)
            {
                <div class="invoice-empty-card small">
                    <div>🔍</div>
                    <strong>لا توجد نتائج</strong>
                    <p>لا يوجد منتج مطابق للبحث الحالي.</p>
                </div>
            }
            else
            {
                <section class="invoice-products-list">

                    @foreach (var line in FilteredProductLines)
                    {
                        <article class="invoice-product-card @(line.Quantity > 0 ? "selected" : "")" @key="line.ProductId">

                            <div class="invoice-product-main-row">

                                <div class="invoice-product-info-block">
                                    <strong>@line.ProductName</strong>

                                    @if (!string.IsNullOrWhiteSpace(line.ItemCode))
                                    {
                                        <span>كود: @line.ItemCode</span>
                                    }
                                </div>

                                <div class="invoice-stock-pill">
                                    المتاح @FormatQuantity(line.AvailableQuantity)
                                </div>

                            </div>

                            <div class="invoice-product-inputs">

                                <div class="invoice-mini-field">
                                    <label>الكمية</label>

                                    <input type="number"
                                           min="0"
                                           max="@line.AvailableQuantity"
                                           disabled="@_isProcessing"
                                           @bind="line.Quantity"
                                           @bind:after="() => OnLineQuantityChanged(line)" />
                                </div>

                                <div class="invoice-mini-field">
                                    <label>البونص</label>

                                    <input type="number"
                                           min="0"
                                           max="@line.AvailableQuantity"
                                           disabled="@_isProcessing"
                                           @bind="line.BonusQuantity"
                                           @bind:after="() => OnLineQuantityChanged(line)" />
                                </div>

                                <div class="invoice-mini-field">
                                    <label>الخصم</label>

                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           disabled="@_isProcessing"
                                           @bind="line.DiscountAmount" />
                                </div>

                            </div>

                            @if (line.Quantity > 0 || line.BonusQuantity > 0)
                            {
                                <div class="invoice-product-selected-note">
                                    المطلوب: @GetLineRequestedQuantity(line) من أصل @FormatQuantity(line.AvailableQuantity)
                                </div>
                            }

                            @if (IsRequestedQuantityGreaterThanAvailable(line))
                            {
                                <div class="invoice-alert error compact">
                                    الكمية المطلوبة أكبر من المتاح في المخزون.
                                </div>
                            }

                        </article>
                    }

                </section>
            }

            <div class="invoice-form-group">
                <label>خصم عام على الفاتورة</label>

                <input type="number"
                       step="0.01"
                       min="0"
                       disabled="@_isProcessing"
                       @bind="_invoiceDiscountAmount" />
            </div>

            <div class="invoice-form-group">
                <label>ملاحظات الفاتورة</label>

                <textarea placeholder="اكتب ملاحظات الفاتورة..."
                          disabled="@_isProcessing"
                          @bind="_notes"></textarea>
            </div>

            <button type="button"
                    class="invoice-main-btn"
                    disabled="@_isProcessing"
                    @onclick="CreateConfirmAndCompleteAsync">
                @(_isProcessing ? "جاري حفظ الفاتورة..." : "حفظ الفاتورة وإغلاق الزيارة")
            </button>

            <button type="button"
                    class="invoice-back-btn"
                    disabled="@_isProcessing"
                    @onclick="GoBackToRouteCustomers">
                رجوع لعملاء الخط
            </button>
        }

    </section>

</div>

@code {
    [SupplyParameterFromQuery(Name = "visitId")]
    public int VisitId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "routeId")]
    public int RouteId { get; set; }

    private int _salesRepId;

    private decimal _invoiceDiscountAmount;

    private string? _notes;
    private string? _searchText;
    private string? _errorMessage;
    private string? _successMessage;

    private bool _isProcessing;
    private bool _isLoadingInventory = true;

    private List<InvoiceProductLineModel> _productLines = new();

    private List<InvoiceProductLineModel> FilteredProductLines =>
        _productLines
            .Where(MatchesSearchText)
            .OrderByDescending(x => x.Quantity > 0)
            .ThenBy(x => x.ProductName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        ValidateInitialData();

        if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            _isLoadingInventory = false;
            return;
        }

        await LoadInventoryAsync();
    }

    private async Task LoadInventoryAsync()
    {
        _isLoadingInventory = true;

        try
        {
            _salesRepId = await GetCurrentSalesRepIdAsync();

            if (_salesRepId <= 0)
            {
                _errorMessage = "لم يتم تحديد المندوب الحالي.";
                return;
            }

            var inventoryResponse =
                await SalesRepLoadRequestApiService.GetInventoryAsync(_salesRepId);

            if (inventoryResponse is null)
            {
                _errorMessage = "لم يتم استلام بيانات المخزون من الخادم.";
                return;
            }

            if (!inventoryResponse.Success)
            {
                _errorMessage = inventoryResponse.Message ?? "فشل تحميل مخزون المندوب.";
                return;
            }

            var inventoryItems = inventoryResponse.Data?
                .Where(x => x.Quantity > 0)
                .OrderBy(x => x.ProductName)
                .ToList()
                ?? new List<SalesRepInventoryDto>();

            _productLines = inventoryItems
                .Select(x => new InvoiceProductLineModel
                {
                    ProductId = x.ProductId,
                    ProductName = x.ProductName,
                    ItemCode = x.ItemCode,
                    AvailableQuantity = x.Quantity,
                    Quantity = 0,
                    BonusQuantity = 0,
                    DiscountAmount = 0
                })
                .ToList();
        }
        finally
        {
            _isLoadingInventory = false;
        }
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private async Task CreateConfirmAndCompleteAsync()
    {
        if (!Validate())
            return;

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var selectedItems = _productLines
                .Where(x => x.Quantity > 0)
                .Select(x => new CreateSalesRepMobileInvoiceItemRequest
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity,
                    BonusQuantity = x.BonusQuantity,
                    DiscountAmount = x.DiscountAmount,
                    DiscountPercentage = 0
                })
                .ToList();

            var request = new CreateSalesRepMobileInvoiceRequest
            {
                VisitId = VisitId,
                CustomerId = CustomerId,
                SalesRepSessionId = SessionId,
                DiscountAmount = _invoiceDiscountAmount,
                Notes = _notes,
                Items = selectedItems
            };

            var response =
                await SalesRepInvoiceApiService.CreateMobileInvoiceAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success || response.Data is null)
            {
                _errorMessage = response.Message ?? "فشل إنشاء الفاتورة.";
                return;
            }

            _successMessage = "تم إنشاء الفاتورة وإغلاق الزيارة بنجاح.";

            await Task.Delay(700);

            NavigationManager.NavigateTo($"/invoices/{SessionId}", replace: true);
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء إنشاء الفاتورة.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ValidateInitialData()
    {
        if (VisitId <= 0 || SessionId <= 0 || CustomerId <= 0 || RouteId <= 0)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
        }
    }

    private bool Validate()
    {
        _errorMessage = null;

        if (VisitId <= 0 || SessionId <= 0 || CustomerId <= 0 || RouteId <= 0)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
            return false;
        }

        var selectedLines = _productLines
            .Where(x => x.Quantity > 0)
            .ToList();

        if (selectedLines.Count == 0)
        {
            _errorMessage = "اختار كمية لمنتج واحد على الأقل.";
            return false;
        }

        foreach (var line in _productLines)
        {
            if (line.Quantity < 0)
            {
                _errorMessage = $"كمية المنتج {line.ProductName} لا يمكن تكون أقل من صفر.";
                return false;
            }

            if (line.BonusQuantity < 0)
            {
                _errorMessage = $"بونص المنتج {line.ProductName} لا يمكن يكون أقل من صفر.";
                return false;
            }

            if (line.DiscountAmount < 0)
            {
                _errorMessage = $"خصم المنتج {line.ProductName} لا يمكن يكون أقل من صفر.";
                return false;
            }

            if (line.Quantity == 0 && line.BonusQuantity > 0)
            {
                _errorMessage = $"لا يمكن إضافة بونص للمنتج {line.ProductName} بدون كمية مباعة.";
                return false;
            }

            if (IsRequestedQuantityGreaterThanAvailable(line))
            {
                _errorMessage =
                    $"الكمية المطلوبة من المنتج {line.ProductName} أكبر من المتاح. المتاح: {FormatQuantity(line.AvailableQuantity)}";

                return false;
            }
        }

        if (_invoiceDiscountAmount < 0)
        {
            _errorMessage = "خصم الفاتورة لا يمكن يكون أقل من صفر.";
            return false;
        }

        return true;
    }

    private bool MatchesSearchText(InvoiceProductLineModel line)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search = _searchText.Trim();

        return Contains(line.ProductName, search)
            || Contains(line.ItemCode, search);
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private void OnLineQuantityChanged(InvoiceProductLineModel line)
    {
        _errorMessage = null;

        if (line.Quantity < 0)
            line.Quantity = 0;

        if (line.BonusQuantity < 0)
            line.BonusQuantity = 0;

        if (line.Quantity + line.BonusQuantity > line.AvailableQuantity)
        {
            _errorMessage =
                $"الكمية المطلوبة من المنتج {line.ProductName} أكبر من المتاح. المتاح: {FormatQuantity(line.AvailableQuantity)}";
        }
    }

    private int GetSelectedItemsCount()
    {
        return _productLines.Count(x => x.Quantity > 0);
    }

    private int GetTotalQuantity()
    {
        return _productLines.Sum(x => x.Quantity);
    }

    private int GetTotalBonusQuantity()
    {
        return _productLines.Sum(x => x.BonusQuantity);
    }

    private decimal GetTotalDiscount()
    {
        return _productLines.Sum(x => x.DiscountAmount) + _invoiceDiscountAmount;
    }

    private int GetLineRequestedQuantity(InvoiceProductLineModel line)
    {
        return line.Quantity + line.BonusQuantity;
    }

    private bool IsRequestedQuantityGreaterThanAvailable(InvoiceProductLineModel line)
    {
        return GetLineRequestedQuantity(line) > line.AvailableQuantity;
    }

    private void GoBackToRouteCustomers()
    {
        if (SessionId > 0 && RouteId > 0)
        {
            NavigationManager.NavigateTo(
                $"/routes/{RouteId}/customers?sessionId={SessionId}",
                replace: true);

            return;
        }

        NavigationManager.NavigateTo("/routes", replace: true);
    }

    private static string FormatQuantity(decimal value)
    {
        return value.ToString("N0");
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2");
    }

    private class InvoiceProductLineModel
    {
        public int ProductId { get; set; }

        public string? ProductName { get; set; }

        public string? ItemCode { get; set; }

        public int AvailableQuantity { get; set; }

        public int Quantity { get; set; }

        public int BonusQuantity { get; set; }

        public decimal DiscountAmount { get; set; }
    }
}