@page "/invoices/create"
@attribute [Authorize]

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepInvoiceApiService SalesRepInvoiceApiService
@inject ISalesRepLoadRequestApiService SalesRepLoadRequestApiService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<h3 class="mb-3">إنشاء فاتورة</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@if (_isLoadingInventory)
{
    <div class="card p-3 mb-3">
        <p class="mb-0">جاري تحميل مخزون المندوب...</p>
    </div>
}
else
{
    <div class="card p-3 mb-3">
        <h5 class="mb-3">بيانات الزيارة</h5>

        <div class="small">
            <div><strong>Visit Id:</strong> @VisitId</div>
            <div><strong>Session Id:</strong> @SessionId</div>
            <div><strong>Customer Id:</strong> @CustomerId</div>
            <div><strong>Route Id:</strong> @RouteId</div>
        </div>
    </div>

    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">منتجات الفاتورة</h5>

            <button class="btn btn-sm btn-outline-primary"
                    disabled="@(_inventoryItems.Count == 0 || _isProcessing)"
                    @onclick="AddInvoiceLine">
                إضافة منتج
            </button>
        </div>

        @if (_inventoryItems.Count == 0)
        {
            <div class="alert alert-warning">
                لا يوجد مخزون متاح للمندوب الحالي.
            </div>
        }
        else
        {
            @foreach (var line in _invoiceLines)
            {
                <div class="border rounded p-3 mb-3" @key="line.LineId">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <strong>منتج رقم @_invoiceLines.IndexOf(line) + 1</strong>

                        <button class="btn btn-sm btn-outline-danger"
                                disabled="@(_invoiceLines.Count == 1 || _isProcessing)"
                                @onclick="() => RemoveInvoiceLine(line)">
                            حذف
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">المنتج</label>

                        <select class="form-select"
                                value="@line.ProductId"
                                @onchange="(e) => OnProductChanged(line, e)">
                            <option value="0">اختار المنتج</option>

                            @foreach (var item in _inventoryItems)
                            {
                                <option value="@item.ProductId"
                                        disabled="@IsProductSelectedInAnotherLine(item.ProductId, line)">
                                    @item.ProductName - المتاح: @FormatQuantity(item.Quantity)
                                </option>
                            }
                        </select>
                    </div>

                    @if (line.SelectedInventoryItem is not null)
                    {
                        <div class="alert alert-info">
                            <div>
                                <strong>المنتج:</strong>
                                @line.SelectedInventoryItem.ProductName
                            </div>

                            <div>
                                <strong>الكمية المتاحة:</strong>
                                @FormatQuantity(line.SelectedInventoryItem.Quantity)
                            </div>

                            <div>
                                <strong>المطلوب من نفس المنتج في الفاتورة:</strong>
                                @GetRequestedQuantityForProduct(line.ProductId)
                            </div>
                        </div>
                    }
                    @if (line.SelectedInventoryItem is not null)
                    {
                        <div class="alert alert-info">
                            <div>
                                <strong>المنتج:</strong>
                                @line.SelectedInventoryItem.ProductName
                            </div>

                            <div>
                                <strong>الكمية المتاحة:</strong>
                                @FormatQuantity(line.SelectedInventoryItem.Quantity)
                            </div>

                            <div>
                                <strong>المطلوب:</strong>
                                @GetRequestedQuantityForProduct(line.ProductId)
                            </div>
                        </div>

                        @if (IsRequestedQuantityGreaterThanAvailable(line))
                        {
                            <div class="alert alert-danger">
                                الكمية المطلوبة أكبر من المتاح في المخزون.
                            </div>
                        }
                    }

                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number"
                               class="form-control"
                               min="1"
                               @bind="line.Quantity" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bonus Quantity</label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               @bind="line.BonusQuantity" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Item Discount Amount</label>
                        <input type="number"
                               class="form-control"
                               step="0.01"
                               min="0"
                               @bind="line.ItemDiscountAmount" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Invoice Discount Amount</label>
                <input type="number"
                       class="form-control"
                       step="0.01"
                       min="0"
                       @bind="_invoiceDiscountAmount" />
            </div>

            <div class="mb-3">
                <label class="form-label">Notes</label>
                <textarea class="form-control"
                          rows="3"
                          placeholder="ملاحظات الفاتورة..."
                          @bind="_notes">
                </textarea>
            </div>

            <button class="btn btn-success w-100"
                    disabled="@_isProcessing"
                    @onclick="CreateConfirmAndCompleteAsync">
                @(_isProcessing ? "جاري إنشاء الفاتورة..." : "Create Invoice & Complete Visit")
            </button>
        }
    </div>

    <div class="d-grid">
        <button class="btn btn-outline-secondary"
                disabled="@_isProcessing"
                @onclick="GoBackToRouteCustomers">
            رجوع لعملاء خط السير
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "visitId")]
    public int VisitId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "routeId")]
    public int RouteId { get; set; }

    private int _salesRepId;

    private decimal _invoiceDiscountAmount;

    private string? _notes;
    private string? _errorMessage;
    private string? _successMessage;

    private bool _isProcessing;
    private bool _isLoadingInventory = true;

    private List<SalesRepInventoryDto> _inventoryItems = new();

    private List<InvoiceLineModel> _invoiceLines = new()
    {
        new InvoiceLineModel()
    };

    protected override async Task OnInitializedAsync()
    {
        ValidateInitialData();

        if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            _isLoadingInventory = false;
            return;
        }

        await LoadInventoryAsync();
    }

    private async Task LoadInventoryAsync()
    {
        _isLoadingInventory = true;

        try
        {
            _salesRepId = await GetCurrentSalesRepIdAsync();

            if (_salesRepId <= 0)
            {
                _errorMessage = "لم يتم تحديد المندوب الحالي.";
                return;
            }

            var inventoryResponse =
                await SalesRepLoadRequestApiService.GetInventoryAsync(_salesRepId);

            if (inventoryResponse is null)
            {
                _errorMessage = "لم يتم استلام بيانات المخزون من الخادم.";
                return;
            }

            if (!inventoryResponse.Success)
            {
                _errorMessage = inventoryResponse.Message ?? "فشل تحميل مخزون المندوب.";
                return;
            }

            _inventoryItems = inventoryResponse.Data?
                .Where(x => x.Quantity > 0)
                .OrderBy(x => x.ProductName)
                .ToList()
                ?? new List<SalesRepInventoryDto>();
        }
        finally
        {
            _isLoadingInventory = false;
        }
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private void AddInvoiceLine()
    {
        _invoiceLines.Add(new InvoiceLineModel());
    }

    private void RemoveInvoiceLine(InvoiceLineModel line)
    {
        if (_invoiceLines.Count == 1)
            return;

        _invoiceLines.Remove(line);
    }

    private void OnProductChanged(InvoiceLineModel line, ChangeEventArgs e)
    {
        _errorMessage = null;

        if (!int.TryParse(e.Value?.ToString(), out var productId) || productId <= 0)
        {
            line.ProductId = 0;
            line.SelectedInventoryItem = null;
            return;
        }

        if (IsProductSelectedInAnotherLine(productId, line))
        {
            var productName = _inventoryItems
                .FirstOrDefault(x => x.ProductId == productId)?
                .ProductName ?? "المنتج";

            _errorMessage = $"المنتج {productName} مضاف بالفعل في الفاتورة.";

            line.ProductId = 0;
            line.SelectedInventoryItem = null;

            return;
        }

        line.ProductId = productId;

        line.SelectedInventoryItem = _inventoryItems
            .FirstOrDefault(x => x.ProductId == line.ProductId);
    }

    private async Task CreateConfirmAndCompleteAsync()
    {
        if (!Validate())
            return;

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new CreateSalesRepMobileInvoiceRequest
            {
                VisitId = VisitId,
                CustomerId = CustomerId,
                SalesRepSessionId = SessionId,
                DiscountAmount = _invoiceDiscountAmount,
                Notes = _notes,
                Items = _invoiceLines.Select(x => new CreateSalesRepMobileInvoiceItemRequest
                {
                    ProductId = x.ProductId,
                    Quantity = x.Quantity,
                    BonusQuantity = x.BonusQuantity,
                    DiscountAmount = x.ItemDiscountAmount,
                    DiscountPercentage = 0
                }).ToList()
            };

            var response =
                await SalesRepInvoiceApiService.CreateMobileInvoiceAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success || response.Data is null)
            {
                _errorMessage = response.Message ?? "فشل إنشاء الفاتورة.";
                return;
            }

            _successMessage = "تم إنشاء الفاتورة وإغلاق الزيارة بنجاح.";

            await Task.Delay(700);

            GoBackToRouteCustomers();
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ValidateInitialData()
    {
        if (VisitId <= 0 || SessionId <= 0 || CustomerId <= 0 || RouteId <= 0)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
        }
    }

    private bool Validate()
    {
        _errorMessage = null;

        if (VisitId <= 0)
        {
            _errorMessage = "VisitId غير صحيح.";
            return false;
        }

        if (SessionId <= 0)
        {
            _errorMessage = "SessionId غير صحيح.";
            return false;
        }

        if (CustomerId <= 0)
        {
            _errorMessage = "CustomerId غير صحيح.";
            return false;
        }

        if (RouteId <= 0)
        {
            _errorMessage = "RouteId غير صحيح.";
            return false;
        }

        if (_invoiceLines.Count == 0)
        {
            _errorMessage = "الفاتورة لازم تحتوي على منتج واحد على الأقل.";
            return false;
        }
        var duplicateProductGroup = _invoiceLines
    .Where(x => x.ProductId > 0)
    .GroupBy(x => x.ProductId)
    .FirstOrDefault(x => x.Count() > 1);

        if (duplicateProductGroup is not null)
        {
            var productName = _inventoryItems
                .FirstOrDefault(x => x.ProductId == duplicateProductGroup.Key)?
                .ProductName ?? "المنتج";

            _errorMessage = $"المنتج {productName} مكرر في الفاتورة. اختاره مرة واحدة فقط.";

            return false;
        }

        foreach (var line in _invoiceLines)
        {
            if (line.ProductId <= 0)
            {
                _errorMessage = "اختار المنتج في كل سطر.";
                return false;
            }

            line.SelectedInventoryItem = _inventoryItems
                .FirstOrDefault(x => x.ProductId == line.ProductId);

            if (line.SelectedInventoryItem is null)
            {
                _errorMessage = "يوجد منتج غير صحيح في الفاتورة.";
                return false;
            }

            if (line.Quantity <= 0)
            {
                _errorMessage = "Quantity لازم تكون أكبر من صفر.";
                return false;
            }

            if (line.BonusQuantity < 0)
            {
                _errorMessage = "Bonus Quantity لا يمكن يكون أقل من صفر.";
                return false;
            }

            if (line.ItemDiscountAmount < 0)
            {
                _errorMessage = "Item Discount لا يمكن يكون أقل من صفر.";
                return false;
            }
        }

        foreach (var group in _invoiceLines.GroupBy(x => x.ProductId))
        {
            var inventoryItem = _inventoryItems
                .FirstOrDefault(x => x.ProductId == group.Key);

            if (inventoryItem is null)
            {
                _errorMessage = "يوجد منتج غير موجود في المخزون.";
                return false;
            }

            var requestedQuantity = group.Sum(x => x.Quantity + x.BonusQuantity);

            if (requestedQuantity > inventoryItem.Quantity)
            {
                _errorMessage =
                    $"الكمية المطلوبة من المنتج {inventoryItem.ProductName} أكبر من المتاح. المتاح: {FormatQuantity(inventoryItem.Quantity)}";

                return false;
            }
        }

        if (_invoiceDiscountAmount < 0)
        {
            _errorMessage = "Invoice Discount لا يمكن يكون أقل من صفر.";
            return false;
        }

        return true;
    }

    private int GetRequestedQuantityForProduct(int productId)
    {
        if (productId <= 0)
            return 0;

        return _invoiceLines
            .Where(x => x.ProductId == productId)
            .Sum(x => x.Quantity + x.BonusQuantity);
    }

    private void GoBackToRouteCustomers()
    {
        if (SessionId > 0 && RouteId > 0)
        {
            NavigationManager.NavigateTo(
                $"/routes/{RouteId}/customers?sessionId={SessionId}",
                replace: true);

            return;
        }

        NavigationManager.NavigateTo("/routes", replace: true);
    }
    private bool IsProductSelectedInAnotherLine(
    int productId,
    InvoiceLineModel currentLine)
    {
        if (productId <= 0)
            return false;

        return _invoiceLines.Any(x =>
            x.LineId != currentLine.LineId &&
            x.ProductId == productId);
    }

    private bool IsRequestedQuantityGreaterThanAvailable(InvoiceLineModel line)
    {
        if (line.ProductId <= 0 || line.SelectedInventoryItem is null)
            return false;

        var requestedQuantity = GetRequestedQuantityForProduct(line.ProductId);

        return requestedQuantity > line.SelectedInventoryItem.Quantity;
    }

    private static string FormatQuantity(decimal value)
    {
        return value.ToString("N0");
    }

    private class InvoiceLineModel
    {
        public Guid LineId { get; set; } = Guid.NewGuid();

        public int ProductId { get; set; }

        public int Quantity { get; set; } = 1;

        public int BonusQuantity { get; set; }

        public decimal ItemDiscountAmount { get; set; }

        public SalesRepInventoryDto? SelectedInventoryItem { get; set; }
    }
}