@page "/"
@page "/login"

@layout Salesync.SalesRep.Pwa.Layout.AuthLayout

@using Salesync.SalesRep.Pwa.Auth
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject IAuthApiService AuthApiService
@inject SalesyncAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>تسجيل الدخول - Salesync</PageTitle>

<div class="login-page" dir="rtl">

    <div class="login-shell">

        <section class="login-brand-panel">

            <div class="brand-mark">
                S
            </div>

            <div class="brand-content">

                <span class="brand-eyebrow">
                    SALESYNC
                </span>

                <h1>
                    منصة إدارة المبيعات
                    <br />
                    والتوزيع الميداني
                </h1>

                <p>
                    نظام موحد لإدارة فرق المبيعات، العملاء، العمليات والتقارير.
                </p>

            </div>

            <div class="brand-footer">

                <span class="brand-status-dot"></span>

                <span>
                    Enterprise Distribution Platform
                </span>

            </div>

        </section>


        <section class="login-card">

            <div class="login-card-header">

                <span class="login-eyebrow">
                    تسجيل الدخول
                </span>

                <h2>
                    مرحبًا بعودتك
                </h2>

                <p>
                    أدخل بيانات حسابك للوصول إلى Salesync.
                </p>

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="login-alert"
                     role="alert">

                    <div class="alert-icon">
                        !
                    </div>

                    <div>
                        <strong>
                            تعذر تسجيل الدخول
                        </strong>

                        <span>
                            @errorMessage
                        </span>
                    </div>

                </div>
            }


            <EditForm Model="loginRequest"
                      OnValidSubmit="HandleLoginAsync"
                      class="login-form">

                <DataAnnotationsValidator />


                <div class="form-field">

                    <label for="userName">
                        اسم المستخدم
                    </label>

                    <div class="input-shell">

                        <span class="input-icon">
                            ◉
                        </span>

                        <InputText id="userName"
                                   class="login-input"
                                   autocomplete="username"
                                   disabled="@isSubmitting"
                                   placeholder="أدخل اسم المستخدم"
                                   @bind-Value="loginRequest.UserName" />

                    </div>

                    <ValidationMessage For="@(() => loginRequest.UserName)" />

                </div>


                <div class="form-field">

                    <label for="password">
                        كلمة المرور
                    </label>

                    <div class="input-shell">

                        <span class="input-icon">
                            ◆
                        </span>

                        <InputText id="password"
                                   type="password"
                                   class="login-input"
                                   autocomplete="current-password"
                                   disabled="@isSubmitting"
                                   placeholder="أدخل كلمة المرور"
                                   @bind-Value="loginRequest.Password" />

                    </div>

                    <ValidationMessage For="@(() => loginRequest.Password)" />

                </div>


                <button type="submit"
                        class="login-submit"
                        disabled="@isSubmitting">

                    @if (isSubmitting)
                    {
                        <span class="login-spinner"></span>

                        <span>
                            جاري تسجيل الدخول...
                        </span>
                    }
                    else
                    {
                        <span>
                            تسجيل الدخول
                        </span>

                        <span class="login-arrow">
                            ←
                        </span>
                    }

                </button>

            </EditForm>


            <div class="login-security">

                <span class="security-dot"></span>

                <span>
                    اتصال آمن ومحمي
                </span>

            </div>

        </section>

    </div>


    <footer class="login-page-footer">

        <strong>
            Salesync
        </strong>

        <span>
            Enterprise Distribution Platform
        </span>

    </footer>

</div>


@code
{
    private readonly LoginRequest loginRequest = new();

    private bool isSubmitting;

    private string? errorMessage;


    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }


    private async Task HandleLoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;

            var response =
                await AuthApiService.LoginAsync(
                    loginRequest);

            if (!response.Success ||
                response.Data is null)
            {
                errorMessage =
                    GetErrorMessage(response);

                return;
            }

            if (string.IsNullOrWhiteSpace(
                    response.Data.Token))
            {
                errorMessage =
                    "لم يتم استلام رمز تسجيل دخول صالح من الخادم.";

                return;
            }

            if (response.Data.ExpiresAt <=
                DateTime.UtcNow)
            {
                errorMessage =
                    "رمز تسجيل الدخول منتهي الصلاحية.";

                return;
            }

            await AuthStateProvider
                .SignInAsync(
                    response.Data);

            Navigation.NavigateTo(
                GetDestination(
                    response.Data.Role));
        }
        catch
        {
            errorMessage =
                "حدث خطأ غير متوقع أثناء تسجيل الدخول.";
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private string GetDestination(
        string role)
    {
        if (!string.IsNullOrWhiteSpace(
                ReturnUrl))
        {
            var returnUrl =
                ReturnUrl.Trim();

            var isSafeRelativeUrl =
                Uri.IsWellFormedUriString(
                    returnUrl,
                    UriKind.Relative)
                && !returnUrl.StartsWith(
                    "//",
                    StringComparison.Ordinal)
                && !returnUrl.StartsWith(
                    "\\",
                    StringComparison.Ordinal);

            if (isSafeRelativeUrl)
            {
                var destination =
                    $"/{returnUrl.TrimStart('/')}";

                if (!destination.Equals(
                        "/login",
                        StringComparison.OrdinalIgnoreCase))
                {
                    return destination;
                }
            }
        }

        return role switch
        {
            "SalesRep" => "/dashboard",

            "Supervisor" => "/operations",

            "Warehouse" => "/operations",

            "Admin" => "/operations",

            _ => "/login"
        };
    }


    private static string GetErrorMessage(
        ApiResponse<TokenResponse> response)
    {
        if (response.Errors is { Count: > 0 })
        {
            return string.Join(
                " ",
                response.Errors);
        }

        return response.Message
            ?? "اسم المستخدم أو كلمة المرور غير صحيحة.";
    }
}