@page "/"
@page "/login"

@layout Salesync.SalesRep.Pwa.Layout.AuthLayout

@using Salesync.SalesRep.Pwa.Auth
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject IAuthApiService AuthApiService
@inject SalesyncAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation


<PageTitle>Login - Salesync</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <h1 class="h3">Salesync</h1>

                        <p class="text-muted mb-0">
                            Sales Representative Login
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger"
                             role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="loginRequest"
                              OnValidSubmit="HandleLoginAsync">

                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="userName"
                                   class="form-label">
                                اسم المستخدم
                            </label>

                            <InputText id="userName"
                                       class="form-control"
                                       autocomplete="username"
                                       disabled="@isSubmitting"
                                       @bind-Value="loginRequest.UserName" />

                            <ValidationMessage For="@(() => loginRequest.UserName)" />
                        </div>

                        <div class="mb-3">
                            <label for="password"
                                   class="form-label">
                                كلمة المرور
                            </label>

                            <InputText id="password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       disabled="@isSubmitting"
                                       @bind-Value="loginRequest.Password" />

                            <ValidationMessage For="@(() => loginRequest.Password)" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100"
                                disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true">
                                </span>

                                <span>جاري تسجيل الدخول...</span>
                            }
                            else
                            {
                                <span>تسجيل الدخول</span>
                            }

                        </button>

                    </EditForm>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private readonly LoginRequest loginRequest = new();

    private bool isSubmitting;
    private string? errorMessage;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task HandleLoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;

            var response =
                await AuthApiService.LoginAsync(loginRequest);

            if (!response.Success || response.Data is null)
            {
                errorMessage = GetErrorMessage(response);
                return;
            }

            if (string.IsNullOrWhiteSpace(response.Data.Token))
            {
                errorMessage =
                    "لم يتم استلام رمز تسجيل دخول صالح من الخادم.";

                return;
            }

            if (response.Data.ExpiresAt <= DateTime.UtcNow)
            {
                errorMessage =
                    "رمز تسجيل الدخول منتهي الصلاحية.";

                return;
            }

            await AuthStateProvider.SignInAsync(response.Data);
            Navigation.NavigateTo(GetDestination(response.Data.Role));
        }
        catch
        {
            errorMessage =
                "حدث خطأ غير متوقع أثناء تسجيل الدخول.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetDestination(string role)
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            var returnUrl = ReturnUrl.Trim();

            var isSafeRelativeUrl =
                Uri.IsWellFormedUriString(
                    returnUrl,
                    UriKind.Relative)
                && !returnUrl.StartsWith(
                    "//",
                    StringComparison.Ordinal)
                && !returnUrl.StartsWith(
                    "\\",
                    StringComparison.Ordinal);

            if (isSafeRelativeUrl)
            {
                var destination =
                    $"/{returnUrl.TrimStart('/')}";

                if (!destination.Equals(
                    "/login",
                    StringComparison.OrdinalIgnoreCase))
                {
                    return destination;
                }
            }
        }

        return role switch
        {
            "SalesRep" => "/dashboard",

            "Supervisor" => "/operations",

            "Warehouse" => "/operations",

            "Admin" => "/operations",

            _ => "/login"
        };
    }

    private static string GetErrorMessage(
        ApiResponse<TokenResponse> response)
    {
        if (response.Errors is { Count: > 0 })
        {
            return string.Join(" ", response.Errors);
        }

        return response.Message
            ?? "اسم المستخدم أو كلمة المرور غير صحيحة.";
    }
}