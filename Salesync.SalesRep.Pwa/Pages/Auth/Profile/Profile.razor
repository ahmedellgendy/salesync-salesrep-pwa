@page "/profile"
@attribute [Authorize]

@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses

@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Profile - Salesync</PageTitle>

<div class="rep-profile-page" dir="rtl">

    @if (_isLoading)
    {
        <div class="rep-profile-loading">
            <div class="premium-spinner"></div>
            <strong>جاري تحميل بياناتك...</strong>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="premium-alert error">
            @_errorMessage
        </div>

        <button type="button"
                class="rep-profile-main-btn"
                @onclick="LoadProfileAsync">
            إعادة المحاولة
        </button>
    }
    else
    {
        <section class="rep-profile-header">

            <div class="rep-profile-avatar">
                @GetInitials(GetDisplayName())
            </div>

            <div class="rep-profile-main">
                <span>مندوب مبيعات</span>
                <h1>@GetDisplayName()</h1>
                <p>@DisplayValue(_profile?.SalesRepCode)</p>
            </div>

        </section>

        <section class="rep-profile-summary">

            <div class="rep-summary-row">
                <span>الفرع</span>
                <strong>@DisplayValue(_profile?.BranchName)</strong>
            </div>

            <div class="rep-summary-row">
                <span>رقم الفرع</span>
                <strong>@DisplayValue(GetBranchIdText())</strong>
            </div>

            <div class="rep-summary-row">
                <span>الصلاحية</span>
                <strong>@DisplayValue(_role)</strong>
            </div>

            <div class="rep-summary-row">
                <span>اسم المستخدم</span>
                <strong>@DisplayValue(_userName)</strong>
            </div>

        </section>

        <section class="rep-profile-contact-card">

            <div class="rep-section-title">
                بيانات التواصل
            </div>

            <div class="rep-contact-item">
                <div class="rep-contact-icon">☎</div>
                <div>
                    <span>رقم الهاتف</span>
                    <strong>@DisplayValue(_profile?.Phone)</strong>
                </div>
            </div>

            <div class="rep-contact-item">
                <div class="rep-contact-icon">📱</div>
                <div>
                    <span>الموبايل</span>
                    <strong>@DisplayValue(_profile?.Mobile)</strong>
                </div>
            </div>

            <div class="rep-contact-item">
                <div class="rep-contact-icon">✉</div>
                <div>
                    <span>البريد الإلكتروني</span>
                    <strong>@DisplayValue(_profile?.Email)</strong>
                </div>
            </div>

        </section>

        <section class="rep-profile-contact-card">

            <div class="rep-section-title">
                بيانات إضافية
            </div>

            <div class="rep-contact-item">
                <div class="rep-contact-icon">🏢</div>
                <div>
                    <span>Business Unit</span>
                    <strong>@DisplayValue(GetBusinessUnitText())</strong>
                </div>
            </div>

            <div class="rep-contact-item">
                <div class="rep-contact-icon">#</div>
                <div>
                    <span>Sales Rep ID</span>
                    <strong>@DisplayValue(_profile?.SalesRepId.ToString())</strong>
                </div>
            </div>

        </section>

        <section class="rep-profile-actions">

            <button type="button"
                    class="rep-profile-main-btn"
                    disabled="@_isRefreshing"
                    @onclick="RefreshProfileAsync">
                @(_isRefreshing ? "جاري التحديث..." : "تحديث البيانات")
            </button>

            <button type="button"
                    class="rep-profile-back-btn"
                    @onclick="GoToDashboard">
                رجوع للرئيسية
            </button>

        </section>
    }

</div>

@code {
    private bool _isLoading = true;
    private bool _isRefreshing;

    private string? _errorMessage;

    private SalesRepMobileProfileDto? _profile;

    private string? _claimFullName;
    private string? _userName;
    private string? _role;
    private string? _branchIdFromClaims;
    private string? _businessUnitIdFromClaims;

    protected override async Task OnInitializedAsync()
    {
        await LoadClaimsAsync();
        await LoadProfileAsync();

        _isLoading = false;
    }

    private async Task LoadClaimsAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user = authenticationState.User;

        if (user.Identity?.IsAuthenticated != true)
            return;

        _claimFullName =
            user.FindFirst("FullName")?.Value
            ?? user.FindFirst("fullName")?.Value
            ?? user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("name")?.Value
            ?? user.Identity?.Name;

        _userName =
            user.FindFirst("user_name")?.Value
            ?? user.FindFirst("username")?.Value
            ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? user.Identity?.Name;

        _role =
            user.FindFirst(ClaimTypes.Role)?.Value
            ?? user.FindFirst("role")?.Value
            ?? "SalesRep";

        _branchIdFromClaims =
            user.FindFirst("branch_id")?.Value
            ?? user.FindFirst("BranchId")?.Value;

        _businessUnitIdFromClaims =
            user.FindFirst("business_unit_id")?.Value
            ?? user.FindFirst("BusinessUnitId")?.Value;
    }

    private async Task LoadProfileAsync()
    {
        _errorMessage = null;

        try
        {
            var response =
                await HttpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            if (response is null)
            {
                _errorMessage = "لم يتم استلام بيانات الملف الشخصي من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل تحميل بيانات الملف الشخصي.";
                return;
            }

            _profile = response.Data;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "تعذر الاتصال بالخادم. تأكد من تشغيل Salesync API.";
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء تحميل الملف الشخصي.";
        }
    }

    private async Task RefreshProfileAsync()
    {
        _isRefreshing = true;

        try
        {
            await LoadProfileAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private string GetDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_profile?.Name))
            return _profile.Name;

        if (!string.IsNullOrWhiteSpace(_claimFullName))
            return _claimFullName;

        return "مندوب Salesync";
    }

    private string GetBranchIdText()
    {
        if (_profile?.BranchId > 0)
            return _profile.BranchId.ToString();

        return _branchIdFromClaims ?? string.Empty;
    }

    private string GetBusinessUnitText()
    {
        if (_profile?.BusinessUnitId.HasValue == true)
            return _profile.BusinessUnitId.Value.ToString();

        return _businessUnitIdFromClaims ?? string.Empty;
    }

    private void GoToDashboard()
    {
        NavigationManager.NavigateTo("/dashboard");
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "غير متوفر"
            : value;
    }

    private static string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "SR";

        var parts = value
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
    }
}