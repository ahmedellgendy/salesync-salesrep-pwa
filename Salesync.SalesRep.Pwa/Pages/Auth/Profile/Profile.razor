@page "/profile"

@attribute [Authorize]

@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Profile - Salesync</PageTitle>

<div class="container py-4">

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border"
                 role="status">
                <span class="visually-hidden">
                    Loading...
                </span>
            </div>

            <p class="mt-3">
                جاري تحميل البيانات...
            </p>
        </div>
    }
    else if (user is not null)
    {
        <h1 class="h3 mb-4">
            الملف الشخصي
        </h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary text-white
                        d-inline-flex align-items-center
                        justify-content-center"
                         style="width:72px;height:72px;font-size:28px;">

                        @GetInitial(fullName)
                    </div>

                    <h2 class="h4 mt-3 mb-1">
                        @fullName
                    </h2>

                    <p class="text-muted mb-0">
                        @role
                    </p>
                </div>

                <hr />

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">
                                اسم المستخدم
                            </div>

                            <div class="fw-semibold">
                                @DisplayValue(userName)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">
                                الصلاحية
                            </div>

                            <div class="fw-semibold">
                                @DisplayValue(role)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">
                                رقم الفرع
                            </div>

                            <div class="fw-semibold">
                                @DisplayValue(branchId)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">
                                Business Unit
                            </div>

                            <div class="fw-semibold">
                                @DisplayValue(businessUnitId)
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@code {
    private ClaimsPrincipal? user;

    private string? fullName;
    private string? userName;
    private string? role;
    private string? branchId;
    private string? businessUnitId;

    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        user = authenticationState.User;

        fullName =
            user.Identity?.Name;

        userName =
            user.FindFirst("user_name")?.Value;

        role =
            user.FindFirst(ClaimTypes.Role)?.Value;

        branchId =
            user.FindFirst("branch_id")?.Value;

        businessUnitId =
            user.FindFirst("business_unit_id")?.Value;

        isLoading = false;
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "غير متوفر"
            : value;
    }

    private static string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "S";
        }

        return value.Trim()[0]
            .ToString()
            .ToUpperInvariant();
    }
}