@page "/profile"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses.Profile
@using Salesync.SalesRep.Pwa.Services.Api

@inject ProfileApiService ProfileApiService
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

<PageTitle>حسابي - Salesync</PageTitle>

<div class="rep-profile-page" dir="rtl">

    @if (_isLoading)
    {
        <div class="rep-profile-loading">
            <div class="premium-spinner"></div>
            <strong>جاري تحميل بياناتك...</strong>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="premium-alert error">
            @_errorMessage
        </div>

        <button type="button"
                class="rep-profile-main-btn"
                @onclick="LoadProfileAsync">
            إعادة المحاولة
        </button>
    }
    else if (_profile is not null)
    {
        <section class="rep-profile-header">

            <div class="rep-profile-avatar">
                @if (HasProfileImage())
                {
                    <img src="@GetProfileImageUrl()"
                         alt="صورة المستخدم"
                         onerror="this.style.display='none';" />
                }
                else
                {
                    <span>
                        @GetInitials(_profile.FullName)
                    </span>
                }
            </div>

            <div class="rep-profile-main">

                <span>
                    @GetRoleDisplayName()
                </span>

                <h1>
                    @DisplayValue(_profile.FullName)
                </h1>

                @if (!string.IsNullOrWhiteSpace(_profile.SalesRepCode))
                {
                    <p>
                        @_profile.SalesRepCode
                    </p>
                }

            </div>

        </section>


        <section class="rep-profile-summary">

            <div class="rep-summary-row">
                <span>
                    الفرع
                </span>

                <strong>
                    @DisplayValue(_profile.BranchName)
                </strong>
            </div>


            <div class="rep-summary-row">
                <span>
                    رقم الفرع
                </span>

                <strong>
                    @DisplayValue(
                        _profile.BranchId?.ToString())
                </strong>
            </div>


            <div class="rep-summary-row">
                <span>
                    الصلاحية
                </span>

                <strong>
                    @GetRoleDisplayName()
                </strong>
            </div>


            <div class="rep-summary-row">
                <span>
                    اسم المستخدم
                </span>

                <strong>
                    @DisplayValue(_profile.UserName)
                </strong>
            </div>

        </section>


        <section class="rep-profile-contact-card">

            <div class="rep-section-title">
                بيانات التواصل
            </div>


            <div class="rep-contact-item">

                <div class="rep-contact-icon">
                    ☎
                </div>

                <div>
                    <span>
                        رقم الهاتف
                    </span>

                    <strong>
                        @DisplayValue(_profile.Phone)
                    </strong>
                </div>

            </div>


            <div class="rep-contact-item">

                <div class="rep-contact-icon">
                    ✉
                </div>

                <div>
                    <span>
                        البريد الإلكتروني
                    </span>

                    <strong>
                        @DisplayValue(_profile.Email)
                    </strong>
                </div>

            </div>

        </section>


        <section class="rep-profile-contact-card">

            <div class="rep-section-title">
                بيانات إضافية
            </div>


            @if (_profile.BusinessUnitId.HasValue)
            {
                <div class="rep-contact-item">

                    <div class="rep-contact-icon">
                        🏢
                    </div>

                    <div>
                        <span>
                            Business Unit
                        </span>

                        <strong>
                            @_profile.BusinessUnitId.Value
                        </strong>
                    </div>

                </div>
            }


            @if (_profile.SalesRepId.HasValue)
            {
                <div class="rep-contact-item">

                    <div class="rep-contact-icon">
                        #
                    </div>

                    <div>
                        <span>
                            @GetProfileIdLabel()
                        </span>

                        <strong>
                            @_profile.SalesRepId.Value
                        </strong>
                    </div>

                </div>
            }


            @if (!string.IsNullOrWhiteSpace(
                    _profile.SalesRepCode))
            {
                <div class="rep-contact-item">

                    <div class="rep-contact-icon">
                        ID
                    </div>

                    <div>
                        <span>
                            @GetProfileCodeLabel()
                        </span>

                        <strong>
                            @_profile.SalesRepCode
                        </strong>
                    </div>

                </div>
            }

        </section>


        <section class="rep-profile-actions">

            <button type="button"
                    class="rep-profile-main-btn"
                    disabled="@_isRefreshing"
                    @onclick="RefreshProfileAsync">

                @(_isRefreshing
                    ? "جاري التحديث..."
                    : "تحديث البيانات")

            </button>


            <button type="button"
                    class="rep-profile-back-btn"
                    @onclick="GoToHome">

                رجوع للرئيسية

            </button>

        </section>
    }

</div>


@code
{
    private bool _isLoading = true;
    private bool _isRefreshing;

    private string? _errorMessage;

    private CurrentUserProfileDto? _profile;


    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();

        _isLoading = false;
    }


    private async Task LoadProfileAsync()
    {
        _errorMessage = null;

        try
        {
            var response =
                await ProfileApiService.GetMyProfileAsync();

            if (response is null)
            {
                _errorMessage =
                    "لم يتم استلام بيانات الملف الشخصي من الخادم.";

                return;
            }


            if (!response.Success)
            {
                _errorMessage =
                    response.Message
                    ?? "فشل تحميل بيانات الملف الشخصي.";

                return;
            }


            if (response.Data is null)
            {
                _errorMessage =
                    "بيانات الملف الشخصي غير متوفرة.";

                return;
            }


            _profile = response.Data;
        }
        catch (HttpRequestException)
        {
            _errorMessage =
                "تعذر الاتصال بالخادم. تأكد من تشغيل Salesync API.";
        }
        catch
        {
            _errorMessage =
                "حدث خطأ غير متوقع أثناء تحميل الملف الشخصي.";
        }
    }


    private async Task RefreshProfileAsync()
    {
        if (_isRefreshing)
            return;

        _isRefreshing = true;

        try
        {
            await LoadProfileAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }


    private string GetRoleDisplayName()
    {
        return _profile?.Role switch
        {
            "Supervisor" => "مشرف مبيعات",
            "SalesRep" => "مندوب مبيعات",
            "Admin" => "مدير النظام",
            "Warehouse" => "مسؤول مخزن",
            "Treasury" => "مسؤول خزينة",
            _ => "مستخدم Salesync"
        };
    }


    private string GetProfileIdLabel()
    {
        return _profile?.Role switch
        {
            "Supervisor" => "Supervisor ID",
            "SalesRep" => "Sales Rep ID",
            _ => "Profile ID"
        };
    }


    private string GetProfileCodeLabel()
    {
        return _profile?.Role switch
        {
            "Supervisor" => "كود المشرف",
            "SalesRep" => "كود المندوب",
            _ => "الكود"
        };
    }


    private void GoToHome()
    {
        var destination =
            _profile?.Role switch
            {
                "Supervisor" => "/operations",
                "Admin" => "/operations",
                "Warehouse" => "/operations",
                "SalesRep" => "/dashboard",
                _ => "/"
            };

        NavigationManager.NavigateTo(destination);
    }


    private static string DisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "غير متوفر"
            : value;
    }


    private static string GetInitials(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "SY";


        var parts =
            value
                .Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2]
                    .ToUpperInvariant()
                : parts[0]
                    .ToUpperInvariant();
        }


        return
            $"{parts[0][0]}{parts[1][0]}"
                .ToUpperInvariant();
    }


    private bool HasProfileImage()
    {
        return !string.IsNullOrWhiteSpace(
            _profile?.ProfileImageUrl);
    }


    private string GetProfileImageUrl()
    {
        var imageUrl =
            _profile?.ProfileImageUrl;

        if (string.IsNullOrWhiteSpace(imageUrl))
            return string.Empty;


        if (imageUrl.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase)
            ||
            imageUrl.StartsWith(
                "https://",
                StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }


        var baseUrl =
            HttpClient.BaseAddress?.ToString();

        if (string.IsNullOrWhiteSpace(baseUrl))
            return imageUrl;


        return new Uri(
            new Uri(baseUrl),
            imageUrl)
            .ToString();
    }
}