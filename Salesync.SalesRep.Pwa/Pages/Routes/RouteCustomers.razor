@page "/routes/{RouteId:int}/customers"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepRouteApiService SalesRepRouteApiService
@inject NavigationManager NavigationManager

<div class="route-customers-page" dir="rtl">

    <section class="route-hero">
        <div>
            <span>خط السير</span>
            <h1>عملاء اليوم</h1>
            <p>ابدأ زياراتك حسب ترتيب العملاء على الخط.</p>
        </div>

        <div class="route-hero-icon">
            🧭
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="route-loading-card">
            جاري تحميل عملاء خط السير...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="route-alert error">
            @_errorMessage
        </div>
    }
    else
    {
        <section class="route-progress-card">
            <div class="route-progress-top">
                <div>
                    <span>تقدم الزيارات</span>
                    <strong>@_visitedCustomers من @_totalCustomers</strong>
                </div>

                <div class="route-progress-pill">
                    @_remainingCustomers متبقي
                </div>
            </div>

            <div class="route-progress-bar">
                <div class="route-progress-fill" style="width:@GetProgressWidth()"></div>
            </div>

            <div class="route-kpi-row">
                <div>
                    <strong>@_totalCustomers</strong>
                    <span>العملاء</span>
                </div>

                <div>
                    <strong>@_visitedCustomers</strong>
                    <span>تمت</span>
                </div>

                <div>
                    <strong>@_remainingCustomers</strong>
                    <span>متبقي</span>
                </div>
            </div>
        </section>

        <section class="route-search-card">
            <input class="route-search-input"
                   placeholder="ابحث باسم العميل أو رقم الهاتف..."
                   @bind="_searchText"
                   @bind:event="oninput" />

            <div class="route-filter-group">
                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.All) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.All)">
                    الكل
                </button>

                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.NotVisited) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.NotVisited)">
                    لم تتم
                </button>

                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.Visited) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.Visited)">
                    تمت
                </button>
            </div>
        </section>

        @if (FilteredCustomers.Count == 0)
        {
            <div class="route-empty-card">
                <div class="route-empty-icon">🔍</div>
                <h3>لا يوجد عملاء</h3>
                <p>لا يوجد عملاء مطابقين للبحث أو الفلتر الحالي.</p>
            </div>
        }
        else
        {
            <section class="customers-list">
                @foreach (var customer in FilteredCustomers)
                {
                    <article class="customer-card compact @GetCustomerCardClass(customer)">

                        <div class="customer-card-main-header">

                            <div class="customer-title-block">
                                <div class="customer-name">
                                    @customer.CustomerName
                                </div>

                                <div class="customer-status @GetCustomerStatusClass(customer)">
                                    @GetCustomerStatusText(customer)
                                </div>
                            </div>

                            <div class="customer-sequence">
                                #@GetVisitSequence(customer)
                            </div>

                        </div>

                        <div class="customer-location-line">
                            <span>العنوان</span>
                            <strong>@GetCustomerAddressText(customer)</strong>
                        </div>

                        <div class="customer-finance-list">
                            <div>
                                <span>الرصيد</span>
                                <strong>@FormatMoney(customer.CurrentBalance)</strong>
                            </div>

                            <div>
                                <span>حد الائتمان</span>
                                <strong>@FormatMoney(customer.CreditLimit)</strong>
                            </div>
                        </div>

                        <div class="customer-quick-actions @(HasMapLocation(customer) && !string.IsNullOrWhiteSpace(customer.Phone) ? "" : "single")">

                            @if (!string.IsNullOrWhiteSpace(customer.Phone))
                            {
                                <a class="customer-quick-btn call"
                                   href="tel:@NormalizePhoneNumber(customer.Phone)"
                                   @onclick:stopPropagation="true">
                                    <span>☎</span>
                                    اتصال بالعميل
                                </a>
                            }

                            @if (HasMapLocation(customer))
                            {
                                <button type="button"
                                        class="customer-quick-btn map"
                                        @onclick="() => OpenCustomerLocation(customer)">
                                    <span>📍</span>
                                    فتح الموقع
                                </button>
                            }

                        </div>

                        @if (IsVisitInProgress(customer))
                        {
                            <button class="customer-action-btn continue"
                                    @onclick="() => ContinueVisit(customer)">
                                استكمال الزيارة
                            </button>
                        }
                        else if (IsVisitCompleted(customer))
                        {
                            <button class="customer-action-btn completed" disabled>
                                تمت الزيارة
                            </button>
                        }
                        else if (customer.CanStartVisit)
                        {
                            <button class="customer-action-btn"
                                    @onclick="() => StartVisit(customer)">
                                بدء الزيارة
                            </button>
                        }
                        else
                        {
                            <button class="customer-action-btn disabled" disabled>
                                يوجد زيارة مفتوحة
                            </button>
                        }

                    </article>
                }
            </section>
        }

        <button class="route-back-btn" @onclick="GoBackToRoutes">
            رجوع للخطوط
        </button>
    }

</div>

@code {
    [Parameter]
    public int RouteId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;

    private CustomerFilter _selectedFilter = CustomerFilter.All;

    private List<SalesRepMobileCustomerDto> _customers = new();

    private int _totalCustomers => _customers.Count;

    private int _visitedCustomers =>
        _customers.Count(x => x.HasVisitToday);

    private int _remainingCustomers =>
        _customers.Count(x => !x.HasVisitToday);

    private List<SalesRepMobileCustomerDto> FilteredCustomers =>
        _customers
            .Where(MatchesSelectedFilter)
            .Where(MatchesSearchText)
            .OrderBy(x => x.VisitSequence)
            .ThenBy(x => x.CustomerName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (RouteId <= 0 || SessionId <= 0)
        {
            _errorMessage = "بيانات خط السير غير مكتملة.";
            _isLoading = false;
            return;
        }

        await LoadCustomersAsync();

        _isLoading = false;
    }

    private async Task LoadCustomersAsync()
    {
        var response = await SalesRepRouteApiService.GetRouteCustomersAsync(
            SessionId,
            RouteId);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل عملاء خط السير.";
            return;
        }

        _customers = response.Data?.ToList()
            ?? new List<SalesRepMobileCustomerDto>();
    }

    private bool MatchesSelectedFilter(SalesRepMobileCustomerDto customer)
    {
        return _selectedFilter switch
        {
            CustomerFilter.Visited => customer.HasVisitToday,
            CustomerFilter.NotVisited => !customer.HasVisitToday,
            _ => true
        };
    }

    private bool MatchesSearchText(SalesRepMobileCustomerDto customer)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search = _searchText.Trim();

        return Contains(customer.CustomerName, search)
            || Contains(customer.Phone, search)
            || Contains(customer.Address, search)
            || Contains(customer.Area, search)
            || Contains(customer.City, search);
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private void SetFilter(CustomerFilter filter)
    {
        _selectedFilter = filter;
    }

    private bool IsFilterActive(CustomerFilter filter)
    {
        return _selectedFilter == filter;
    }

    private static bool IsVisitInProgress(SalesRepMobileCustomerDto customer)
    {
        return customer.HasVisitToday
            && customer.VisitStatus == 2
            && customer.VisitId.HasValue;
    }

    private static bool IsVisitCompleted(SalesRepMobileCustomerDto customer)
    {
        return customer.HasVisitToday
            && customer.VisitStatus == 3;
    }

    private static string GetCustomerCardClass(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "in-progress";

        if (IsVisitCompleted(customer))
            return "completed";

        return string.Empty;
    }

    private static string GetCustomerStatusText(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "زيارة مفتوحة";

        if (IsVisitCompleted(customer))
            return "تمت الزيارة";

        return "لم تتم الزيارة";
    }

    private static string GetCustomerStatusClass(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "progress";

        if (IsVisitCompleted(customer))
            return "completed";

        return "new";
    }

    private static int GetVisitSequence(SalesRepMobileCustomerDto customer)
    {
        return customer.VisitSequence <= 0
            ? 1
            : customer.VisitSequence;
    }

    private static string FormatMoney(decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString("N2")
            : "0.00";
    }
    private static string GetCustomerLocation(SalesRepMobileCustomerDto customer)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(customer.Area))
            parts.Add(customer.Area);

        if (!string.IsNullOrWhiteSpace(customer.City))
            parts.Add(customer.City);

        return parts.Count > 0
            ? string.Join(" - ", parts)
            : string.Empty;
    }

    

    private static string GetCustomerAddressText(SalesRepMobileCustomerDto customer)
    {
        if (!string.IsNullOrWhiteSpace(customer.Address))
            return customer.Address;

        var location = GetCustomerLocation(customer);

        return string.IsNullOrWhiteSpace(location)
            ? "لا يوجد عنوان مسجل"
            : location;
    }

    private static bool HasMapLocation(SalesRepMobileCustomerDto customer)
    {
        return customer.Latitude.HasValue && customer.Longitude.HasValue
            || !string.IsNullOrWhiteSpace(customer.Address);
    }

    private void OpenCustomerLocation(SalesRepMobileCustomerDto customer)
    {
        string url;

        if (customer.Latitude.HasValue && customer.Longitude.HasValue)
        {
            url = $"https://www.google.com/maps?q={customer.Latitude},{customer.Longitude}";
        }
        else if (!string.IsNullOrWhiteSpace(customer.Address))
        {
            url = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(customer.Address)}";
        }
        else
        {
            return;
        }

        NavigationManager.NavigateTo(url, forceLoad: true);
    }

    private string GetProgressWidth()
    {
        if (_totalCustomers <= 0)
            return "0%";

        var percent = (decimal)_visitedCustomers / _totalCustomers * 100;
        return $"{percent:N0}%";
    }

    private void StartVisit(SalesRepMobileCustomerDto customer)
    {
        NavigationManager.NavigateTo(
            $"/visits/start?sessionId={SessionId}&customerId={customer.CustomerId}&routeId={customer.RouteId}");
    }

    private void ContinueVisit(SalesRepMobileCustomerDto customer)
    {
        if (!customer.VisitId.HasValue)
            return;

        NavigationManager.NavigateTo(
            $"/visits/{customer.VisitId.Value}?sessionId={SessionId}&customerId={customer.CustomerId}&routeId={customer.RouteId}");
    }

    private void GoBackToRoutes()
    {
        NavigationManager.NavigateTo($"/routes/{SessionId}");
    }
    private static string NormalizePhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        return phone
            .Replace(" ", string.Empty)
            .Replace("-", string.Empty)
            .Replace("(", string.Empty)
            .Replace(")", string.Empty);
    }

    private enum CustomerFilter
    {
        All = 1,
        NotVisited = 2,
        Visited = 3
    }
}