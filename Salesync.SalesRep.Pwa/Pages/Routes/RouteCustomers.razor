@page "/routes/{RouteId:int}/customers"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepRouteApiService SalesRepRouteApiService
@inject NavigationManager NavigationManager

<div class="mobile-app-page">

    <div class="mobile-app-header">
        <div>
            <h3 class="mobile-app-title">عملاء الخط</h3>

            <div class="mobile-app-subtitle">
                زيارات اليوم حسب خط السير
            </div>
        </div>

        <div class="mobile-avatar">
            R
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="card p-3">
            <p class="mb-0">جاري تحميل عملاء خط السير...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }
    else
    {
        <div class="mobile-hero-card">
            <div class="mobile-hero-title">
                تقدم الزيارات
            </div>

            <div class="mobile-hero-text">
                تمت زيارة @_visitedCustomers من @_totalCustomers عميل
            </div>

            <div class="mobile-hero-pill">
                @_remainingCustomers متبقي
            </div>
        </div>

        <div class="mobile-kpi-section">
            <div class="mobile-kpi-tile">
                <div class="mobile-kpi-number">
                    @_totalCustomers
                </div>

                <div class="mobile-kpi-name">
                    العملاء
                </div>
            </div>

            <div class="mobile-kpi-tile">
                <div class="mobile-kpi-number">
                    @_visitedCustomers
                </div>

                <div class="mobile-kpi-name">
                    تمت
                </div>
            </div>

            <div class="mobile-kpi-tile">
                <div class="mobile-kpi-number">
                    @_remainingCustomers
                </div>

                <div class="mobile-kpi-name">
                    متبقي
                </div>
            </div>
        </div>

        <div class="route-search-card">
            <input class="form-control"
                   placeholder="بحث باسم العميل أو رقم التليفون..."
                   @bind="_searchText"
                   @bind:event="oninput" />

            <div class="route-filter-group">
                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.All) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.All)">
                    الكل
                </button>

                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.NotVisited) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.NotVisited)">
                    لم تتم
                </button>

                <button type="button"
                        class="route-filter-btn @(IsFilterActive(CustomerFilter.Visited) ? "active" : "")"
                        @onclick="() => SetFilter(CustomerFilter.Visited)">
                    تمت
                </button>
            </div>
        </div>

        <div class="d-grid mb-3">
            <button class="btn btn-outline-secondary"
                    @onclick="GoBackToRoutes">
                رجوع
            </button>
        </div>

        @if (FilteredCustomers.Count == 0)
        {
            <div class="alert alert-warning">
                لا يوجد عملاء مطابقين للبحث أو الفلتر الحالي.
            </div>
        }
        else
        {
            @foreach (var customer in FilteredCustomers)
            {
                <div class="customer-mobile-card @GetCustomerCardClass(customer)">

                    <div class="customer-card-header">
                        <div>
                            <div class="customer-name">
                                @customer.CustomerName
                            </div>

                            <div class="customer-route">
                                @customer.RouteName
                            </div>
                        </div>

                        <div class="customer-sequence">
                            #@GetVisitSequence(customer)
                        </div>
                    </div>

                    <div class="customer-status-pill @GetCustomerStatusClass(customer)">
                        @GetCustomerStatusText(customer)
                    </div>

                    <div class="customer-info-grid">
                        <div class="customer-info-box">
                            <div class="customer-info-label">
                                الرصيد
                            </div>

                            <div class="customer-info-value">
                                @FormatMoney(customer.CurrentBalance)
                            </div>
                        </div>

                        <div class="customer-info-box">
                            <div class="customer-info-label">
                                حد الائتمان
                            </div>

                            <div class="customer-info-value">
                                @FormatMoney(customer.CreditLimit)
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(customer.Phone))
                        {
                            <div class="customer-info-box">
                                <div class="customer-info-label">
                                    الهاتف
                                </div>

                                <div class="customer-info-value">
                                    @customer.Phone
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(customer.Area) || !string.IsNullOrWhiteSpace(customer.City))
                        {
                            <div class="customer-info-box">
                                <div class="customer-info-label">
                                    المنطقة
                                </div>

                                <div class="customer-info-value">
                                    @customer.Area @customer.City
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(customer.Address))
                    {
                        <div class="customer-address-box">
                            <strong>العنوان:</strong>
                            @customer.Address
                        </div>
                    }

                    @if (IsVisitInProgress(customer))
                    {
                        <button class="customer-main-action continue"
                                @onclick="() => ContinueVisit(customer)">
                            Continue Visit
                        </button>
                    }
                    else if (IsVisitCompleted(customer))
                    {
                        <button class="customer-main-action completed" disabled>
                            Visit Completed
                        </button>
                    }
                    else if (customer.CanStartVisit)
                    {
                        <button class="customer-main-action"
                                @onclick="() => StartVisit(customer)">
                            Start Visit
                        </button>
                    }
                    else
                    {
                        <button class="customer-main-action completed" disabled>
                            يوجد زيارة مفتوحة
                        </button>
                    }

                </div>
            }
        }
    }

</div>

@code {
    [Parameter]
    public int RouteId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private string _searchText = string.Empty;

    private CustomerFilter _selectedFilter = CustomerFilter.All;

    private List<SalesRepMobileCustomerDto> _customers = new();

    private int _totalCustomers => _customers.Count;

    private int _visitedCustomers =>
        _customers.Count(x => x.HasVisitToday);

    private int _remainingCustomers =>
        _customers.Count(x => !x.HasVisitToday);

    private List<SalesRepMobileCustomerDto> FilteredCustomers =>
        _customers
            .Where(MatchesSelectedFilter)
            .Where(MatchesSearchText)
            .OrderBy(x => x.VisitSequence)
            .ThenBy(x => x.CustomerName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (RouteId <= 0 || SessionId <= 0)
        {
            _errorMessage = "بيانات خط السير غير مكتملة.";
            _isLoading = false;
            return;
        }

        await LoadCustomersAsync();

        _isLoading = false;
    }

    private async Task LoadCustomersAsync()
    {
        var response = await SalesRepRouteApiService.GetRouteCustomersAsync(
            SessionId,
            RouteId);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل عملاء خط السير.";
            return;
        }

        _customers = response.Data?.ToList()
            ?? new List<SalesRepMobileCustomerDto>();
    }

    private bool MatchesSelectedFilter(SalesRepMobileCustomerDto customer)
    {
        return _selectedFilter switch
        {
            CustomerFilter.Visited => customer.HasVisitToday,
            CustomerFilter.NotVisited => !customer.HasVisitToday,
            _ => true
        };
    }

    private bool MatchesSearchText(SalesRepMobileCustomerDto customer)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search = _searchText.Trim();

        return Contains(customer.CustomerName, search)
            || Contains(customer.Phone, search)
            || Contains(customer.Address, search)
            || Contains(customer.Area, search)
            || Contains(customer.City, search);
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private void SetFilter(CustomerFilter filter)
    {
        _selectedFilter = filter;
    }

    private bool IsFilterActive(CustomerFilter filter)
    {
        return _selectedFilter == filter;
    }

    private static bool IsVisitInProgress(SalesRepMobileCustomerDto customer)
    {
        return customer.HasVisitToday
            && customer.VisitStatus == 2
            && customer.VisitId.HasValue;
    }

    private static bool IsVisitCompleted(SalesRepMobileCustomerDto customer)
    {
        return customer.HasVisitToday
            && customer.VisitStatus == 3;
    }

    private static string GetCustomerCardClass(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "in-progress";

        if (IsVisitCompleted(customer))
            return "completed";

        return string.Empty;
    }

    private static string GetCustomerStatusText(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "زيارة مفتوحة";

        if (IsVisitCompleted(customer))
            return "تمت الزيارة";

        return "لم تتم الزيارة";
    }

    private static string GetCustomerStatusClass(SalesRepMobileCustomerDto customer)
    {
        if (IsVisitInProgress(customer))
            return "customer-status-progress";

        if (IsVisitCompleted(customer))
            return "customer-status-completed";

        return "customer-status-new";
    }

    private static int GetVisitSequence(SalesRepMobileCustomerDto customer)
    {
        return customer.VisitSequence <= 0
            ? 1
            : customer.VisitSequence;
    }

    private static string FormatMoney(decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString("N2")
            : "0.00";
    }

    private void StartVisit(SalesRepMobileCustomerDto customer)
    {
        NavigationManager.NavigateTo(
            $"/visits/start?sessionId={SessionId}&customerId={customer.CustomerId}&routeId={customer.RouteId}");
    }

    private void ContinueVisit(SalesRepMobileCustomerDto customer)
    {
        if (!customer.VisitId.HasValue)
            return;

        NavigationManager.NavigateTo(
            $"/visits/{customer.VisitId.Value}?sessionId={SessionId}&customerId={customer.CustomerId}&routeId={customer.RouteId}");
    }

    private void GoBackToRoutes()
    {
        NavigationManager.NavigateTo($"/routes/{SessionId}");
    }

    private enum CustomerFilter
    {
        All = 1,
        NotVisited = 2,
        Visited = 3
    }
}