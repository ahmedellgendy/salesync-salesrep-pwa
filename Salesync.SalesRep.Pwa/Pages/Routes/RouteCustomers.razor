@page "/routes/{RouteId:int}/customers"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepRouteApiService SalesRepRouteApiService
@inject NavigationManager NavigationManager

<h3>عملاء خط السير</h3>

@if (_isLoading)
{
    <p>جاري تحميل العملاء...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_customers.Count == 0)
{
    <div class="alert alert-warning">
        لا يوجد عملاء على خط السير الحالي.
    </div>
}
else
{
    <div class="d-grid gap-2 mb-3">
        <button class="btn btn-secondary"
                @onclick="GoBackToRoutes">
            Back To Routes
        </button>
    </div>

    <div class="mb-3">
        <strong>عدد العملاء:</strong> @_customers.Count
    </div>

    @foreach (var customer in _customers)
    {
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5>@customer.CustomerName</h5>
                    <small class="text-muted">@customer.RouteName</small>
                </div>

                <span class="badge bg-secondary">
                    #@customer.VisitSequence
                </span>
            </div>

            <hr />

            @if (!string.IsNullOrWhiteSpace(customer.Phone))
            {
                <p class="mb-1"><strong>Phone:</strong> @customer.Phone</p>
            }

            @if (!string.IsNullOrWhiteSpace(customer.Address))
            {
                <p class="mb-1"><strong>Address:</strong> @customer.Address</p>
            }

            <p class="mb-1"><strong>Current Balance:</strong> @customer.CurrentBalance</p>
            <p class="mb-1"><strong>Credit Limit:</strong> @customer.CreditLimit</p>

            @if (customer.HasVisitToday)
            {
                <div class="alert alert-success mt-2 mb-2">
                    تم تسجيل زيارة لهذا العميل اليوم.
                </div>

                <p class="mb-1"><strong>Visit Id:</strong> @customer.VisitId</p>
                <p class="mb-1"><strong>Visit Status:</strong> @GetVisitStatusText(customer.VisitStatus)</p>
                <p class="mb-1"><strong>Visit Type:</strong> @GetVisitTypeText(customer.VisitType)</p>
            }
            else
            {
                <div class="alert alert-info mt-2 mb-2">
                    لم تتم زيارة هذا العميل اليوم.
                </div>
            }

            @if (customer.CanStartVisit)
            {
                <button class="btn btn-primary w-100"
                        @onclick="() => StartVisit(customer)">
                    Start Visit
                </button>
            }
            else
            {
                <button class="btn btn-secondary w-100" disabled>
                    Visit Completed
                </button>
            }
        </div>
    }
}

@code {
    [Parameter]
    public int RouteId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;

    private List<SalesRepMobileCustomerDto> _customers = new();

    protected override async Task OnInitializedAsync()
    {
        if (RouteId <= 0 || SessionId <= 0)
        {
            _errorMessage = "بيانات خط السير غير مكتملة.";
            _isLoading = false;
            return;
        }

        await LoadCustomersAsync();

        _isLoading = false;
    }

    private async Task LoadCustomersAsync()
    {
        var response = await SalesRepRouteApiService.GetRouteCustomersAsync(
            SessionId,
            RouteId);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل عملاء خط السير.";
            return;
        }

        _customers = response.Data?.ToList() ?? new List<SalesRepMobileCustomerDto>();
    }

    private void StartVisit(SalesRepMobileCustomerDto customer)
    {
        NavigationManager.NavigateTo(
            $"/visits/start?sessionId={SessionId}&customerId={customer.CustomerId}&routeId={customer.RouteId}");
    }

    private void GoBackToRoutes()
    {
        NavigationManager.NavigateTo($"/routes/{SessionId}");
    }

    private static string GetVisitStatusText(int? status)
    {
        return status switch
        {
            1 => "Planned",
            2 => "In Progress",
            3 => "Completed",
            4 => "Cancelled",
            _ => "-"
        };
    }

    private static string GetVisitTypeText(int? type)
    {
        return type switch
        {
            1 => "Positive",
            2 => "Negative",
            _ => "-"
        };
    }
}