@page "/payments/create"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepPaymentApiService SalesRepPaymentApiService
@inject NavigationManager NavigationManager

<div class="collect-payment-page" dir="rtl">

    <section class="collect-payment-card">

        <div class="collect-payment-header">
            <div class="collect-payment-title">
                <span class="payment-page-badge">
                    تحصيل فاتورة
                </span>

                <h1>تسجيل تحصيل</h1>

                <p>
                    سجل المبلغ المحصل من العميل لهذه الفاتورة.
                </p>
            </div>

            <div class="collect-payment-icon">
                💵
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="collect-payment-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="collect-payment-alert success">
                @_successMessage
            </div>
        }

        <section class="payment-invoice-summary">

            <div class="payment-invoice-number">
                <span>رقم الفاتورة</span>
                <strong>@GetInvoiceNumberText()</strong>
            </div>

            <div class="payment-amount-box">
                <span>المتبقي للتحصيل</span>
                <strong>@FormatMoney(RemainingAmount)</strong>
            </div>

        </section>

        <div class="collect-payment-form-group">
            <label>المبلغ المحصل</label>

            <input type="number"
                   step="0.01"
                   min="0"
                   max="@RemainingAmount"
                   disabled="@_isProcessing"
                   @bind="_amount" />
        </div>

        <div class="collect-payment-form-group">
            <label>طريقة الدفع</label>

            <select disabled="@_isProcessing"
                    @bind="_paymentMethod">
                <option value="1">نقدي</option>
                <option value="2">شيك</option>
                <option value="3">تحويل</option>
            </select>
        </div>

        <div class="collect-payment-form-group">
            <label>ملاحظات</label>

            <textarea placeholder="اكتب ملاحظات التحصيل..."
                      disabled="@_isProcessing"
                      @bind="_notes"></textarea>
        </div>

        <button type="button"
                class="collect-payment-main-btn"
                disabled="@_isProcessing"
                @onclick="CreatePaymentAsync">
            @(_isProcessing ? "جاري تسجيل التحصيل..." : "حفظ التحصيل")
        </button>

        <button type="button"
                class="collect-payment-back-btn"
                disabled="@_isProcessing"
                @onclick="GoBack">
            رجوع للفواتير
        </button>

    </section>

</div>

@code {
    [SupplyParameterFromQuery(Name = "invoiceId")]
    public int InvoiceId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "remainingAmount")]
    public decimal RemainingAmount { get; set; }

    [SupplyParameterFromQuery(Name = "invoiceNumber")]
    public string? InvoiceNumber { get; set; }

    private decimal _amount;
    private int _paymentMethod = 1;
    private string? _notes;

    private bool _isProcessing;
    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnParametersSet()
    {
        if (RemainingAmount > 0 && _amount <= 0)
        {
            _amount = RemainingAmount;
        }
    }

    private async Task CreatePaymentAsync()
    {
        if (!Validate())
            return;

        try
        {
            _isProcessing = true;
            _errorMessage = null;
            _successMessage = null;

            var request = new CreateSalesRepMobilePaymentRequest
            {
                InvoiceId = InvoiceId,
                Amount = _amount,
                PaymentMethod = _paymentMethod,
                Notes = _notes
            };

            var response =
                await SalesRepPaymentApiService.CreatePaymentAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل تسجيل التحصيل.";

                if (response.Errors is { Count: > 0 })
                {
                    _errorMessage += " " + string.Join(" ", response.Errors);
                }

                return;
            }

            _successMessage = "تم تسجيل التحصيل بنجاح.";

            await Task.Delay(700);

            NavigationManager.NavigateTo($"/invoices/{SessionId}", replace: true);
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء تسجيل التحصيل.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool Validate()
    {
        _errorMessage = null;

        if (InvoiceId <= 0)
        {
            _errorMessage = "بيانات الفاتورة غير صحيحة.";
            return false;
        }

        if (SessionId <= 0)
        {
            _errorMessage = "بيانات السيشن غير صحيحة.";
            return false;
        }

        if (_amount <= 0)
        {
            _errorMessage = "المبلغ المحصل لازم يكون أكبر من صفر.";
            return false;
        }

        if (RemainingAmount > 0 && _amount > RemainingAmount)
        {
            _errorMessage = "المبلغ المحصل لا يمكن يكون أكبر من المتبقي.";
            return false;
        }

        return true;
    }

    private string GetInvoiceNumberText()
    {
        return string.IsNullOrWhiteSpace(InvoiceNumber)
            ? "غير محدد"
            : InvoiceNumber;
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2");
    }

    private void GoBack()
    {
        if (SessionId > 0)
        {
            NavigationManager.NavigateTo($"/invoices/{SessionId}");
            return;
        }

        NavigationManager.NavigateTo("/invoices");
    }
}