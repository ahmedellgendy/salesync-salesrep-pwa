@page "/load-requests"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepLoadRequestApiService LoadRequestApiService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<h3>My Load Requests</h3>

@if (_isLoading)
{
    <p>جاري تحميل طلبات التحميل...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else
{
    <div class="d-grid gap-2 mb-3">
        <button class="btn btn-primary"
                @onclick="GoToCreate">
            Create Load Request
        </button>

        <button class="btn btn-outline-dark"
                @onclick="GoToInventory">
            My Inventory
        </button>
    </div>

    @if (_loadRequests.Count == 0)
    {
        <div class="alert alert-warning">
            لا يوجد Load Requests حتى الآن.
        </div>
    }
    else
    {
        @foreach (var loadRequest in _loadRequests)
        {
            <div class="card p-3 mb-3">
                <h5>@loadRequest.LoadRequestNumber</h5>

                <p class="mb-1"><strong>Id:</strong> @loadRequest.Id</p>
                <p class="mb-1"><strong>Status:</strong> @GetStatusText(loadRequest.Status)</p>
                <p class="mb-1"><strong>Warehouse:</strong> @loadRequest.WarehouseName (@loadRequest.WarehouseId)</p>
                <p class="mb-1"><strong>Request Date:</strong> @loadRequest.RequestDate.ToLocalTime()</p>

                @if (!string.IsNullOrWhiteSpace(loadRequest.Notes))
                {
                    <p class="mb-1"><strong>Notes:</strong> @loadRequest.Notes</p>
                }

                @if (loadRequest.Items.Count > 0)
                {
                    <hr />

                    @foreach (var item in loadRequest.Items)
                    {
                        <div class="border rounded p-2 mb-2">
                            <p class="mb-1"><strong>Product:</strong> @item.ProductName (@item.ProductId)</p>
                            <p class="mb-1"><strong>Item Code:</strong> @item.ItemCode</p>
                            <p class="mb-1"><strong>Requested:</strong> @item.RequestedQuantity</p>
                            <p class="mb-1"><strong>Approved:</strong> @item.ApprovedQuantity</p>
                            <p class="mb-1"><strong>Confirmed:</strong> @item.ConfirmedQuantity</p>
                        </div>
                    }
                }
            </div>
        }
    }
}

@code {
    private bool _isLoading = true;
    private string? _errorMessage;

    private int _salesRepId;
    private List<LoadRequestDto> _loadRequests = new();

    protected override async Task OnInitializedAsync()
    {
        _salesRepId = await GetCurrentSalesRepIdAsync();

        if (_salesRepId <= 0)
        {
            _errorMessage = "لم يتم العثور على SalesRepId للمندوب الحالي.";
            _isLoading = false;
            return;
        }

        await LoadRequestsAsync();

        _isLoading = false;
    }

    private async Task LoadRequestsAsync()
    {
        var response = await LoadRequestApiService.GetBySalesRepAsync(_salesRepId);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل طلبات التحميل.";
            return;
        }

        _loadRequests = response.Data?.ToList() ?? new List<LoadRequestDto>();
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private static string GetStatusText(int status)
    {
        return status switch
        {
            1 => "Pending",
            2 => "Approved",
            3 => "Rejected",
            4 => "Warehouse Confirmed",
            5 => "Cancelled",
            _ => status.ToString()
        };
    }

    private void GoToCreate()
    {
        NavigationManager.NavigateTo("/load-requests/create");
    }

    private void GoToInventory()
    {
        NavigationManager.NavigateTo("/inventory");
    }
}