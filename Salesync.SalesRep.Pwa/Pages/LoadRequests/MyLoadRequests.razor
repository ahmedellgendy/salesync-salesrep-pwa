@page "/load-requests"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepLoadRequestApiService LoadRequestApiService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<div class="load-requests-page" dir="rtl">

    <section class="load-requests-hero">
        <div>
            <span>طلبات التحميل</span>
            <h1>طلباتي</h1>
            <p>راجع طلبات التحميل وحالة موافقة المخزن عليها.</p>
        </div>

        <div class="load-requests-hero-icon">
            📋
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="load-requests-loading-card">
            جاري تحميل طلبات التحميل...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="load-requests-alert error">
            @_errorMessage
        </div>
    }
    else
    {
        <section class="load-requests-actions">
            <button type="button"
                    class="load-requests-action-btn primary"
                    @onclick="GoToCreate">
                <span>➕</span>
                <div>
                    <strong>طلب تحميل جديد</strong>
                    <small>اطلب منتجات من المخزن</small>
                </div>
            </button>

            <button type="button"
                    class="load-requests-action-btn secondary"
                    @onclick="GoToInventory">
                <span>📦</span>
                <div>
                    <strong>رجوع للمخزون</strong>
                    <small>راجع مخزونك الحالي</small>
                </div>
            </button>
        </section>

        <section class="load-requests-summary-card">
            <div>
                <span>إجمالي الطلبات</span>
                <strong>@_loadRequests.Count</strong>
            </div>

            <div>
                <span>قيد المراجعة</span>
                <strong>@GetPendingCount()</strong>
            </div>

            <div>
                <span>تم تأكيدها</span>
                <strong>@GetConfirmedCount()</strong>
            </div>
        </section>

        @if (_loadRequests.Count == 0)
        {
            <section class="load-requests-empty-card">
                <div class="load-requests-empty-icon">
                    📦
                </div>

                <h3>لا توجد طلبات تحميل</h3>

                <p>
                    لم تقم بإنشاء أي طلب تحميل حتى الآن.
                </p>

                <button type="button"
                        class="load-requests-empty-btn"
                        @onclick="GoToCreate">
                    إنشاء طلب تحميل
                </button>
            </section>
        }
        else
        {
            <section class="load-requests-list">

                @foreach (var loadRequest in _loadRequests)
                {
                    <article class="load-request-card @GetStatusClass(loadRequest.Status)">

                        <div class="load-request-card-header">
                            <div>
                                <span>رقم الطلب</span>
                                <strong>@loadRequest.LoadRequestNumber</strong>
                            </div>

                            <div class="load-request-status @GetStatusClass(loadRequest.Status)">
                                @GetStatusText(loadRequest.Status)
                            </div>
                        </div>

                        <div class="load-request-info-list">
                            <div>
                                <span>المخزن</span>
                                <strong>@GetWarehouseText(loadRequest)</strong>
                            </div>

                            <div>
                                <span>تاريخ الطلب</span>
                                <strong>@FormatDate(loadRequest.RequestDate)</strong>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(loadRequest.Notes))
                            {
                                <div>
                                    <span>ملاحظات</span>
                                    <strong>@loadRequest.Notes</strong>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(loadRequest.RejectionReason))
                            {
                                <div class="rejection">
                                    <span>سبب الرفض</span>
                                    <strong>@loadRequest.RejectionReason</strong>
                                </div>
                            }
                        </div>

                        <section class="load-request-items-section">

                            <div class="load-request-items-title">
                                <span>الأصناف المطلوبة</span>
                                <strong>@GetItems(loadRequest).Count صنف</strong>
                            </div>

                            @if (GetItems(loadRequest).Count == 0)
                            {
                                <div class="load-request-item-empty">
                                    لا توجد أصناف داخل هذا الطلب.
                                </div>
                            }
                            else
                            {
                                @foreach (var item in GetItems(loadRequest))
                                {
                                    <div class="load-request-item-card">

                                        <div class="load-request-item-header">
                                            <div>
                                                <strong>@item.ProductName</strong>

                                                @if (!string.IsNullOrWhiteSpace(item.ItemCode))
                                                {
                                                    <span>كود: @item.ItemCode</span>
                                                }
                                            </div>

                                            <div class="load-request-item-qty">
                                                @item.RequestedQuantity
                                            </div>
                                        </div>

                                        <div class="load-request-item-values">
                                            <div>
                                                <span>المطلوب</span>
                                                <strong>@item.RequestedQuantity</strong>
                                            </div>

                                            <div>
                                                <span>الموافق عليه</span>
                                                <strong>@item.ApprovedQuantity</strong>
                                            </div>

                                            <div>
                                                <span>المؤكد من المخزن</span>
                                                <strong>@item.ConfirmedQuantity</strong>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="load-request-item-notes">
                                                @item.Notes
                                            </div>
                                        }

                                    </div>
                                }
                            }

                        </section>

                    </article>
                }

            </section>
        }
    }

</div>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;

    private int _salesRepId;
    private List<LoadRequestDto> _loadRequests = new();

    protected override async Task OnInitializedAsync()
    {
        _salesRepId = await GetCurrentSalesRepIdAsync();

        if (_salesRepId <= 0)
        {
            _errorMessage = "لم يتم تحديد المندوب الحالي.";
            _isLoading = false;
            return;
        }

        await LoadRequestsAsync();

        _isLoading = false;
    }

    private async Task LoadRequestsAsync()
    {
        var response = await LoadRequestApiService.GetBySalesRepAsync(_salesRepId);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل طلبات التحميل.";
            return;
        }

        _loadRequests = response.Data?
            .OrderByDescending(x => x.RequestDate)
            .ToList()
            ?? new List<LoadRequestDto>();
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private static List<LoadRequestItemDto> GetItems(LoadRequestDto loadRequest)
    {
        return loadRequest.Items ?? new List<LoadRequestItemDto>();
    }

    private int GetPendingCount()
    {
        return _loadRequests.Count(x => x.Status == 1);
    }

    private int GetConfirmedCount()
    {
        return _loadRequests.Count(x => x.Status == 4);
    }

    private static string GetStatusText(int status)
    {
        return status switch
        {
            1 => "قيد المراجعة",
            2 => "تمت الموافقة",
            3 => "مرفوض",
            4 => "تم تأكيد المخزن",
            5 => "ملغي",
            _ => "غير معروف"
        };
    }

    private static string GetStatusClass(int status)
    {
        return status switch
        {
            1 => "pending",
            2 => "approved",
            3 => "rejected",
            4 => "confirmed",
            5 => "cancelled",
            _ => "unknown"
        };
    }

    private static string GetWarehouseText(LoadRequestDto loadRequest)
    {
        if (!string.IsNullOrWhiteSpace(loadRequest.WarehouseName))
            return loadRequest.WarehouseName;

        return $"مخزن رقم {loadRequest.WarehouseId}";
    }

    private static string FormatDate(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM/yyyy - hh:mm tt");
    }

    private void GoToCreate()
    {
        NavigationManager.NavigateTo("/load-requests/create");
    }

    private void GoToInventory()
    {
        NavigationManager.NavigateTo("/inventory");
    }
}