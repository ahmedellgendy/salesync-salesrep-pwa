@page "/load-requests/create"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepLoadRequestApiService LoadRequestApiService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<div class="create-load-page" dir="rtl">

    <section class="create-load-hero">
        <div>
            <span>طلبات التحميل</span>
            <h1>طلب تحميل جديد</h1>
            <p>اختر المخزن وحدد الكميات المطلوبة حسب وحدة الطلب.</p>
        </div>

        <div class="create-load-hero-icon">
            📦
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="create-load-loading-card">
            جاري تحميل المنتجات والمخازن...
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="create-load-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="create-load-alert success">
                @_successMessage
            </div>
        }

        <section class="create-load-card">

            <div class="create-load-section-title">
                <span>بيانات طلب التحميل</span>
                <strong>اختر المخزن والمنتجات المطلوبة</strong>
            </div>

            <div class="create-load-form-group">
                <label>المخزن</label>

                <select disabled="@_isProcessing"
                        @bind="_selectedWarehouseId">
                    <option value="0">اختار المخزن</option>

                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Name
                        </option>
                    }
                </select>
            </div>

            <section class="create-load-summary compact">
                <div>
                    <span>الأصناف</span>
                    <strong>@GetSelectedItemsCount()</strong>
                </div>

                <div>
                    <span>الكرتون</span>
                    <strong>@GetTotalRequestedLargeQuantity()</strong>
                </div>

                <div>
                    <span>القطع</span>
                    <strong>@GetTotalRequestedSmallQuantity()</strong>
                </div>
            </section>

            <section class="create-load-selected-warehouse">
                <span>المخزن</span>
                <strong>@GetSelectedWarehouseText()</strong>
            </section>

            <section class="create-load-products-toolbar">
                <div>
                    <span>المنتجات</span>
                    <strong>@_productLines.Count منتج متاح</strong>
                </div>

                <input class="create-load-search-input"
                       placeholder="ابحث عن منتج أو كود..."
                       disabled="@_isProcessing"
                       @bind="_searchText"
                       @bind:event="oninput" />
            </section>

            @if (_productLines.Count == 0)
            {
                <section class="create-load-empty-card">
                    <div>📦</div>
                    <h3>لا توجد منتجات</h3>
                    <p>لا توجد منتجات متاحة لإنشاء طلب تحميل.</p>
                </section>
            }
            else if (FilteredProductLines.Count == 0)
            {
                <section class="create-load-empty-card">
                    <div>🔍</div>
                    <h3>لا توجد نتائج</h3>
                    <p>لا يوجد منتج مطابق للبحث الحالي.</p>
                </section>
            }
            else
            {
                <section class="create-load-products-list">

                    @foreach (var line in FilteredProductLines)
                    {
                        <article class="create-load-product-card compact @(line.RequestedLargeQuantity > 0 ? "selected" : "")" @key="line.ProductId">

                            <div class="create-load-product-main">

                                <div class="create-load-product-info">
                                    <strong>@line.ProductName</strong>

                                    @if (!string.IsNullOrWhiteSpace(line.ItemCode))
                                    {
                                        <span>كود: @line.ItemCode</span>
                                    }
                                </div>

                                <div class="create-load-unit-pill">
                                    @line.LargeUnit
                                </div>

                            </div>

                            <div class="create-load-conversion-line">
                                <span>وحدة الطلب</span>
                                <strong>1 @line.LargeUnit = @line.UnitsPerLargeUnit @line.SmallUnit</strong>
                            </div>

                            <div class="create-load-qty-row">
                                <button type="button"
                                        disabled="@_isProcessing || line.RequestedLargeQuantity <= 0"
                                        @onclick="() => DecreaseQuantity(line)">
                                    -
                                </button>

                                <input type="number"
                                       min="0"
                                       disabled="@_isProcessing"
                                       @bind="line.RequestedLargeQuantity"
                                       @bind:after="() => OnLineQuantityChanged(line)" />

                                <button type="button"
                                        disabled="@_isProcessing"
                                        @onclick="() => IncreaseQuantity(line)">
                                    +
                                </button>
                            </div>

                            @if (line.RequestedLargeQuantity > 0)
                            {
                                <div class="create-load-selected-note">
                                    @line.RequestedLargeQuantity @line.LargeUnit = @line.RequestedSmallQuantity @line.SmallUnit
                                </div>
                            }

                        </article>
                    }

                </section>
            }

            <div class="create-load-form-group">
                <label>ملاحظات اختيارية</label>

                <textarea placeholder="اكتب ملاحظات طلب التحميل..."
                          disabled="@_isProcessing"
                          @bind="_notes"></textarea>
            </div>

            <button type="button"
                    class="create-load-main-btn"
                    disabled="@_isProcessing"
                    @onclick="CreateLoadRequestAsync">
                @(_isProcessing ? "جاري إرسال الطلب..." : "إرسال طلب التحميل")
            </button>

            <button type="button"
                    class="create-load-back-btn"
                    disabled="@_isProcessing"
                    @onclick="GoBack">
                رجوع للطلبات
            </button>

        </section>
    }

</div>

@code {
    private bool _isLoading = true;
    private bool _isProcessing;

    private int _salesRepId;
    private int _selectedWarehouseId;

    private string? _notes;
    private string? _searchText;
    private string? _errorMessage;
    private string? _successMessage;

    private List<MobileWarehouseOptionDto> _warehouses = new();
    private List<LoadRequestProductLineModel> _productLines = new();

    private List<LoadRequestProductLineModel> FilteredProductLines =>
        _productLines
            .Where(MatchesSearchText)
            .OrderByDescending(x => x.RequestedLargeQuantity > 0)
            .ThenBy(x => x.ProductName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        _salesRepId = await GetCurrentSalesRepIdAsync();

        if (_salesRepId <= 0)
        {
            _errorMessage = "لم يتم تحديد المندوب الحالي.";
            _isLoading = false;
            return;
        }

        await LoadOptionsAsync();

        _isLoading = false;
    }

    private async Task LoadOptionsAsync()
    {
        await LoadWarehousesAsync();
        await LoadProductsAsync();

        if (_warehouses.Count == 1)
        {
            _selectedWarehouseId = _warehouses[0].Id;
        }
    }

    private async Task LoadWarehousesAsync()
    {
        var response = await LoadRequestApiService.GetWarehousesAsync();

        if (response is null)
        {
            _errorMessage = "لم يتم استلام بيانات المخازن من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل المخازن.";
            return;
        }

        _warehouses = response.Data?
            .OrderBy(x => x.Name)
            .ToList()
            ?? new List<MobileWarehouseOptionDto>();
    }

    private async Task LoadProductsAsync()
    {
        var response = await LoadRequestApiService.GetProductsAsync();

        if (response is null)
        {
            _errorMessage = "لم يتم استلام بيانات المنتجات من الخادم.";
            return;
        }

        if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل تحميل المنتجات.";
            return;
        }

        _productLines = response.Data?
            .OrderBy(x => x.Name)
            .Select(x => new LoadRequestProductLineModel
            {
                ProductId = x.Id,
                ProductName = x.Name,
                ItemCode = x.ItemCode,
                UnitPrice = x.UnitPrice,

                SmallUnit = string.IsNullOrWhiteSpace(x.SmallUnit)
                    ? "قطعة"
                    : x.SmallUnit,

                LargeUnit = string.IsNullOrWhiteSpace(x.LargeUnit)
                    ? "كرتونة"
                    : x.LargeUnit,

                UnitsPerLargeUnit = x.UnitsPerLargeUnit <= 0
                    ? 1
                    : x.UnitsPerLargeUnit,

                RequestedLargeQuantity = 0
            })
            .ToList()
            ?? new List<LoadRequestProductLineModel>();
    }

    private async Task CreateLoadRequestAsync()
    {
        if (!Validate())
            return;

        try
        {
            _isProcessing = true;
            _errorMessage = null;
            _successMessage = null;

            var selectedItems = _productLines
                .Where(x => x.RequestedLargeQuantity > 0)
                .Select(x => new CreateLoadRequestItemRequest
                {
                    ProductId = x.ProductId,

                    // الباك يستقبل الكمية النهائية بالوحدة الصغرى
                    RequestedQuantity = x.RequestedSmallQuantity,

                    Notes = BuildItemNote(x)
                })
                .ToList();

            var request = new CreateLoadRequestRequest
            {
                SalesRepId = _salesRepId,
                WarehouseId = _selectedWarehouseId,
                Notes = _notes,
                Items = selectedItems
            };

            var response = await LoadRequestApiService.CreateAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل إنشاء طلب التحميل.";

                if (response.Errors is { Count: > 0 })
                {
                    _errorMessage += " " + string.Join(" ", response.Errors);
                }

                return;
            }

            _successMessage = "تم إرسال طلب التحميل بنجاح.";

            await Task.Delay(700);

            NavigationManager.NavigateTo("/load-requests", replace: true);
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء إرسال طلب التحميل.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool Validate()
    {
        _errorMessage = null;

        if (_salesRepId <= 0)
        {
            _errorMessage = "بيانات المندوب غير صحيحة.";
            return false;
        }

        if (_selectedWarehouseId <= 0)
        {
            _errorMessage = "اختار المخزن أولًا.";
            return false;
        }

        var selectedItems = _productLines
            .Where(x => x.RequestedLargeQuantity > 0)
            .ToList();

        if (selectedItems.Count == 0)
        {
            _errorMessage = "اختار كمية لمنتج واحد على الأقل.";
            return false;
        }

        foreach (var item in _productLines)
        {
            if (item.RequestedLargeQuantity < 0)
            {
                _errorMessage = $"كمية المنتج {item.ProductName} لا يمكن تكون أقل من صفر.";
                return false;
            }

            if (item.UnitsPerLargeUnit <= 0)
            {
                _errorMessage = $"معامل تحويل المنتج {item.ProductName} غير صحيح.";
                return false;
            }
        }

        return true;
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private bool MatchesSearchText(LoadRequestProductLineModel line)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search = _searchText.Trim();

        return Contains(line.ProductName, search)
            || Contains(line.ItemCode, search)
            || Contains(line.SmallUnit, search)
            || Contains(line.LargeUnit, search);
    }

    private static bool Contains(string? value, string search)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private void OnLineQuantityChanged(LoadRequestProductLineModel line)
    {
        _errorMessage = null;

        if (line.RequestedLargeQuantity < 0)
        {
            line.RequestedLargeQuantity = 0;
        }
    }

    private void IncreaseQuantity(LoadRequestProductLineModel line)
    {
        _errorMessage = null;
        line.RequestedLargeQuantity++;
    }

    private void DecreaseQuantity(LoadRequestProductLineModel line)
    {
        _errorMessage = null;

        if (line.RequestedLargeQuantity > 0)
        {
            line.RequestedLargeQuantity--;
        }
    }

    private int GetSelectedItemsCount()
    {
        return _productLines.Count(x => x.RequestedLargeQuantity > 0);
    }

    private int GetTotalRequestedLargeQuantity()
    {
        return _productLines.Sum(x => x.RequestedLargeQuantity);
    }

    private int GetTotalRequestedSmallQuantity()
    {
        return _productLines.Sum(x => x.RequestedSmallQuantity);
    }

    private string GetSelectedWarehouseText()
    {
        var warehouse = _warehouses.FirstOrDefault(x => x.Id == _selectedWarehouseId);

        return warehouse is null
            ? "-"
            : warehouse.Name;
    }

    private string? BuildItemNote(LoadRequestProductLineModel line)
    {
        var conversionNote =
            $"{line.RequestedLargeQuantity} {line.LargeUnit} = {line.RequestedSmallQuantity} {line.SmallUnit}";

        if (string.IsNullOrWhiteSpace(_notes))
            return conversionNote;

        return $"{_notes} | {conversionNote}";
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/load-requests");
    }

    private class LoadRequestProductLineModel
    {
        public int ProductId { get; set; }

        public string ProductName { get; set; } = string.Empty;

        public string? ItemCode { get; set; }

        public decimal UnitPrice { get; set; }

        public string SmallUnit { get; set; } = "قطعة";

        public string LargeUnit { get; set; } = "كرتونة";

        public int UnitsPerLargeUnit { get; set; } = 1;

        public int RequestedLargeQuantity { get; set; }

        public int RequestedSmallQuantity =>
            RequestedLargeQuantity * UnitsPerLargeUnit;
    }
}