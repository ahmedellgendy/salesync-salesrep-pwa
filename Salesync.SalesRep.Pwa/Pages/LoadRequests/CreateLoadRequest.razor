@page "/load-requests/create"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepLoadRequestApiService LoadRequestApiService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<div class="create-load-page" dir="rtl">

    <section class="create-load-hero">
        <div>
            <span>طلبات التحميل</span>
            <h1>طلب تحميل جديد</h1>
            <p>اطلب المنتجات المطلوبة من المخزن لتحديث مخزونك.</p>
        </div>

        <div class="create-load-hero-icon">
            📦
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="create-load-loading-card">
            جاري تحميل بيانات المندوب...
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="create-load-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="create-load-alert success">
                @_successMessage
            </div>
        }

        <section class="create-load-card">

            <div class="create-load-section-title">
                <span>بيانات الطلب</span>
                <strong>طلب تحميل من المخزن</strong>
            </div>

            <div class="create-load-form-group">
                <label>رقم المخزن</label>

                <input type="number"
                       min="1"
                       disabled="@_isProcessing"
                       @bind="_warehouseId" />

                <small>مؤقتًا يتم إدخال رقم المخزن، وبعدها سيتم تحويلها لاختيار من قائمة.</small>
            </div>

            <div class="create-load-form-group">
                <label>رقم المنتج</label>

                <input type="number"
                       min="1"
                       disabled="@_isProcessing"
                       @bind="_productId" />

                <small>مؤقتًا يتم إدخال رقم المنتج، وبعدها سيتم تحويلها لاختيار المنتج بالاسم.</small>
            </div>

            <div class="create-load-form-group">
                <label>الكمية المطلوبة</label>

                <input type="number"
                       min="1"
                       disabled="@_isProcessing"
                       @bind="_requestedQuantity" />
            </div>

            <div class="create-load-form-group">
                <label>ملاحظات اختيارية</label>

                <textarea placeholder="اكتب ملاحظات طلب التحميل..."
                          disabled="@_isProcessing"
                          @bind="_notes"></textarea>
            </div>

            <section class="create-load-summary">
                <div>
                    <span>المخزن</span>
                    <strong>@_warehouseId</strong>
                </div>

                <div>
                    <span>المنتج</span>
                    <strong>@_productId</strong>
                </div>

                <div>
                    <span>الكمية</span>
                    <strong>@_requestedQuantity</strong>
                </div>
            </section>

            <button type="button"
                    class="create-load-main-btn"
                    disabled="@_isProcessing"
                    @onclick="CreateLoadRequestAsync">
                @(_isProcessing ? "جاري إرسال الطلب..." : "إرسال طلب التحميل")
            </button>

            <button type="button"
                    class="create-load-back-btn"
                    disabled="@_isProcessing"
                    @onclick="GoBack">
                رجوع للطلبات
            </button>

        </section>
    }

</div>

@code {
    private bool _isLoading = true;
    private bool _isProcessing;

    private int _salesRepId;
    private int _warehouseId = 1;
    private int _productId = 1;
    private int _requestedQuantity = 1;

    private string? _notes;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        _salesRepId = await GetCurrentSalesRepIdAsync();

        if (_salesRepId <= 0)
        {
            _errorMessage = "لم يتم تحديد المندوب الحالي.";
        }

        _isLoading = false;
    }

    private async Task CreateLoadRequestAsync()
    {
        if (!Validate())
            return;

        try
        {
            _isProcessing = true;
            _errorMessage = null;
            _successMessage = null;

            var request = new CreateLoadRequestRequest
            {
                SalesRepId = _salesRepId,
                WarehouseId = _warehouseId,
                Notes = _notes,
                Items =
                {
                    new CreateLoadRequestItemRequest
                    {
                        ProductId = _productId,
                        RequestedQuantity = _requestedQuantity,
                        Notes = _notes
                    }
                }
            };

            var response = await LoadRequestApiService.CreateAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل إنشاء طلب التحميل.";

                if (response.Errors is { Count: > 0 })
                {
                    _errorMessage += " " + string.Join(" ", response.Errors);
                }

                return;
            }

            _successMessage = "تم إرسال طلب التحميل بنجاح.";

            await Task.Delay(700);

            NavigationManager.NavigateTo("/load-requests", replace: true);
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء إرسال طلب التحميل.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool Validate()
    {
        _errorMessage = null;

        if (_salesRepId <= 0)
        {
            _errorMessage = "بيانات المندوب غير صحيحة.";
            return false;
        }

        if (_warehouseId <= 0)
        {
            _errorMessage = "رقم المخزن مطلوب.";
            return false;
        }

        if (_productId <= 0)
        {
            _errorMessage = "رقم المنتج مطلوب.";
            return false;
        }

        if (_requestedQuantity <= 0)
        {
            _errorMessage = "الكمية المطلوبة لازم تكون أكبر من صفر.";
            return false;
        }

        return true;
    }

    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("SalesyncApi");

            var response =
                await httpClient.GetFromJsonAsync<ApiResponse<SalesRepMobileProfileDto>>(
                    "api/mobile/salesrep/me");

            return response?.Success == true && response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/load-requests");
    }
}