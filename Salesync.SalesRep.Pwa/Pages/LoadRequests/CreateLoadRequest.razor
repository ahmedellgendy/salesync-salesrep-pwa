@page "/load-requests/create"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepLoadRequestApiService LoadRequestApiService
@inject NavigationManager NavigationManager
@inject IHttpClientFactory HttpClientFactory

<PageTitle>طلب تحميل جديد - Salesync</PageTitle>

<div class="create-load-page" dir="rtl">

    <section class="create-load-hero">

        <div class="hero-content">
            <span class="hero-eyebrow">
                طلبات التحميل
            </span>

            <h1>
                طلب تحميل جديد
            </h1>

            <p>
                اختر المخزن وحدد المنتجات والكميات المطلوبة.
            </p>
        </div>

        <div class="hero-icon">
            📦
        </div>

    </section>


    @if (_isLoading)
    {
        <section class="state-card">
            جاري تحميل المنتجات والمخازن...
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="create-load-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="create-load-alert success">
                @_successMessage
            </div>
        }


        <section class="load-options-card">

            <div class="section-heading">
                <span>
                    بيانات الطلب
                </span>

                <strong>
                    المخزن والمنتجات
                </strong>
            </div>


            <div class="warehouse-field">

                <label>
                    المخزن
                </label>

                <select disabled="@_isProcessing"
                        @bind="_selectedWarehouseId">

                    <option value="0">
                        اختر المخزن
                    </option>

                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Name
                        </option>
                    }

                </select>

            </div>


            <section class="request-summary">

                <div>
                    <span>
                        الأصناف
                    </span>

                    <strong>
                        @GetSelectedItemsCount()
                    </strong>
                </div>

                <div>
                    <span>
                        الكراتين
                    </span>

                    <strong>
                        @GetTotalRequestedLargeQuantity()
                    </strong>
                </div>

                <div>
                    <span>
                        القطع
                    </span>

                    <strong>
                        @GetTotalRequestedSmallQuantity()
                    </strong>
                </div>

            </section>


            <div class="products-toolbar">

                <div class="products-title">
                    <span>
                        المنتجات
                    </span>

                    <strong>
                        @_productLines.Count منتج متاح
                    </strong>
                </div>

                <div class="search-box">
                    <span>
                        🔍
                    </span>

                    <input placeholder="ابحث عن منتج أو كود..."
                           disabled="@_isProcessing"
                           @bind="_searchText"
                           @bind:event="oninput" />
                </div>

            </div>

        </section>


        @if (_productLines.Count == 0)
        {
            <section class="state-card">

                <div class="state-icon">
                    📦
                </div>

                <strong>
                    لا توجد منتجات
                </strong>

                <p>
                    لا توجد منتجات متاحة لإنشاء طلب تحميل.
                </p>

            </section>
        }
        else if (FilteredProductLines.Count == 0)
        {
            <section class="state-card">

                <div class="state-icon">
                    🔍
                </div>

                <strong>
                    لا توجد نتائج
                </strong>

                <p>
                    لا يوجد منتج مطابق للبحث الحالي.
                </p>

            </section>
        }
        else
        {
            <section class="products-list">

                @foreach (var line in FilteredProductLines)
                {
                    <article class="product-card @(line.RequestedLargeQuantity > 0 ? "selected" : "")"
                             @key="line.ProductId">

                        <div class="product-top">

                            <div class="product-details">

                                <span class="product-code">
                                    @DisplayProductCode(line.ItemCode)
                                </span>

                                <h2>
                                    @line.ProductName
                                </h2>

                            </div>


                            <span class="unit-badge">
                                @line.LargeUnit
                            </span>

                        </div>


                        <div class="product-meta">

                            <div>
                                <span>
                                    وحدة الطلب
                                </span>

                                <strong>
                                    1 @line.LargeUnit = @line.UnitsPerLargeUnit @line.SmallUnit
                                </strong>
                            </div>

                        </div>


                        <div class="quantity-section">

                            <div class="quantity-label">
                                <span>
                                    الكمية المطلوبة
                                </span>

                                @if (line.RequestedLargeQuantity > 0)
                                {
                                    <strong>
                                        @line.RequestedSmallQuantity @line.SmallUnit
                                    </strong>
                                }
                            </div>


                            <div class="quantity-control" dir="ltr">

                                <button type="button"
                                        class="quantity-btn minus"
                                        disabled="@(_isProcessing || line.RequestedLargeQuantity <= 0)"
                                        @onclick:preventDefault="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => DecreaseQuantity(line)">
                                    −
                                </button>


                                <input type="number"
                                       min="0"
                                       disabled="@_isProcessing"
                                       @bind="line.RequestedLargeQuantity"
                                       @bind:event="oninput"
                                       @bind:after="() => OnLineQuantityChanged(line)" />


                                <button type="button"
                                        class="quantity-btn plus"
                                        disabled="@_isProcessing"
                                        @onclick:preventDefault="true"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => IncreaseQuantity(line)">
                                    +
                                </button>

                            </div>

                        </div>

                    </article>
                }

            </section>
        }


        <section class="request-footer-card">

            <div class="notes-field">

                <label>
                    ملاحظات
                    <span>
                        اختياري
                    </span>
                </label>

                <textarea placeholder="اكتب أي ملاحظات على طلب التحميل..."
                          disabled="@_isProcessing"
                          @bind="_notes">
                </textarea>

            </div>


            <div class="final-summary">

                <div>
                    <span>
                        المنتجات المختارة
                    </span>

                    <strong>
                        @GetSelectedItemsCount()
                    </strong>
                </div>

                <div>
                    <span>
                        إجمالي الكراتين
                    </span>

                    <strong>
                        @GetTotalRequestedLargeQuantity()
                    </strong>
                </div>

            </div>


            <button type="button"
                    class="submit-button"
                    disabled="@_isProcessing"
                    @onclick="CreateLoadRequestAsync">

                @(_isProcessing
                    ? "جاري إرسال الطلب..."
                    : "إرسال طلب التحميل")

            </button>


            <button type="button"
                    class="back-button"
                    disabled="@_isProcessing"
                    @onclick="GoBack">

                رجوع للطلبات

            </button>

        </section>
    }

</div>


@code
{
    private bool _isLoading = true;
    private bool _isProcessing;

    private int _salesRepId;
    private int _selectedWarehouseId;

    private string? _notes;
    private string? _searchText;
    private string? _errorMessage;
    private string? _successMessage;

    private List<MobileWarehouseOptionDto> _warehouses = new();
    private List<LoadRequestProductLineModel> _productLines = new();


    private List<LoadRequestProductLineModel> FilteredProductLines =>
        _productLines
            .Where(MatchesSearchText)
            .OrderByDescending(x => x.RequestedLargeQuantity > 0)
            .ThenBy(x => x.ProductName)
            .ToList();


    protected override async Task OnInitializedAsync()
    {
        _salesRepId = await GetCurrentSalesRepIdAsync();

        if (_salesRepId <= 0)
        {
            _errorMessage =
                "لم يتم تحديد المندوب الحالي.";

            _isLoading = false;
            return;
        }

        await LoadOptionsAsync();

        _isLoading = false;
    }


    private async Task LoadOptionsAsync()
    {
        await LoadWarehousesAsync();
        await LoadProductsAsync();

        if (_warehouses.Count == 1)
        {
            _selectedWarehouseId =
                _warehouses[0].Id;
        }
    }


    private async Task LoadWarehousesAsync()
    {
        var response =
            await LoadRequestApiService.GetWarehousesAsync();

        if (response is null)
        {
            _errorMessage =
                "لم يتم استلام بيانات المخازن من الخادم.";

            return;
        }

        if (!response.Success)
        {
            _errorMessage =
                response.Message
                ?? "فشل تحميل المخازن.";

            return;
        }

        _warehouses =
            response.Data?
                .OrderBy(x => x.Name)
                .ToList()
            ?? new List<MobileWarehouseOptionDto>();
    }


    private async Task LoadProductsAsync()
    {
        var response =
            await LoadRequestApiService.GetProductsAsync();

        if (response is null)
        {
            _errorMessage =
                "لم يتم استلام بيانات المنتجات من الخادم.";

            return;
        }

        if (!response.Success)
        {
            _errorMessage =
                response.Message
                ?? "فشل تحميل المنتجات.";

            return;
        }

        _productLines =
            response.Data?
                .OrderBy(x => x.Name)
                .Select(x => new LoadRequestProductLineModel
                {
                    ProductId = x.Id,
                    ProductName = x.Name,
                    ItemCode = x.ItemCode,
                    UnitPrice = x.UnitPrice,

                    SmallUnit =
                        string.IsNullOrWhiteSpace(x.SmallUnit)
                            ? "قطعة"
                            : x.SmallUnit,

                    LargeUnit =
                        string.IsNullOrWhiteSpace(x.LargeUnit)
                            ? "كرتونة"
                            : x.LargeUnit,

                    UnitsPerLargeUnit =
                        x.UnitsPerLargeUnit <= 0
                            ? 1
                            : x.UnitsPerLargeUnit,

                    RequestedLargeQuantity = 0
                })
                .ToList()
            ?? new List<LoadRequestProductLineModel>();
    }


    private async Task CreateLoadRequestAsync()
    {
        if (!Validate())
            return;

        try
        {
            _isProcessing = true;
            _errorMessage = null;
            _successMessage = null;

            var selectedItems =
                _productLines
                    .Where(x => x.RequestedLargeQuantity > 0)
                    .Select(x => new CreateLoadRequestItemRequest
                    {
                        ProductId = x.ProductId,
                        RequestedLargeQuantity =
                            x.RequestedLargeQuantity,
                        Notes = _notes
                    })
                    .ToList();


            var request =
                new CreateLoadRequestRequest
                {
                    SalesRepId = _salesRepId,
                    WarehouseId = _selectedWarehouseId,
                    Notes = _notes,
                    Items = selectedItems
                };


            var response =
                await LoadRequestApiService
                    .CreateAsync(request);


            if (response is null)
            {
                _errorMessage =
                    "لم يتم استلام استجابة من الخادم.";

                return;
            }


            if (!response.Success)
            {
                _errorMessage =
                    response.Message
                    ?? "فشل إنشاء طلب التحميل.";

                if (response.Errors is { Count: > 0 })
                {
                    _errorMessage +=
                        " " +
                        string.Join(
                            " ",
                            response.Errors);
                }

                return;
            }


            _successMessage =
                "تم إرسال طلب التحميل بنجاح.";

            await Task.Delay(700);

            NavigationManager.NavigateTo(
                "/load-requests",
                replace: true);
        }
        catch
        {
            _errorMessage =
                "حدث خطأ غير متوقع أثناء إرسال طلب التحميل.";
        }
        finally
        {
            _isProcessing = false;
        }
    }


    private bool Validate()
    {
        _errorMessage = null;

        if (_salesRepId <= 0)
        {
            _errorMessage =
                "بيانات المندوب غير صحيحة.";

            return false;
        }


        if (_selectedWarehouseId <= 0)
        {
            _errorMessage =
                "اختر المخزن أولًا.";

            return false;
        }


        var selectedItems =
            _productLines
                .Where(x => x.RequestedLargeQuantity > 0)
                .ToList();


        if (selectedItems.Count == 0)
        {
            _errorMessage =
                "اختر كمية لمنتج واحد على الأقل.";

            return false;
        }


        foreach (var item in _productLines)
        {
            if (item.RequestedLargeQuantity < 0)
            {
                _errorMessage =
                    $"كمية المنتج {item.ProductName} لا يمكن أن تكون أقل من صفر.";

                return false;
            }


            if (item.UnitsPerLargeUnit <= 0)
            {
                _errorMessage =
                    $"معامل تحويل المنتج {item.ProductName} غير صحيح.";

                return false;
            }
        }

        return true;
    }


    private async Task<int> GetCurrentSalesRepIdAsync()
    {
        try
        {
            var httpClient =
                HttpClientFactory.CreateClient(
                    "SalesyncApi");

            var response =
                await httpClient
                    .GetFromJsonAsync<
                        ApiResponse<SalesRepMobileProfileDto>>(
                        "api/mobile/salesrep/me");


            return response?.Success == true &&
                   response.Data is not null
                ? response.Data.SalesRepId
                : 0;
        }
        catch
        {
            return 0;
        }
    }


    private bool MatchesSearchText(
        LoadRequestProductLineModel line)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var search =
            _searchText.Trim();

        return
            Contains(line.ProductName, search)
            || Contains(line.ItemCode, search)
            || Contains(line.SmallUnit, search)
            || Contains(line.LargeUnit, search);
    }


    private static bool Contains(
        string? value,
        string search)
    {
        return
            !string.IsNullOrWhiteSpace(value)
            && value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }


    private void OnLineQuantityChanged(
        LoadRequestProductLineModel line)
    {
        _errorMessage = null;

        if (line.RequestedLargeQuantity < 0)
        {
            line.RequestedLargeQuantity = 0;
        }
    }


    private void IncreaseQuantity(
        LoadRequestProductLineModel line)
    {
        _errorMessage = null;

        line.RequestedLargeQuantity++;
    }


    private void DecreaseQuantity(
        LoadRequestProductLineModel line)
    {
        _errorMessage = null;

        if (line.RequestedLargeQuantity <= 0)
        {
            line.RequestedLargeQuantity = 0;
            return;
        }

        line.RequestedLargeQuantity--;
    }


    private int GetSelectedItemsCount()
    {
        return _productLines.Count(
            x => x.RequestedLargeQuantity > 0);
    }


    private int GetTotalRequestedLargeQuantity()
    {
        return _productLines.Sum(
            x => x.RequestedLargeQuantity);
    }


    private int GetTotalRequestedSmallQuantity()
    {
        return _productLines.Sum(
            x => x.RequestedSmallQuantity);
    }


    private static string DisplayProductCode(
        string? itemCode)
    {
        return string.IsNullOrWhiteSpace(itemCode)
            ? "بدون كود"
            : itemCode;
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/load-requests");
    }


    private sealed class LoadRequestProductLineModel
    {
        public int ProductId { get; set; }

        public string ProductName { get; set; }
            = string.Empty;

        public string? ItemCode { get; set; }

        public decimal UnitPrice { get; set; }

        public string SmallUnit { get; set; }
            = "قطعة";

        public string LargeUnit { get; set; }
            = "كرتونة";

        public int UnitsPerLargeUnit { get; set; }
            = 1;

        public int RequestedLargeQuantity { get; set; }

        public int RequestedSmallQuantity =>
            RequestedLargeQuantity
            * UnitsPerLargeUnit;
    }
}