@page "/"

@using System.Net.Http.Json
@using Salesync.SalesRep.Pwa.Models.Responses

@inject HttpClient Http

<PageTitle>Salesync</PageTitle>

<div class="container py-4">
    <h1>Salesync</h1>

    <p class="lead">
        Sales Representative Application
    </p>

    <button class="btn btn-primary"
            @onclick="CheckApiAsync"
            disabled="@isLoading">

        @(isLoading
            ? "Checking..."
            : "Check API Connection")
    </button>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }

    @if (healthResponse is not null)
    {
        <div class="alert alert-success mt-3">
            <div>
                <strong>Status:</strong>
                @healthResponse.Status
            </div>

            <div>
                <strong>Application:</strong>
                @healthResponse.Application
            </div>

            <div>
                <strong>Server time:</strong>
                @healthResponse.ServerTime
            </div>
        </div>
    }
</div>

@code {
    private HealthResponse? healthResponse;
    private string? errorMessage;
    private bool isLoading;

    private async Task CheckApiAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            healthResponse = null;

            healthResponse =
                await Http.GetFromJsonAsync<HealthResponse>(
                    "api/health");

            if (healthResponse is null)
            {
                errorMessage =
                    "The API returned an empty response.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage =
                $"Could not connect to the API: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}