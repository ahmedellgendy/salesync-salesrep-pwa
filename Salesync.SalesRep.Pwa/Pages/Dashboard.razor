@page "/dashboard"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepSessionApiService SalesRepSessionApiService
@inject ISalesRepCustomerApiService SalesRepCustomerApiService
@inject NavigationManager NavigationManager

<h3>الرئيسية</h3>

@if (_isLoading)
{
    <p>جاري تحميل بيانات اليوم...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}
else
{
    <div class="card p-3 mb-3">
        <h5>حالة اليوم</h5>

        @if (_today is null || !_today.HasTodaySession)
        {
            <div class="alert alert-warning mb-3">
                لا يوجد يوم مفتوح حاليًا.
            </div>

            <button class="btn btn-primary w-100"
                    disabled="@_isProcessing"
                    @onclick="StartDayAsync">
                @(_isProcessing ? "جاري بدء اليوم..." : "Start Day")
            </button>
        }
        else if (_today.IsDayClosed)
        {
            <div class="alert alert-success mb-3">
                تم قفل اليوم بنجاح.
            </div>

            @if (_today.Session is not null)
            {
                <p class="mb-1"><strong>Session Id:</strong> @_today.Session.Id</p>
                <p class="mb-1"><strong>Working Date:</strong> @_today.Session.WorkingDate.ToShortDateString()</p>
                <p class="mb-1"><strong>Start Time:</strong> @_today.Session.StartTime.ToLocalTime()</p>

                @if (_today.Session.EndTime.HasValue)
                {
                    <p class="mb-1"><strong>End Time:</strong> @_today.Session.EndTime.Value.ToLocalTime()</p>
                }
            }

            <div class="alert alert-info mt-3 mb-0">
                اليوم انتهى. لا يمكن بدء يوم جديد إلا في يوم عمل جديد.
            </div>
        }
        else if (_today.HasOpenSession && _today.Session is not null)
        {
            <div class="alert alert-success mb-3">
                اليوم مفتوح
            </div>

            <p class="mb-1"><strong>Session Id:</strong> @_today.Session.Id</p>
            <p class="mb-1"><strong>Working Date:</strong> @_today.Session.WorkingDate.ToShortDateString()</p>
            <p class="mb-1"><strong>Start Time:</strong> @_today.Session.StartTime.ToLocalTime()</p>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-success"
                        @onclick="GoToCustomers">
                    My Customers
                </button>

                <button class="btn btn-outline-success"
                        @onclick="GoToInvoices">
                    My Invoices
                </button>

                <button class="btn btn-danger"
                        disabled="@_isProcessing"
                        @onclick="CloseDayAsync">
                    @(_isProcessing ? "جاري قفل اليوم..." : "Close Day")
                </button>
            </div>
        }
    </div>

    @if (_today?.Session is not null)
    {
        <div class="card p-3 mb-3">
            <h5>ملخص اليوم</h5>

            <div class="row text-center">
                @if (_today.HasOpenSession)
                {
                    <div class="col-6 mb-3">
                        <div class="border rounded p-2">
                            <strong>@_totalCustomers</strong>
                            <div>العملاء</div>
                        </div>
                    </div>

                    <div class="col-6 mb-3">
                        <div class="border rounded p-2">
                            <strong>@_visitedCustomers</strong>
                            <div>تمت زيارتهم</div>
                        </div>
                    </div>

                    <div class="col-6 mb-3">
                        <div class="border rounded p-2">
                            <strong>@_remainingCustomers</strong>
                            <div>متبقي</div>
                        </div>
                    </div>
                }

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_today.Session.TotalVisits</strong>
                        <div>الزيارات</div>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_today.Session.TotalInvoices</strong>
                        <div>الفواتير</div>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_today.Session.TotalCollection</strong>
                        <div>التحصيل</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-3 mb-3">
            <h5>الأرقام المالية</h5>

            <p class="mb-1"><strong>Gross Sales:</strong> @_today.Session.GrossSales</p>
            <p class="mb-1"><strong>Net Sales:</strong> @_today.Session.NetSales</p>
            <p class="mb-1"><strong>Total Collection:</strong> @_today.Session.TotalCollection</p>
            <p class="mb-1"><strong>Total Returns:</strong> @_today.Session.TotalReturnAmount</p>
            <p class="mb-1"><strong>Total Invoices:</strong> @_today.Session.TotalInvoices</p>
        </div>

        @if (_today.HasOpenSession)
        {
            <div class="card p-3 mb-3">
                <h5>المخزون والتحميل</h5>

                <div class="d-grid gap-2">
                    <button class="btn btn-primary"
                            @onclick="GoToCreateLoadRequest">
                        Create Load Request
                    </button>

                    <button class="btn btn-outline-primary"
                            @onclick="GoToLoadRequests">
                        My Load Requests
                    </button>

                    <button class="btn btn-outline-dark"
                            @onclick="GoToInventory">
                        My Inventory
                    </button>
                </div>
            </div>
        }
        else if (_today.IsDayClosed)
        {
            <div class="card p-3 mb-3">
                <h5>مراجعة بعد قفل اليوم</h5>

                <div class="d-grid gap-2">
                    <button class="btn btn-outline-success"
                            @onclick="GoToInvoices">
                        My Invoices
                    </button>

                    <button class="btn btn-outline-dark"
                            @onclick="GoToInventory">
                        My Inventory
                    </button>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success mt-3">
            @_successMessage
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isProcessing;

    private string? _errorMessage;
    private string? _successMessage;

    private SalesRepMobileTodayDto? _today;

    private int _totalCustomers;
    private int _visitedCustomers;
    private int _remainingCustomers;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        _isLoading = false;
    }

    private async Task LoadDashboardAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        var todayResponse = await SalesRepSessionApiService.GetTodayAsync();

        if (todayResponse is null)
        {
            _errorMessage = "لم يتم استلام بيانات اليوم من الخادم.";
            return;
        }

        if (!todayResponse.Success)
        {
            _errorMessage = todayResponse.Message ?? "فشل تحميل بيانات اليوم.";
            return;
        }

        _today = todayResponse.Data;

        if (_today?.HasOpenSession == true && _today.Session is not null)
        {
            await LoadCustomersSummaryAsync(_today.Session.Id);
        }
    }

    private async Task LoadCustomersSummaryAsync(int sessionId)
    {
        var customersResponse = await SalesRepCustomerApiService.GetCustomersAsync(sessionId);

        if (customersResponse is null || !customersResponse.Success)
        {
            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;
            return;
        }

        var customers = customersResponse.Data?.ToList() ?? new List<SalesRepMobileCustomerDto>();

        _totalCustomers = customers.Count;
        _visitedCustomers = customers.Count(x => x.HasVisitToday);
        _remainingCustomers = customers.Count(x => !x.HasVisitToday);
    }

    private async Task StartDayAsync()
    {
        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await SalesRepSessionApiService.StartDayAsync();

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل بدء اليوم.";
                return;
            }

            if (response.Data is null)
            {
                _errorMessage = "تم بدء اليوم لكن لم يتم استلام بيانات السيشن.";
                return;
            }

            _today = new SalesRepMobileTodayDto
            {
                HasTodaySession = true,
                HasOpenSession = true,
                IsDayClosed = false,
                Session = response.Data
            };

            _successMessage = "تم بدء اليوم بنجاح.";

            await LoadCustomersSummaryAsync(response.Data.Id);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task CloseDayAsync()
    {
        if (_today?.Session is null)
            return;

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await SalesRepSessionApiService.CloseDayAsync(_today.Session.Id);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل قفل اليوم.";
                return;
            }

            if (response.Data is null)
            {
                _errorMessage = "تم قفل اليوم لكن لم يتم استلام بيانات السيشن.";
                return;
            }

            _today = new SalesRepMobileTodayDto
            {
                HasTodaySession = true,
                HasOpenSession = false,
                IsDayClosed = true,
                Session = response.Data
            };

            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;

            _successMessage = "تم قفل اليوم بنجاح.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void GoToCustomers()
    {
        if (_today?.Session is null)
            return;

        NavigationManager.NavigateTo($"/customers/{_today.Session.Id}");
    }

    private void GoToInvoices()
    {
        if (_today?.Session is null)
            return;

        NavigationManager.NavigateTo($"/invoices/{_today.Session.Id}");
    }

    private void GoToCreateLoadRequest()
    {
        NavigationManager.NavigateTo("/load-requests/create");
    }

    private void GoToLoadRequests()
    {
        NavigationManager.NavigateTo("/load-requests");
    }

    private void GoToInventory()
    {
        NavigationManager.NavigateTo("/inventory");
    }
}