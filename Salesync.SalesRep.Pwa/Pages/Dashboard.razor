@page "/dashboard"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepSessionApiService SalesRepSessionApiService
@inject ISalesRepCustomerApiService SalesRepCustomerApiService
@inject NavigationManager NavigationManager

<h3>الرئيسية</h3>

@if (_isLoading)
{
    <p>جاري تحميل بيانات اليوم...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}
else
{
    <div class="card p-3 mb-3">
        <h5>حالة اليوم</h5>

        @if (_currentSession is null)
        {
            <div class="alert alert-warning mb-3">
                لا يوجد يوم مفتوح حاليًا.
            </div>

            <button class="btn btn-primary w-100"
                    disabled="@_isProcessing"
                    @onclick="StartDayAsync">
                @(_isProcessing ? "جاري بدء اليوم..." : "Start Day")
            </button>
        }
        else
        {
            <div class="alert alert-success mb-3">
                اليوم مفتوح
            </div>

            <p class="mb-1"><strong>Session Id:</strong> @_currentSession.Id</p>
            <p class="mb-1"><strong>Working Date:</strong> @_currentSession.WorkingDate.ToShortDateString()</p>
            <p class="mb-1"><strong>Start Time:</strong> @_currentSession.StartTime.ToLocalTime()</p>

            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-success"
                        @onclick="GoToCustomers">
                    My Customers
                </button>

                <button class="btn btn-outline-success"
                        @onclick="GoToInvoices">
                    My Invoices
                </button>

                <button class="btn btn-danger"
                        disabled="@_isProcessing"
                        @onclick="CloseDayAsync">
                    @(_isProcessing ? "جاري قفل اليوم..." : "Close Day")
                </button>
            </div>
        }
    </div>

    @if (_currentSession is not null)
    {
        <div class="card p-3 mb-3">
            <h5>ملخص اليوم</h5>

            <div class="row text-center">
                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_totalCustomers</strong>
                        <div>العملاء</div>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_visitedCustomers</strong>
                        <div>تمت زيارتهم</div>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_remainingCustomers</strong>
                        <div>متبقي</div>
                    </div>
                </div>

                <div class="col-6 mb-3">
                    <div class="border rounded p-2">
                        <strong>@_currentSession.TotalVisits</strong>
                        <div>زيارات السيشن</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-3 mb-3">
            <h5>المخزون والتحميل</h5>

            <div class="d-grid gap-2">
                <button class="btn btn-primary"
                        @onclick="GoToCreateLoadRequest">
                    Create Load Request
                </button>

                <button class="btn btn-outline-primary"
                        @onclick="GoToLoadRequests">
                    My Load Requests
                </button>

                <button class="btn btn-outline-dark"
                        @onclick="GoToInventory">
                    My Inventory
                </button>
            </div>
        </div>

        <div class="card p-3">
            <h5>الأرقام المالية</h5>

            <p class="mb-1"><strong>Total Sales:</strong> @_currentSession.GrossSales</p>
            <p class="mb-1"><strong>Net Sales:</strong> @_currentSession.NetSales</p>
            <p class="mb-1"><strong>Total Collection:</strong> @_currentSession.TotalCollection</p>
            <p class="mb-1"><strong>Total Returns:</strong> @_currentSession.TotalReturnAmount</p>
            <p class="mb-1"><strong>Total Invoices:</strong> @_currentSession.TotalInvoices</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success mt-3">
            @_successMessage
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isProcessing;

    private string? _errorMessage;
    private string? _successMessage;

    private SalesRepSessionDto? _currentSession;

    private int _totalCustomers;
    private int _visitedCustomers;
    private int _remainingCustomers;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        _isLoading = false;
    }

    private async Task LoadDashboardAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        var todayResponse = await SalesRepSessionApiService.GetTodayAsync();

        if (todayResponse is null)
        {
            _errorMessage = "لم يتم استلام بيانات اليوم من الخادم.";
            return;
        }

        if (!todayResponse.Success)
        {
            _errorMessage = todayResponse.Message ?? "فشل تحميل بيانات اليوم.";
            return;
        }

        _currentSession = todayResponse.Data?.HasOpenSession == true
            ? todayResponse.Data.Session
            : null;

        if (_currentSession is not null)
        {
            await LoadCustomersSummaryAsync(_currentSession.Id);
        }
    }

    private async Task LoadCustomersSummaryAsync(int sessionId)
    {
        var customersResponse = await SalesRepCustomerApiService.GetCustomersAsync(sessionId);

        if (customersResponse is null || !customersResponse.Success)
        {
            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;
            return;
        }

        var customers = customersResponse.Data?.ToList() ?? new List<SalesRepMobileCustomerDto>();

        _totalCustomers = customers.Count;
        _visitedCustomers = customers.Count(x => x.HasVisitToday);
        _remainingCustomers = customers.Count(x => !x.HasVisitToday);
    }

    private async Task StartDayAsync()
    {
        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        var response = await SalesRepSessionApiService.StartDayAsync();

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
        }
        else if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل بدء اليوم.";
        }
        else
        {
            _currentSession = response.Data;
            _successMessage = "تم بدء اليوم بنجاح.";

            if (_currentSession is not null)
            {
                await LoadCustomersSummaryAsync(_currentSession.Id);
            }
        }

        _isProcessing = false;
    }

    private async Task CloseDayAsync()
    {
        if (_currentSession is null)
            return;

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        var response = await SalesRepSessionApiService.CloseDayAsync(_currentSession.Id);

        if (response is null)
        {
            _errorMessage = "لم يتم استلام استجابة من الخادم.";
        }
        else if (!response.Success)
        {
            _errorMessage = response.Message ?? "فشل قفل اليوم.";
        }
        else
        {
            _currentSession = null;
            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;
            _successMessage = "تم قفل اليوم بنجاح.";
        }

        _isProcessing = false;
    }

    private void GoToCustomers()
    {
        if (_currentSession is null)
            return;

        NavigationManager.NavigateTo($"/customers/{_currentSession.Id}");
    }

    private void GoToCreateLoadRequest()
    {
        NavigationManager.NavigateTo("/load-requests/create");
    }

    private void GoToLoadRequests()
    {
        NavigationManager.NavigateTo("/load-requests");
    }

    private void GoToInventory()
    {
        NavigationManager.NavigateTo("/inventory");
    }
    private void GoToInvoices()
    {
        if (_currentSession is null)
            return;

        NavigationManager.NavigateTo($"/invoices/{_currentSession.Id}");
    }
}