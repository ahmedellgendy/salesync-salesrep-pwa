@page "/dashboard"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepSessionApiService SalesRepSessionApiService
@inject ISalesRepCustomerApiService SalesRepCustomerApiService
@inject NavigationManager NavigationManager

<div class="field-page">

    <div class="field-header-card">
        <div>
            <div class="field-header-title">
                Salesync Rep
            </div>

            <div class="field-header-subtitle">
                لوحة المندوب اليومية
            </div>
        </div>

        <div class="field-header-icon">
            SR
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="field-card">
            <div class="field-loading-text">
                جاري تحميل بيانات اليوم...
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }
    else
    {
        <div class="field-status-card">
            <div class="field-status-row">
                <div>
                    <div class="field-status-title">
                        @GetTodayStateTitle()
                    </div>

                    <div class="field-status-text">
                        @GetTodayStateText()
                    </div>
                </div>

                <span class="field-status-pill @GetStatusCssClass()">
                    @GetTodayBadgeText()
                </span>
            </div>

            @if (CurrentSession is not null)
            {
                <div class="field-session-meta">
                    <span>Session #@CurrentSession.Id</span>
                    <span>@CurrentSession.WorkingDate.ToShortDateString()</span>
                </div>
            }
        </div>

        @if (HasNoTodaySession)
        {
            <div class="field-card">
                <div class="field-section-title mb-3">
                    بداية اليوم
                </div>

                <button class="field-primary-button"
                        disabled="@_isProcessing"
                        @onclick="StartDayAsync">
                    @(_isProcessing ? "جاري بدء اليوم..." : "Start Day")
                </button>
            </div>
        }
        else if (CurrentSession is not null)
        {
            <div class="field-kpi-panel">
                @if (HasOpenSession)
                {
                    <div class="field-kpi-item">
                        <div class="field-kpi-value">@_totalCustomers</div>
                        <div class="field-kpi-label">العملاء</div>
                    </div>

                    <div class="field-kpi-item">
                        <div class="field-kpi-value">@_visitedCustomers</div>
                        <div class="field-kpi-label">تمت</div>
                    </div>

                    <div class="field-kpi-item">
                        <div class="field-kpi-value">@_remainingCustomers</div>
                        <div class="field-kpi-label">متبقي</div>
                    </div>
                }

                <div class="field-kpi-item">
                    <div class="field-kpi-value">@CurrentSession.TotalVisits</div>
                    <div class="field-kpi-label">الزيارات</div>
                </div>

                <div class="field-kpi-item">
                    <div class="field-kpi-value">@CurrentSession.TotalInvoices</div>
                    <div class="field-kpi-label">الفواتير</div>
                </div>

                <div class="field-kpi-item">
                    <div class="field-kpi-value">@FormatMoney(CurrentSession.TotalCollection)</div>
                    <div class="field-kpi-label">التحصيل</div>
                </div>
            </div>

            @if (HasOpenSession)
            {
                <div class="field-section-title">
                    العمليات اليومية
                </div>

                <div class="field-actions-grid">

                    <button class="field-action-card field-action-wide"
                            @onclick="GoToRoutes">
                        <span class="field-action-icon field-blue">RT</span>

                        <span class="field-action-content">
                            <strong>عملاء خط السير</strong>
                            <small>ابدأ الزيارات وسجل الطلبات</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToInvoices">
                        <span class="field-action-icon field-green">INV</span>

                        <span class="field-action-content">
                            <strong>الفواتير</strong>
                            <small>فواتير اليوم</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToInvoices">
                        <span class="field-action-icon field-teal">PAY</span>

                        <span class="field-action-content">
                            <strong>التحصيلات</strong>
                            <small>تحصيل العملاء</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToInventory">
                        <span class="field-action-icon field-purple">STK</span>

                        <span class="field-action-content">
                            <strong>المخزون</strong>
                            <small>رصيد العربية</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToCreateLoadRequest">
                        <span class="field-action-icon field-orange">LR</span>

                        <span class="field-action-content">
                            <strong>طلب تحميل</strong>
                            <small>طلب منتجات جديدة</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToLoadRequests">
                        <span class="field-action-icon field-dark">REQ</span>

                        <span class="field-action-content">
                            <strong>طلبات التحميل</strong>
                            <small>متابعة الموافقات</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            disabled="@_isProcessing"
                            @onclick="CloseDayAsync">
                        <span class="field-action-icon field-red">END</span>

                        <span class="field-action-content">
                            <strong>إغلاق اليوم</strong>
                            <small>إنهاء يوم العمل</small>
                        </span>
                    </button>

                </div>
            }
            else if (IsDayClosed)
            {
                <div class="field-section-title">
                    مراجعة بعد قفل اليوم
                </div>

                <div class="field-actions-grid">

                    <button class="field-action-card"
                            @onclick="GoToInvoices">
                        <span class="field-action-icon field-green">INV</span>

                        <span class="field-action-content">
                            <strong>الفواتير</strong>
                            <small>مراجعة فواتير اليوم</small>
                        </span>
                    </button>

                    <button class="field-action-card"
                            @onclick="GoToInventory">
                        <span class="field-action-icon field-purple">STK</span>

                        <span class="field-action-content">
                            <strong>المخزون</strong>
                            <small>مراجعة رصيد العربية</small>
                        </span>
                    </button>

                </div>
            }

            <div class="field-section-title">
                الأرقام المالية
            </div>

            <div class="field-card">
                <div class="field-summary-row">
                    <span>Gross Sales</span>
                    <strong>@FormatMoney(CurrentSession.GrossSales)</strong>
                </div>

                <div class="field-summary-row">
                    <span>Net Sales</span>
                    <strong>@FormatMoney(CurrentSession.NetSales)</strong>
                </div>

                <div class="field-summary-row">
                    <span>Total Collection</span>
                    <strong>@FormatMoney(CurrentSession.TotalCollection)</strong>
                </div>

                <div class="field-summary-row">
                    <span>Total Returns</span>
                    <strong>@FormatMoney(CurrentSession.TotalReturnAmount)</strong>
                </div>

                <div class="field-summary-row border-0">
                    <span>Total Invoices</span>
                    <strong>@CurrentSession.TotalInvoices</strong>
                </div>
            </div>

            <div class="field-section-title">
                بيانات اليوم
            </div>

            <div class="field-card">
                <div class="field-info-row">
                    <span>Session Id</span>
                    <strong>@CurrentSession.Id</strong>
                </div>

                <div class="field-info-row">
                    <span>Working Date</span>
                    <strong>@CurrentSession.WorkingDate.ToShortDateString()</strong>
                </div>

                <div class="field-info-row">
                    <span>Start Time</span>
                    <strong>@CurrentSession.StartTime.ToLocalTime()</strong>
                </div>

                @if (CurrentSession.EndTime.HasValue)
                {
                    <div class="field-info-row">
                        <span>End Time</span>
                        <strong>@CurrentSession.EndTime.Value.ToLocalTime()</strong>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success mt-3">
                @_successMessage
            </div>
        }
    }

</div>

@code {
    private bool _isLoading = true;
    private bool _isProcessing;

    private string? _errorMessage;
    private string? _successMessage;

    private SalesRepMobileTodayDto? _today;

    private int _totalCustomers;
    private int _visitedCustomers;
    private int _remainingCustomers;

    private SalesRepSessionDto? CurrentSession => _today?.Session;

    private bool HasNoTodaySession =>
        _today is null || !_today.HasTodaySession;

    private bool HasOpenSession =>
        _today?.HasOpenSession == true && CurrentSession is not null;

    private bool IsDayClosed =>
        _today?.IsDayClosed == true && CurrentSession is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();

        _isLoading = false;
    }

    private async Task LoadDashboardAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        var todayResponse = await SalesRepSessionApiService.GetTodayAsync();

        if (todayResponse is null)
        {
            _errorMessage = "لم يتم استلام بيانات اليوم من الخادم.";
            return;
        }

        if (!todayResponse.Success)
        {
            _errorMessage = todayResponse.Message ?? "فشل تحميل بيانات اليوم.";
            return;
        }

        _today = todayResponse.Data;

        if (HasOpenSession && CurrentSession is not null)
        {
            await LoadCustomersSummaryAsync(CurrentSession.Id);
        }
    }

    private async Task LoadCustomersSummaryAsync(int sessionId)
    {
        var customersResponse = await SalesRepCustomerApiService.GetCustomersAsync(sessionId);

        if (customersResponse is null || !customersResponse.Success)
        {
            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;
            return;
        }

        var customers = customersResponse.Data?.ToList()
            ?? new List<SalesRepMobileCustomerDto>();

        _totalCustomers = customers.Count;
        _visitedCustomers = customers.Count(x => x.HasVisitToday);
        _remainingCustomers = customers.Count(x => !x.HasVisitToday);
    }

    private async Task StartDayAsync()
    {
        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await SalesRepSessionApiService.StartDayAsync();

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل بدء اليوم.";
                return;
            }

            if (response.Data is null)
            {
                _errorMessage = "تم بدء اليوم لكن لم يتم استلام بيانات السيشن.";
                return;
            }

            _today = new SalesRepMobileTodayDto
            {
                HasTodaySession = true,
                HasOpenSession = true,
                IsDayClosed = false,
                Session = response.Data
            };

            _successMessage = "تم بدء اليوم بنجاح.";

            await LoadCustomersSummaryAsync(response.Data.Id);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task CloseDayAsync()
    {
        if (CurrentSession is null)
            return;

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await SalesRepSessionApiService.CloseDayAsync(CurrentSession.Id);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل قفل اليوم.";
                return;
            }

            if (response.Data is null)
            {
                _errorMessage = "تم قفل اليوم لكن لم يتم استلام بيانات السيشن.";
                return;
            }

            _today = new SalesRepMobileTodayDto
            {
                HasTodaySession = true,
                HasOpenSession = false,
                IsDayClosed = true,
                Session = response.Data
            };

            _totalCustomers = 0;
            _visitedCustomers = 0;
            _remainingCustomers = 0;

            _successMessage = "تم قفل اليوم بنجاح.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetTodayStateTitle()
    {
        if (HasNoTodaySession)
            return "ابدأ يومك";

        if (HasOpenSession)
            return "اليوم مفتوح";

        if (IsDayClosed)
            return "تم قفل اليوم";

        return "حالة اليوم";
    }

    private string GetTodayStateText()
    {
        if (HasNoTodaySession)
            return "ابدأ يومك لتسجيل الزيارات والفواتير والتحصيل.";

        if (HasOpenSession)
            return "يمكنك متابعة خط السير وتسجيل الفواتير والتحصيلات.";

        if (IsDayClosed)
            return "اليوم مقفول ويمكنك مراجعة النتائج فقط.";

        return "حالة اليوم غير معروفة.";
    }

    private string GetTodayBadgeText()
    {
        if (HasOpenSession)
            return "OPEN";

        if (IsDayClosed)
            return "CLOSED";

        return "NOT STARTED";
    }

    private string GetStatusCssClass()
    {
        if (HasOpenSession)
            return "field-status-open";

        if (IsDayClosed)
            return "field-status-closed";

        return "field-status-not-started";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2");
    }

    private void GoToInvoices()
    {
        if (CurrentSession is null)
            return;

        NavigationManager.NavigateTo($"/invoices/{CurrentSession.Id}");
    }

    private void GoToCreateLoadRequest()
    {
        NavigationManager.NavigateTo("/load-requests/create");
    }

    private void GoToLoadRequests()
    {
        NavigationManager.NavigateTo("/load-requests");
    }

    private void GoToInventory()
    {
        NavigationManager.NavigateTo("/inventory");
    }

    private void GoToRoutes()
    {
        if (CurrentSession is null)
            return;

        NavigationManager.NavigateTo($"/routes/{CurrentSession.Id}");
    }
}