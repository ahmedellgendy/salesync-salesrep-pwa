@page "/supervisor/reports/returns"

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses.Reports
@using Salesync.SalesRep.Pwa.Services.Api.Supervisor

@attribute [Authorize(Roles = "Supervisor")]

@inject SupervisorReportApiService SupervisorReportApiService
@inject NavigationManager NavigationManager

<PageTitle>تقرير المرتجعات - Salesync</PageTitle>

<div class="returns-report-page" dir="rtl">

    <header class="page-header">

        <button type="button"
                class="back-button"
                @onclick="GoBack">
            رجوع
        </button>

        <div>
            <span class="page-eyebrow">
                التقارير
            </span>

            <h1>
                تقرير المرتجعات
            </h1>

            <p>
                متابعة المرتجعات وأسبابها وحالتها وقيمتها خلال الفترة المحددة.
            </p>
        </div>

    </header>


    <section class="report-filter-card">

        <div class="date-fields">

            <div class="filter-field">
                <label>من</label>

                <input type="date"
                       @bind="_fromDate" />
            </div>

            <div class="filter-field">
                <label>إلى</label>

                <input type="date"
                       @bind="_toDate" />
            </div>

        </div>


        <button type="button"
                class="apply-button"
                @onclick="ApplyFilterAsync"
                disabled="@_isLoading">
            تطبيق
        </button>

    </section>


    @if (_isLoading)
    {
        <section class="state-card">
            <strong>
                جاري تحميل المرتجعات...
            </strong>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="state-card error">

            <strong>
                تعذر تحميل تقرير المرتجعات
            </strong>

            <p>
                @_errorMessage
            </p>

            <button type="button"
                    class="retry-button"
                    @onclick="LoadReturnsAsync">
                إعادة المحاولة
            </button>

        </section>
    }
    else if (_result is null ||
             _result.Items.Count == 0)
    {
        <section class="state-card">

            <strong>
                لا توجد مرتجعات
            </strong>

            <p>
                لا توجد مرتجعات خلال الفترة المحددة.
            </p>

        </section>
    }
    else
    {
        <section class="report-summary">

            <div>
                <span>
                    إجمالي المرتجعات
                </span>

                <strong>
                    @_result.TotalCount
                </strong>
            </div>

            <div>
                <span>
                    الصفحة
                </span>

                <strong>
                    @_result.PageNumber
                    /
                    @_result.TotalPages
                </strong>
            </div>

        </section>


        <section class="returns-list">

            @foreach (var item in _result.Items)
            {
                <article class="return-card">

                    <div class="return-header">

                        <div>
                            <span class="return-number">
                                @item.ReturnNumber
                            </span>

                            <h2>
                                @item.CustomerName
                            </h2>
                        </div>

                        <span class="@GetReturnStatusClass(item.Status)">
                            @GetReturnStatusText(item.Status)
                        </span>

                    </div>


                    <div class="return-meta">

                        <div class="meta-row">
                            <span>
                                المندوب
                            </span>

                            <strong>
                                @item.SalesRepName
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                الفاتورة
                            </span>

                            <strong>
                                @item.InvoiceNumber
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                التاريخ
                            </span>

                            <strong>
                                @(item.ReturnDate.ToString("dd/MM/yyyy - HH:mm"))
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                سبب المرتجع
                            </span>

                            <strong>
                                @GetReturnReasonText(item.ReturnReason)
                            </strong>
                        </div>

                    </div>


                    <div class="return-amount">

                        <span>
                            قيمة المرتجع
                        </span>

                        <strong>
                            @item.TotalAmount.ToString("N2")
                        </strong>

                        <small>
                            جنيه
                        </small>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(item.ReasonNotes))
                    {
                        <div class="return-notes">

                            <span>
                                ملاحظات
                            </span>

                            <p>
                                @item.ReasonNotes
                            </p>

                        </div>
                    }

                </article>
            }

        </section>


        @if (_result.TotalPages > 1)
        {
            <nav class="pagination">

                <button type="button"
                        class="page-button"
                        disabled="@(_result.PageNumber <= 1 || _isLoading)"
                        @onclick="PreviousPageAsync">
                    السابق
                </button>

                <span class="page-info">
                    @_result.PageNumber
                    من
                    @_result.TotalPages
                </span>

                <button type="button"
                        class="page-button"
                        disabled="@(_result.PageNumber >= _result.TotalPages || _isLoading)"
                        @onclick="NextPageAsync">
                    التالي
                </button>

            </nav>
        }
    }

</div>

@code
{
    private DateTime _fromDate =
        new(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

    private DateTime _toDate =
        DateTime.Today;


    private PagedReportResult<
        SupervisorReturnReportItemDto>? _result;


    private int _pageNumber = 1;

    private const int PageSize = 10;

    private bool _isLoading = true;

    private string? _errorMessage;


    protected override async Task OnInitializedAsync()
    {
        ReadQueryString();

        await LoadReturnsAsync();
    }


    private void ReadQueryString()
    {
        var uri =
            NavigationManager.ToAbsoluteUri(
                NavigationManager.Uri);

        var query =
            uri.Query.TrimStart('?');

        if (string.IsNullOrWhiteSpace(query))
            return;


        var parameters = query
            .Split(
                '&',
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Split('=', 2))
            .Where(x => x.Length == 2)
            .ToDictionary(
                x => Uri.UnescapeDataString(x[0]),
                x => Uri.UnescapeDataString(x[1]),
                StringComparer.OrdinalIgnoreCase);


        if (parameters.TryGetValue(
                "fromDate",
                out var fromDateValue) &&
            DateTime.TryParse(
                fromDateValue,
                out var parsedFromDate))
        {
            _fromDate =
                parsedFromDate.Date;
        }


        if (parameters.TryGetValue(
                "toDate",
                out var toDateValue) &&
            DateTime.TryParse(
                toDateValue,
                out var parsedToDate))
        {
            _toDate =
                parsedToDate.Date;
        }
    }


    private async Task ApplyFilterAsync()
    {
        _pageNumber = 1;

        await LoadReturnsAsync();
    }


    private async Task LoadReturnsAsync()
    {
        if (_fromDate.Date > _toDate.Date)
        {
            _errorMessage =
                "تاريخ البداية يجب أن يكون قبل تاريخ النهاية.";

            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            _result =
                await SupervisorReportApiService
                    .GetReturnsAsync(
                        DateOnly.FromDateTime(_fromDate),
                        DateOnly.FromDateTime(_toDate),
                        _pageNumber,
                        PageSize);

            if (_result is null)
            {
                _errorMessage =
                    "لم يتم إرجاع بيانات المرتجعات.";
            }
        }
        catch (Exception)
        {
            _errorMessage =
                "تعذر الاتصال بالخادم.";
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task PreviousPageAsync()
    {
        if (_result is null ||
            _result.PageNumber <= 1)
            return;

        _pageNumber--;

        await LoadReturnsAsync();
    }


    private async Task NextPageAsync()
    {
        if (_result is null ||
            _result.PageNumber >= _result.TotalPages)
            return;

        _pageNumber++;

        await LoadReturnsAsync();
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/supervisor/reports");
    }


    private static string GetReturnStatusText(int status)
    {
        return status switch
        {
            1 => "قيد المراجعة",
            2 => "معتمد",
            3 => "مرفوض",
            4 => "تم الاستلام بالمخزن",
            5 => "ملغي",
            _ => "غير معروف"
        };
    }


    private static string GetReturnStatusClass(int status)
    {
        return status switch
        {
            2 => "return-status approved",
            3 => "return-status rejected",
            4 => "return-status received",
            5 => "return-status cancelled",
            _ => "return-status pending"
        };
    }


    private static string GetReturnReasonText(int reason)
    {
        return reason switch
        {
            1 => "تالف",
            2 => "منتهي الصلاحية",
            3 => "منتج خاطئ",
            4 => "طلب العميل",
            5 => "أخرى",
            _ => "غير معروف"
        };
    }
}