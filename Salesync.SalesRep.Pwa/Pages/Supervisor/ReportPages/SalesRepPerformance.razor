@page "/supervisor/reports/salesrep-performance"

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Common
@using Salesync.SalesRep.Pwa.Models.Responses.Reports
@using Salesync.SalesRep.Pwa.Services.Api.Supervisor

@attribute [Authorize(Roles = "Supervisor")]

@inject SupervisorReportApiService SupervisorReportApiService
@inject NavigationManager NavigationManager

<PageTitle>أداء المناديب - Salesync</PageTitle>

<div class="performance-report-page" dir="rtl">

    <header class="page-header">

        <button type="button"
                class="back-button"
                @onclick="GoBack">
            رجوع
        </button>

        <div>
            <span class="page-eyebrow">
                التقارير
            </span>

            <h1>
                أداء المناديب
            </h1>

            <p>
                مقارنة أداء مندوبي الفريق خلال الفترة المحددة.
            </p>
        </div>

    </header>


    <section class="report-filter-card">

        <div class="date-fields">

            <div class="filter-field">
                <label>من</label>

                <input type="date"
                       @bind="_fromDate" />
            </div>

            <div class="filter-field">
                <label>إلى</label>

                <input type="date"
                       @bind="_toDate" />
            </div>

        </div>

        <button type="button"
                class="apply-button"
                disabled="@_isLoading"
                @onclick="LoadPerformanceAsync">
            تطبيق
        </button>

    </section>


    @if (_isLoading)
    {
        <section class="state-card">
            <strong>
                جاري تحميل أداء المناديب...
            </strong>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="state-card error">

            <strong>
                تعذر تحميل التقرير
            </strong>

            <p>
                @_errorMessage
            </p>

            <button type="button"
                    class="retry-button"
                    @onclick="LoadPerformanceAsync">
                إعادة المحاولة
            </button>

        </section>
    }
    else if (_items.Count == 0)
    {
        <section class="state-card">

            <strong>
                لا توجد بيانات
            </strong>

            <p>
                لا توجد بيانات أداء خلال الفترة المحددة.
            </p>

        </section>
    }
    else
    {
        <section class="report-summary">

            <div>
                <span>
                    عدد المناديب
                </span>

                <strong>
                    @_items.Count
                </strong>
            </div>

            <div>
                <span>
                    صافي مبيعات الفريق
                </span>

                <strong>
                    @_items.Sum(x => x.NetSales).ToString("N2")
                    جنيه
                </strong>
            </div>

        </section>


        <section class="performance-list">

            @{
                var rank = 1;
            }

            @foreach (var item in _items
                .OrderByDescending(x => x.NetSales))
            {
                <article class="performance-card">

                    <div class="performance-header">

                        <div class="rep-info">

                            <span class="rank-badge">
                                #@rank
                            </span>

                            <div>
                                <span class="rep-label">
                                    مندوب المبيعات
                                </span>

                                <h2>
                                    @item.SalesRepName
                                </h2>
                            </div>

                        </div>

                        <div class="net-sales">
                            <span>
                                صافي المبيعات
                            </span>

                            <strong>
                                @item.NetSales.ToString("N2")
                            </strong>

                            <small>
                                جنيه
                            </small>
                        </div>

                    </div>


                    <div class="financial-grid">

                        <div class="metric-card">

                            <span>
                                إجمالي المبيعات
                            </span>

                            <strong>
                                @item.GrossSales.ToString("N2")
                            </strong>

                            <small>
                                جنيه
                            </small>

                        </div>


                        <div class="metric-card">

                            <span>
                                التحصيلات
                            </span>

                            <strong>
                                @item.TotalCollections.ToString("N2")
                            </strong>

                            <small>
                                جنيه
                            </small>

                        </div>


                        <div class="metric-card">

                            <span>
                                المرتجعات
                            </span>

                            <strong>
                                @item.TotalReturns.ToString("N2")
                            </strong>

                            <small>
                                جنيه
                            </small>

                        </div>


                        <div class="metric-card highlight">

                            <span>
                                متوسط الفاتورة
                            </span>

                            <strong>
                                @item.AverageInvoiceValue.ToString("N2")
                            </strong>

                            <small>
                                جنيه
                            </small>

                        </div>

                    </div>


                    <div class="activity-grid">

                        <div class="activity-item">

                            <span>
                                الفواتير
                            </span>

                            <strong>
                                @item.TotalInvoices
                            </strong>

                        </div>


                        <div class="activity-item">

                            <span>
                                الزيارات
                            </span>

                            <strong>
                                @item.TotalVisits
                            </strong>

                        </div>


                        <div class="activity-item">

                            <span>
                                العملاء الذين تمت زيارتهم
                            </span>

                            <strong>
                                @item.CustomersVisited
                            </strong>

                        </div>

                    </div>

                </article>

                rank++;
            }

        </section>
    }

</div>


@code
{
    private DateTime _fromDate =
        new(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

    private DateTime _toDate =
        DateTime.Today;


    private List<SupervisorSalesRepPerformanceDto> _items =
        new();


    private bool _isLoading = true;

    private string? _errorMessage;


    protected override async Task OnInitializedAsync()
    {
        ReadQueryString();

        await LoadPerformanceAsync();
    }


    private void ReadQueryString()
    {
        var uri =
            NavigationManager.ToAbsoluteUri(
                NavigationManager.Uri);

        var query =
            uri.Query.TrimStart('?');

        if (string.IsNullOrWhiteSpace(query))
            return;


        var parameters = query
            .Split(
                '&',
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Split('=', 2))
            .Where(x => x.Length == 2)
            .ToDictionary(
                x => Uri.UnescapeDataString(x[0]),
                x => Uri.UnescapeDataString(x[1]),
                StringComparer.OrdinalIgnoreCase);


        if (parameters.TryGetValue(
                "fromDate",
                out var fromDateValue) &&
            DateTime.TryParse(
                fromDateValue,
                out var parsedFromDate))
        {
            _fromDate =
                parsedFromDate.Date;
        }


        if (parameters.TryGetValue(
                "toDate",
                out var toDateValue) &&
            DateTime.TryParse(
                toDateValue,
                out var parsedToDate))
        {
            _toDate =
                parsedToDate.Date;
        }
    }


    private async Task LoadPerformanceAsync()
    {
        if (_fromDate.Date > _toDate.Date)
        {
            _errorMessage =
                "تاريخ البداية يجب أن يكون قبل تاريخ النهاية.";

            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result =
                await SupervisorReportApiService
                    .GetSalesRepPerformanceAsync(
                        DateOnly.FromDateTime(_fromDate),
                        DateOnly.FromDateTime(_toDate));

            _items = result ?? new();
        }
        catch (Exception)
        {
            _errorMessage =
                AppMessages.ConnectionError;
        }
        finally
        {
            _isLoading = false;
        }
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/supervisor/reports");
    }
}