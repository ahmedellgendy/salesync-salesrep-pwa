@page "/supervisor/reports/payments"

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Common
@using Salesync.SalesRep.Pwa.Models.Responses.Reports
@using Salesync.SalesRep.Pwa.Services.Api.Supervisor

@attribute [Authorize(Roles = "Supervisor")]

@inject SupervisorReportApiService SupervisorReportApiService
@inject NavigationManager NavigationManager

<PageTitle>تقرير التحصيلات - Salesync</PageTitle>

<div class="payments-report-page" dir="rtl">

    <header class="page-header">

        <button type="button"
                class="back-button"
                @onclick="GoBack">
            رجوع
        </button>

        <div>
            <span class="page-eyebrow">
                التقارير
            </span>

            <h1>
                تقرير التحصيلات
            </h1>

            <p>
                متابعة التحصيلات وطرق الدفع والفواتير المرتبطة بها.
            </p>
        </div>

    </header>


    <section class="report-filter-card">

        <div class="date-fields">

            <div class="filter-field">
                <label>من</label>

                <input type="date"
                       @bind="_fromDate" />
            </div>

            <div class="filter-field">
                <label>إلى</label>

                <input type="date"
                       @bind="_toDate" />
            </div>

        </div>


        <button type="button"
                class="apply-button"
                @onclick="ApplyFilterAsync"
                disabled="@_isLoading">
            تطبيق
        </button>

    </section>


    @if (_isLoading)
    {
        <section class="state-card">
            <strong>
                جاري تحميل التحصيلات...
            </strong>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="state-card error">

            <strong>
                تعذر تحميل تقرير التحصيلات
            </strong>

            <p>
                @_errorMessage
            </p>

            <button type="button"
                    class="retry-button"
                    @onclick="LoadPaymentsAsync">
                إعادة المحاولة
            </button>

        </section>
    }
    else if (_result is null ||
             _result.Items.Count == 0)
    {
        <section class="state-card">

            <strong>
                لا توجد تحصيلات
            </strong>

            <p>
                لا توجد تحصيلات خلال الفترة المحددة.
            </p>

        </section>
    }
    else
    {
        <section class="report-summary">

            <div>
                <span>
                    إجمالي العمليات
                </span>

                <strong>
                    @_result.TotalCount
                </strong>
            </div>

            <div>
                <span>
                    الصفحة
                </span>

                <strong>
                    @_result.PageNumber
                    /
                    @_result.TotalPages
                </strong>
            </div>

        </section>


        <section class="payments-list">

            @foreach (var item in _result.Items)
            {
                <article class="payment-card">

                    <div class="payment-header">

                        <div>
                            <span class="payment-number">
                                @item.PaymentNumber
                            </span>

                            <h2>
                                @item.CustomerName
                            </h2>
                        </div>

                        <span class="@GetStatusClass(item.Status)">
                            @GetStatusText(item.Status)
                        </span>

                    </div>


                    <div class="payment-meta">

                        <div class="meta-row">
                            <span>
                                المندوب
                            </span>

                            <strong>
                                @item.SalesRepName
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                الفاتورة
                            </span>

                            <strong>
                                @item.InvoiceNumber
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                التاريخ
                            </span>

                            <strong>
                                @(item.PaymentDate.ToString("dd/MM/yyyy - HH:mm"))
                            </strong>
                        </div>

                        <div class="meta-row">
                            <span>
                                طريقة الدفع
                            </span>

                            <strong>
                                @GetPaymentMethodText(item.PaymentMethod)
                            </strong>
                        </div>

                    </div>


                    <div class="payment-amount">

                        <span>
                            المبلغ المحصل
                        </span>

                        <strong>
                            @item.Amount.ToString("N2")
                        </strong>

                        <small>
                            جنيه
                        </small>

                    </div>


                    @if (HasCheckDetails(item))
                    {
                        <div class="check-details">

                            @if (!string.IsNullOrWhiteSpace(item.CheckNumber))
                            {
                                <div class="meta-row">
                                    <span>
                                        رقم الشيك
                                    </span>

                                    <strong>
                                        @item.CheckNumber
                                    </strong>
                                </div>
                            }

                            @if (item.CheckDueDate.HasValue)
                            {
                                <div class="meta-row">
                                    <span>
                                        تاريخ الاستحقاق
                                    </span>

                                    <strong>
                                        @item.CheckDueDate.Value.ToString("dd/MM/yyyy")
                                    </strong>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.BankName))
                            {
                                <div class="meta-row">
                                    <span>
                                        البنك
                                    </span>

                                    <strong>
                                        @item.BankName
                                    </strong>
                                </div>
                            }

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(
                            item.TransactionReference))
                    {
                        <div class="transaction-reference">

                            <span>
                                مرجع العملية
                            </span>

                            <strong>
                                @item.TransactionReference
                            </strong>

                        </div>
                    }

                </article>
            }

        </section>


        @if (_result.TotalPages > 1)
        {
            <nav class="pagination">

                <button type="button"
                        class="page-button"
                        disabled="@(_result.PageNumber <= 1 || _isLoading)"
                        @onclick="PreviousPageAsync">
                    السابق
                </button>

                <span class="page-info">
                    @_result.PageNumber
                    من
                    @_result.TotalPages
                </span>

                <button type="button"
                        class="page-button"
                        disabled="@(_result.PageNumber >= _result.TotalPages || _isLoading)"
                        @onclick="NextPageAsync">
                    التالي
                </button>

            </nav>
        }
    }

</div>

@code
{
    private DateTime _fromDate =
        new(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

    private DateTime _toDate =
        DateTime.Today;


    private PagedReportResult<
        SupervisorPaymentReportItemDto>? _result;


    private int _pageNumber = 1;

    private const int PageSize = 10;

    private bool _isLoading = true;

    private string? _errorMessage;


    protected override async Task OnInitializedAsync()
    {
        ReadQueryString();

        await LoadPaymentsAsync();
    }


    private void ReadQueryString()
    {
        var uri =
            NavigationManager.ToAbsoluteUri(
                NavigationManager.Uri);

        var query =
            uri.Query.TrimStart('?');

        if (string.IsNullOrWhiteSpace(query))
            return;


        var parameters = query
            .Split(
                '&',
                StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Split('=', 2))
            .Where(x => x.Length == 2)
            .ToDictionary(
                x => Uri.UnescapeDataString(x[0]),
                x => Uri.UnescapeDataString(x[1]),
                StringComparer.OrdinalIgnoreCase);


        if (parameters.TryGetValue(
                "fromDate",
                out var fromDateValue) &&
            DateTime.TryParse(
                fromDateValue,
                out var parsedFromDate))
        {
            _fromDate =
                parsedFromDate.Date;
        }


        if (parameters.TryGetValue(
                "toDate",
                out var toDateValue) &&
            DateTime.TryParse(
                toDateValue,
                out var parsedToDate))
        {
            _toDate =
                parsedToDate.Date;
        }
    }


    private async Task ApplyFilterAsync()
    {
        _pageNumber = 1;

        await LoadPaymentsAsync();
    }


    private async Task LoadPaymentsAsync()
    {
        if (_fromDate.Date > _toDate.Date)
        {
            _errorMessage =
                "تاريخ البداية يجب أن يكون قبل تاريخ النهاية.";

            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            _result =
                await SupervisorReportApiService
                    .GetPaymentsAsync(
                        DateOnly.FromDateTime(_fromDate),
                        DateOnly.FromDateTime(_toDate),
                        _pageNumber,
                        PageSize);

            if (_result is null)
            {
                _errorMessage =
                    "لم يتم إرجاع بيانات التحصيلات.";
            }
        }
        catch (Exception)
        {
            _errorMessage =
                AppMessages.ConnectionError;
        }
        finally
        {
            _isLoading = false;
        }
    }


    private async Task PreviousPageAsync()
    {
        if (_result is null ||
            _result.PageNumber <= 1)
            return;

        _pageNumber--;

        await LoadPaymentsAsync();
    }


    private async Task NextPageAsync()
    {
        if (_result is null ||
            _result.PageNumber >= _result.TotalPages)
            return;

        _pageNumber++;

        await LoadPaymentsAsync();
    }


    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/supervisor/reports");
    }


    private static string GetPaymentMethodText(
        int paymentMethod)
    {
        return paymentMethod switch
        {
            1 => "نقدي",
            2 => "شيك",
            3 => "بطاقة",
            4 => "تحويل بنكي",
            _ => "غير معروف"
        };
    }


    private static string GetStatusText(
        int status)
    {
        return status switch
        {
            1 => "معلق",
            2 => "مدفوع",
            3 => "مدفوع جزئيًا",
            4 => "متأخر",
            _ => "غير معروف"
        };
    }


    private static string GetStatusClass(
        int status)
    {
        return status switch
        {
            2 => "payment-status paid",
            3 => "payment-status partial",
            4 => "payment-status overdue",
            _ => "payment-status pending"
        };
    }


    private static bool HasCheckDetails(
        SupervisorPaymentReportItemDto item)
    {
        return
            !string.IsNullOrWhiteSpace(item.CheckNumber) ||
            item.CheckDueDate.HasValue ||
            !string.IsNullOrWhiteSpace(item.BankName);
    }
}