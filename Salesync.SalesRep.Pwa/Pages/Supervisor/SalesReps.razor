@page "/supervisor/sales-reps"
@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Responses
@using Salesync.SalesRep.Pwa.Services.Api.Supervisor

@attribute [Authorize(Roles = "Supervisor")]

@inject SupervisorSalesRepApiService SupervisorSalesRepApiService
@inject NavigationManager NavigationManager

<PageTitle>المناديب - Salesync</PageTitle>

<div class="supervisor-salesreps-page" dir="rtl">

    <section class="page-header">
        <div>
            <span class="page-eyebrow">
                فريق العمل
            </span>

            <h1>
                المناديب
            </h1>

            <p>
                متابعة المناديب التابعين لك.
            </p>
        </div>
    </section>


    @if (_isLoading)
    {
        <section class="state-card">
            <div class="state-spinner"></div>

            <strong>
                جاري تحميل المناديب...
            </strong>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="state-card error">
            <strong>
                تعذر تحميل المناديب
            </strong>

            <p>
                @_errorMessage
            </p>

            <button type="button"
                    class="retry-button"
                    @onclick="LoadTeamAsync">
                إعادة المحاولة
            </button>
        </section>
    }
    else if (_salesReps.Count == 0)
    {
        <section class="state-card">
            <strong>
                لا يوجد مناديب
            </strong>

            <p>
                لا يوجد مناديب مرتبطون بحساب المشرف الحالي.
            </p>
        </section>
    }
    else
    {
        <section class="team-summary">
            <span>
                إجمالي الفريق
            </span>

            <strong>
                @_salesReps.Count
            </strong>
        </section>


        <section class="salesreps-list">

            @foreach (var salesRep in _salesReps)
            {
                <article class="salesrep-card">

                    <div class="salesrep-card-header">

                        <div class="salesrep-avatar">
                            @GetInitials(salesRep.Name)
                        </div>

                        <div class="salesrep-main-info">

                            <div class="salesrep-name-row">
                                <h2>
                                    @salesRep.Name
                                </h2>

                                @if (salesRep.IsActive)
                                {
                                    <span class="status-badge active">
                                        نشط
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        غير نشط
                                    </span>
                                }
                            </div>

                            <span class="salesrep-code">
                                @salesRep.SalesRepCode
                            </span>

                        </div>

                    </div>


                    <div class="salesrep-details">

                        <div class="detail-row">
                            <span class="detail-label">
                                الهاتف
                            </span>

                            <strong>
                                @GetPhone(salesRep)
                            </strong>
                        </div>
                    </div>


                    <div class="salesrep-actions">

                        <button type="button"
                                class="salesrep-action"
                                @onclick="() => OpenSalesRep(salesRep.Id)">
                            عرض التفاصيل
                        </button>

                    </div>

                </article>
            }

        </section>
    }

</div>

@code
{
    private readonly List<SupervisorSalesRepDto>_salesReps = new();

    private bool _isLoading = true;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeamAsync();
    }

    private async Task LoadTeamAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response =
                await SupervisorSalesRepApiService
                    .GetMyTeamAsync();

            if (response?.Success == true &&
                response.Data is not null)
            {
                _salesReps.Clear();

                _salesReps.AddRange(
                    response.Data);

                return;
            }

            _errorMessage =
                response?.Message ??
                "حدث خطأ أثناء تحميل البيانات.";
        }
        catch (Exception)
        {
            _errorMessage =
                "تعذر الاتصال بالخادم.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetPhone(SupervisorSalesRepDto salesRep)
    {
        if (!string.IsNullOrWhiteSpace(
                salesRep.Mobile))
        {
            return salesRep.Mobile;
        }

        if (!string.IsNullOrWhiteSpace(
                salesRep.Phone))
        {
            return salesRep.Phone;
        }

        return "-";
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "م";

        var parts = name
            .Split(
                ' ',
                StringSplitOptions
                    .RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0]
                .ToString()
                .ToUpperInvariant();

        return string.Concat(
            parts[0][0],
            parts[1][0])
            .ToUpperInvariant();
    }

    private void OpenSalesRep(int salesRepId)
    {
        NavigationManager.NavigateTo(
            $"/supervisor/sales-reps/{salesRepId}");
    }
}