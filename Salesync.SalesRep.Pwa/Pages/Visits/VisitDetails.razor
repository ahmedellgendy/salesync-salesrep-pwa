@page "/visits/{VisitId:int}"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject ISalesRepVisitApiService SalesRepVisitApiService
@inject NavigationManager NavigationManager

<div class="visit-details-page" dir="rtl">

    <section class="visit-details-card">

        <div class="visit-details-header">

            <div class="visit-details-title">
                <span class="visit-status-badge">
                    زيارة مفتوحة
                </span>

                <h1>تفاصيل الزيارة</h1>

                <p>
                    اختر نتيجة الزيارة حسب موقف العميل.
                </p>
            </div>

            <div class="visit-details-icon">
                🧾
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="visit-details-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_infoMessage))
        {
            <div class="visit-details-alert info">
                @_infoMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="visit-details-alert success">
                @_successMessage
            </div>
        }

        <div class="visit-result-section">
            <label>نتيجة الزيارة</label>

            <div class="visit-mode-grid">

                <button type="button"
                        class="visit-mode-btn positive @GetVisitModeButtonClass(VisitMode.Positive)"
                        disabled="@HasInvalidVisitData"
                        @onclick="SelectPositiveVisit">
                    <span>🧾</span>
                    <strong>إنشاء فاتورة</strong>
                    <small>العميل طلب أوردر</small>
                </button>

                <button type="button"
                        class="visit-mode-btn negative @GetVisitModeButtonClass(VisitMode.Negative)"
                        disabled="@HasInvalidVisitData"
                        @onclick="SelectNegativeVisit">
                    <span>🚫</span>
                    <strong>زيارة بدون بيع</strong>
                    <small>لا يوجد طلب من العميل</small>
                </button>

            </div>
        </div>

        @if (_selectedVisitMode == VisitMode.Positive)
        {
            <div class="visit-positive-panel">

                <h2>زيارة إيجابية</h2>

                <p>
                    سيتم إنشاء فاتورة للعميل، وبعد حفظ الفاتورة يتم إكمال الزيارة كزيارة إيجابية.
                </p>

                <button type="button"
                        class="visit-primary-btn"
                        disabled="@HasInvalidVisitData"
                        @onclick="GoToCreateInvoice">
                    إنشاء الفاتورة
                </button>

            </div>
        }

        @if (_selectedVisitMode == VisitMode.Negative)
        {
            <div class="visit-negative-panel">

                <h2>إغلاق زيارة بدون بيع</h2>

                <div class="visit-form-group">
                    <label>سبب الزيارة</label>

                    <select @bind="_negativeReason">
                        <option value="1">العميل مغلق</option>
                        <option value="2">لا يوجد طلب</option>
                        <option value="3">العميل رفض الطلب</option>
                        <option value="4">مشكلة في الدفع</option>
                        <option value="5">خارج خط السير</option>
                        <option value="6">سبب آخر</option>
                    </select>
                </div>

                <div class="visit-form-group">
                    <label>ملاحظات</label>

                    <textarea placeholder="اكتب ملاحظات الزيارة..."
                              @bind="_notes"></textarea>
                </div>

                <button type="button"
                        class="visit-warning-btn"
                        disabled="@_isProcessing"
                        @onclick="CompleteNegativeVisitAsync">
                    @(_isProcessing ? "جاري إغلاق الزيارة..." : "إغلاق الزيارة")
                </button>

            </div>
        }

        <button type="button"
                class="visit-back-btn"
                disabled="@_isProcessing"
                @onclick="GoBackToRouteCustomers">
            رجوع لعملاء الخط
        </button>

    </section>

</div>

@code {
    [Parameter]
    public int VisitId { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "routeId")]
    public int RouteId { get; set; }

    private VisitMode? _selectedVisitMode;

    private int _negativeReason = 1;
    private string? _notes;

    private string? _errorMessage;
    private string? _infoMessage;
    private string? _successMessage;

    private bool _isProcessing;

    private bool HasInvalidVisitData =>
        VisitId <= 0 || SessionId <= 0 || CustomerId <= 0 || RouteId <= 0;

    protected override void OnInitialized()
    {
        if (HasInvalidVisitData)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
        }
    }

    private void SelectPositiveVisit()
    {
        ClearMessages();

        if (HasInvalidVisitData)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة لإنشاء فاتورة.";
            return;
        }

        _selectedVisitMode = VisitMode.Positive;
    }

    private void SelectNegativeVisit()
    {
        ClearMessages();

        if (HasInvalidVisitData)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
            return;
        }

        _selectedVisitMode = VisitMode.Negative;
    }

    private async Task CompleteNegativeVisitAsync()
    {
        if (HasInvalidVisitData)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
            return;
        }

        _isProcessing = true;
        ClearMessages();

        try
        {
            var request = new CompleteSalesRepMobileVisitRequest
            {
                VisitType = 2,
                NegativeReason = _negativeReason,
                InvoiceId = null,
                PaymentId = null,
                InvoiceReturnId = null,
                Notes = _notes
            };

            var response =
                await SalesRepVisitApiService.CompleteVisitAsync(VisitId, request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل إغلاق الزيارة.";
                return;
            }

            _successMessage = "تم إغلاق الزيارة بنجاح.";

            await Task.Delay(700);

            GoBackToRouteCustomers();
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء إغلاق الزيارة.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void GoToCreateInvoice()
    {
        if (HasInvalidVisitData)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة لإنشاء فاتورة.";
            return;
        }

        NavigationManager.NavigateTo(
            $"/invoices/create?visitId={VisitId}&sessionId={SessionId}&customerId={CustomerId}&routeId={RouteId}");
    }

    private void GoBackToRouteCustomers()
    {
        if (SessionId > 0 && RouteId > 0)
        {
            NavigationManager.NavigateTo(
                $"/routes/{RouteId}/customers?sessionId={SessionId}",
                replace: true);

            return;
        }

        NavigationManager.NavigateTo("/routes", replace: true);
    }

    private void ClearMessages()
    {
        _errorMessage = null;
        _infoMessage = null;
        _successMessage = null;
    }

    private string GetVisitModeButtonClass(VisitMode mode)
    {
        return _selectedVisitMode == mode
            ? "selected"
            : string.Empty;
    }

    private enum VisitMode
    {
        Positive = 1,
        Negative = 2
    }
}