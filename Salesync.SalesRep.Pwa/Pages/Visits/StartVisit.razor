@page "/visits/start"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Salesync.SalesRep.Pwa.Models.Requests
@using Salesync.SalesRep.Pwa.Services.Interfaces

@inject NavigationManager NavigationManager
@inject ISalesRepVisitApiService SalesRepVisitApiService

<div class="start-visit-page simple" dir="rtl">

    <section class="start-visit-simple-card">

        <div class="start-visit-top-icon">
            📍
        </div>

        <h1>بدء زيارة العميل</h1>

        <p>
            تأكد من الوصول لموقع العميل قبل بدء الزيارة.
        </p>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="start-visit-alert error">
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="start-visit-alert success">
                @_successMessage
            </div>
        }

        <div class="start-visit-notes simple">
            <label>ملاحظات اختيارية</label>

            <textarea placeholder="اكتب ملاحظة لو محتاج..."
                      @bind="_notes"></textarea>
        </div>

        <button class="start-visit-main-btn"
                disabled="@_isProcessing"
                @onclick="StartVisitAsync">
            @(_isProcessing ? "جاري بدء الزيارة..." : "بدء الزيارة")
        </button>

        <button class="start-visit-back-btn"
                disabled="@_isProcessing"
                @onclick="BackToCustomers">
            رجوع للعملاء
        </button>

    </section>

</div>

@code {
    [SupplyParameterFromQuery(Name = "sessionId")]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public int CustomerId { get; set; }

    [SupplyParameterFromQuery(Name = "routeId")]
    public int RouteId { get; set; }

    private string? _notes;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isProcessing;

    protected override void OnParametersSet()
    {
        if (SessionId <= 0 || CustomerId <= 0 || RouteId <= 0)
        {
            _errorMessage = "بيانات الزيارة غير مكتملة.";
        }
    }

    private async Task StartVisitAsync()
    {
        if (SessionId <= 0 || CustomerId <= 0 || RouteId <= 0)
        {
            _errorMessage = "بيانات الزيارة غير صحيحة.";
            return;
        }

        _isProcessing = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new StartSalesRepMobileVisitRequest
            {
                SalesRepSessionId = SessionId,
                CustomerId = CustomerId,
                RouteId = RouteId,
                Latitude = null,
                Longitude = null,
                Notes = _notes
            };

            var response = await SalesRepVisitApiService.StartVisitAsync(request);

            if (response is null)
            {
                _errorMessage = "لم يتم استلام استجابة من الخادم.";
                return;
            }

            if (!response.Success)
            {
                _errorMessage = response.Message ?? "فشل بدء الزيارة.";
                return;
            }

            var visitId = response.Data?.Id;

            if (!visitId.HasValue || visitId.Value <= 0)
            {
                _errorMessage = "تم بدء الزيارة ولكن لم يتم استلام رقم الزيارة.";
                return;
            }

            _successMessage = "تم بدء الزيارة بنجاح.";

            NavigationManager.NavigateTo(
                $"/visits/{visitId.Value}?sessionId={SessionId}&customerId={CustomerId}&routeId={RouteId}");
        }
        catch
        {
            _errorMessage = "حدث خطأ غير متوقع أثناء بدء الزيارة.";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void BackToCustomers()
    {
        NavigationManager.NavigateTo($"/routes/{RouteId}/customers?sessionId={SessionId}");
    }
}